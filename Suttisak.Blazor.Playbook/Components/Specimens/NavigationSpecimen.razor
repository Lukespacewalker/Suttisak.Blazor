<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="Navigation controls">
    <Preview>
        <div class="component-specimen__demo" data-testid="navigation-workbench">
            <Nav Embedded="true">
                <NavGroup Label="Workspace">
                    <NavItem Href="/components/nav"
                             Match="NavLinkMatch.All"
                             IconRestName="Home"
                             IconActiveName="Home">
                        Navigation overview
                    </NavItem>
                    <NavItem Href="/catalog"
                             IconRestName="AppsList">
                        <ChildContent>Component catalog</ChildContent>
                        <TrailingContent><span aria-label="@($"{PlaybookSpecimenRegistry.InteractiveSpecimenCount} components with executable coverage")">@PlaybookSpecimenRegistry.InteractiveSpecimenCount</span></TrailingContent>
                    </NavItem>
                    <NavSubmenu Label="Reports"
                                IconName="Document"
                                Badge="3"
                                Expanded="@_submenuExpanded"
                                Active="@_submenuActive"
                                data-testid="reports-submenu">
                        <NavItem Href="/components/experience-heading" IconRestName="DocumentText">Experience report</NavItem>
                        <NavItem Href="/components/app-grid" IconRestName="Table">Data report</NavItem>
                    </NavSubmenu>
                </NavGroup>
            </Nav>
        </div>
    </Preview>
    <Controls>
        <AppCheckbox @bind-Value="_submenuExpanded" Label="Reports expanded" />
        <AppCheckbox @bind-Value="_submenuActive" Label="Reports active" />
    </Controls>
    <States>
        <article><span>Embedded</span><strong>Composable nav panel</strong><small>Use inside shells or documentation frames without rendering the full mobile chrome.</small></article>
        <article><span>Route aware</span><strong>aria-current="page"</strong><small>NavItem derives active state from NavigationManager and its match mode.</small></article>
        <article><span>Progressive</span><strong>Native details / summary</strong><small>Expanded navigation retains native disclosure behavior. In a collapsed ApplicationShell, branches open labelled keyboard-accessible flyouts.</small></article>
        <article><span>Collapsed shell</span><strong>64px icon rail</strong><small>Try the desktop collapse control in the application shell pattern: destinations stay visible, with hover/focus labels and full mobile drawer labels.</small></article>
        <article><span>Grouped</span><strong>Application-owned labels</strong><small>NavGroup provides structure while the consuming app owns information architecture and copy.</small></article>
        <article><span>Submenu states</span><strong>Guided hierarchy and 44px targets</strong><small>Inline children have guide connectors. Hover uses a neutral surface; the selected child keeps its accent fill and stronger label without duplicating the top-level active strip.</small></article>
    </States>
</ComponentSpecimenLayout>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private bool _submenuExpanded = true;
    private bool _submenuActive;
}
