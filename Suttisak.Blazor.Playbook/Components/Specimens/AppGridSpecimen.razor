@inject Microsoft.JSInterop.IJSRuntime JS

<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="AppGridShell controls">
    <Preview>
        <div class="component-specimen__demo">
            <AppGridShell AriaLabel="Playbook records"
                         State="@_state"
                         SelectionActive="@(_selectedRecords.Count > 0)"
                         LoadingTitle="Loading playbook records"
                         EmptyTitle="No matching records"
                         EmptyMessage="Change the search or state controls to bring records back.">
                <Search>
                    <AppTextBox Label="Search records" Type="search" Placeholder="Search by record, program, owner, or status"
                                @bind-Value="_search" />
                </Search>
                <Filters>
                    <span aria-live="polite">@FilteredRecords.Count() matching records</span>
                </Filters>
                <Actions>
                    <AppButton Variant="AppButtonVariant.Subtle" OnClick="@(_ => ClearSearch())">Clear search</AppButton>
                </Actions>
                <Toolbar>
                    <span>Use row actions for one record; select rows for batch work.</span>
                </Toolbar>
                <SelectionToolbar>
                    <AppGridSelectionToolbar SelectedCount="@_selectedRecords.Count" OnClear="ClearSelection">
                        <Actions>
                            <AppButton Variant="AppButtonVariant.Subtle" OnClick="@(_ => ExportSelectedAsync())">Export selected</AppButton>
                            <AppButton Variant="AppButtonVariant.Subtle" OnClick="@(_ => ArchiveSelected())">Archive selected</AppButton>
                            <AppButton Variant="AppButtonVariant.Danger" OnClick="@(_ => DeleteAsync(_selectedRecords.ToArray(), true))">Delete selected</AppButton>
                        </Actions>
                    </AppGridSelectionToolbar>
                </SelectionToolbar>
                <ChildContent>
                    <AppGrid TGridItem="DemoRecord"
                             Items="@FilteredRecords"
                             Pagination="@_pagination"
                             SelectionMode="AppGridSelectionMode.Multiple"
                             @bind-SelectedItems="_selectedRecords"
                             AriaLabel="Playbook records table"
                             ItemKey="@(record => record.Id)">
                        <AppGridPropertyColumn TGridItem="DemoRecord" TProperty="int"
                                               Property="@(record => record.Id)" Title="ID" Sortable="true" />
                        <AppGridPropertyColumn TGridItem="DemoRecord" TProperty="string"
                                               Property="@(record => record.Name)" Title="Record" Sortable="true" />
                        <AppGridPropertyColumn TGridItem="DemoRecord" TProperty="string"
                                               Property="@(record => record.Program)" Title="Program" Sortable="true" />
                        <AppGridTemplateColumn TGridItem="DemoRecord" Title="Status" Sortable="true" SortByExpression="@(record => record.Status)">
                            <span>@context.Status</span>
                        </AppGridTemplateColumn>
                        <AppGridTemplateColumn TGridItem="DemoRecord" Title="Actions">
                            <AppActionMenu AriaLabel="@($"Actions for {context.Name}")">
                                <AppButton Variant="AppButtonVariant.Subtle" Size="AppButtonSize.Compact" OnClick="@(_ => EditAsync(context))">Edit</AppButton>
                                <AppButton Variant="AppButtonVariant.Danger" Size="AppButtonSize.Compact" OnClick="@(_ => DeleteAsync([context]))">Delete</AppButton>
                            </AppActionMenu>
                        </AppGridTemplateColumn>
                    </AppGrid>
                </ChildContent>
                <Footer>
                    <span role="status">@_lastAction</span>
                </Footer>
                <Pagination>
                    <AppGridPaginator State="@_pagination" AriaLabel="Playbook grid pagination" />
                </Pagination>
            </AppGridShell>
        </div>
    </Preview>
    <Controls>
        <label>Content state
            <select @bind="_state">
                @foreach (var value in Enum.GetValues<AsyncContentState>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </label>
        <label>Rows per page
            <select value="@_pagination.ItemsPerPage" @onchange="ChangePageSizeAsync">
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="6">6</option>
            </select>
        </label>
    </Controls>
    <States>
        <article><span>Ready</span><strong>Sortable + paged</strong><small>Default production state</small></article>
        <article><span>Loading</span><strong>Async feedback</strong><small>Uses AsyncContent semantics</small></article>
        <article><span>Empty</span><strong>No records</strong><small>Empty-state message</small></article>
        <article><span>Selection</span><strong>Contextual batch actions</strong><small>Row actions remain separate from multi-row work</small></article>
    </States>
</ComponentSpecimenLayout>

<DemoRecordEditor @ref="_editor" />
<AppDialog TInput="DemoRecord[]" TResult="bool" @ref="_deleteDialog" Title="@(_batchDelete ? "Delete selected records?" : "Delete this record?")"
           Description="Remove these records from this in-memory example. Reload to reset the data." Dangerous="true">
    <Body Context="dialog">
        <p>@dialog.Value.Length record(s) will be removed:</p>
        <ul>@foreach (var record in dialog.Value) { <li>@record.Name</li> }</ul>
    </Body>
    <Footer Context="dialog">
        <AppButton OnClick="@(_ => dialog.CancelAsync())">Keep records</AppButton>
        <AppButton Variant="AppButtonVariant.Danger" OnClick="@(_ => dialog.CloseAsync(true))">@(_batchDelete ? "Delete selected" : "Delete record")</AppButton>
    </Footer>
</AppDialog>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private readonly PaginationState _pagination = new() { ItemsPerPage = 3 };
    private AsyncContentState _state = AsyncContentState.Ready;
    private IReadOnlySet<DemoRecord> _selectedRecords = new HashSet<DemoRecord>();
    private string _search = string.Empty;
    private string _lastAction = "No action selected.";
    private DemoRecordEditor? _editor;
    private AppDialog<DemoRecord[], bool>? _deleteDialog;
    private bool _batchDelete;

    private readonly List<DemoRecord> Records =
    [
        new(1048, "Annual hearing surveillance", "Audiometry", "Narin P.", "In review", new DateTime(2026, 8, 12)),
        new(1047, "North terminal ergonomics", "Ergonomics", "Mali S.", "Active", new DateTime(2026, 8, 11)),
        new(1046, "Operations wellness cohort", "Wellness", "Kanda T.", "Draft", new DateTime(2026, 8, 9)),
        new(1045, "Respirator fitness follow-up", "Occupational health", "Preecha R.", "Active", new DateTime(2026, 8, 8)),
        new(1044, "Shift-work recovery study", "Fatigue", "Suda K.", "Complete", new DateTime(2026, 8, 5)),
        new(1043, "Office movement campaign", "Wellness", "Arthit W.", "Complete", new DateTime(2026, 8, 1))
    ];

    private IQueryable<DemoRecord> FilteredRecords => Records
        .Where(MatchesSearch)
        .AsQueryable();

    private bool MatchesSearch(DemoRecord record)
    {
        var query = _search.Trim();
        return query.Length == 0
            || record.Id.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Program.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Owner.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Status.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private void ClearSearch() => _search = string.Empty;
    private void ClearSelection() => _selectedRecords = new HashSet<DemoRecord>();

    private async Task ExportSelectedAsync()
    {
        var snapshot = _selectedRecords.ToArray();
        await DemoCsv.ExportRecordsAsync(JS, snapshot);
        _lastAction = $"Exported {snapshot.Length} selected record(s).";
    }

    private void ArchiveSelected()
    {
        foreach (var record in _selectedRecords) record.Status = "Archived";
        _lastAction = $"Archived {_selectedRecords.Count} selected record(s).";
        ClearSelection();
    }

    private async Task EditAsync(DemoRecord record)
    {
        var draft = await _editor!.EditAsync(record);
        if (draft is null) return;
        record.Name = draft.Name.Trim();
        record.Program = draft.Program.Trim();
        record.Owner = draft.Owner.Trim();
        _lastAction = $"Saved {record.Name}.";
    }

    private async Task DeleteAsync(DemoRecord[] snapshot, bool batch = false)
    {
        if (snapshot.Length == 0) return;
        _batchDelete = batch;
        await InvokeAsync(StateHasChanged);
        var result = await _deleteDialog!.ShowAsync(snapshot);
        if (result is not { HasValue: true, Value: true }) return;
        var ids = snapshot.Select(record => record.Id).ToHashSet();
        Records.RemoveAll(record => ids.Contains(record.Id));
        _selectedRecords = _selectedRecords.Where(record => !ids.Contains(record.Id)).ToHashSet();
        _lastAction = $"Deleted {snapshot.Length} record(s).";
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            _pagination.ItemsPerPage = pageSize;
            await _pagination.SetCurrentPageIndexAsync(0);
        }
    }
}
