<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="Experience controls">
    <Preview>
        <div class="component-specimen__demo" data-testid="experience-workbench">
            <ExperienceHeading Eyebrow="Assessment result"
                               Title="Your annual check"
                               Emphasis="is ready"
                               Description="A reader-facing summary that keeps product wording in the consuming application."
                               Watermark="RESULT"
                               Visual="@(_includeVisual ? ScoreVisual : null)"
                               VisualIsDecorative="@_visualIsDecorative"
                               HeadingId="experience-demo-heading"
                               data-testid="experience-heading">
                <Details>
                    <span>23 August 2026</span>
                    <span aria-hidden="true"> · </span>
                    <span>Annual review</span>
                </Details>
            </ExperienceHeading>

            <ExperienceCard Elevated="@_elevated"
                            Interactive="@_interactive"
                            Accent="@_accent"
                            data-testid="experience-card">
                <h2>Result summary</h2>
                <p>The shared component owns the surface treatment while the application owns this explanation.</p>
                <AppButton Variant="AppButtonVariant.Primary" OnClick="@(_ => _taskStatus = "Result details opened.")">Open result details</AppButton>
                <p role="status">@_taskStatus</p>
            </ExperienceCard>

            <ExperienceDisclosureGroup data-testid="experience-disclosure-group">
                <ExperienceDisclosure Heading="What this result means"
                                      Expanded="true"
                                      Recommended="@_recommended"
                                      BadgeText="Recommended"
                                      data-testid="experience-disclosure-primary">
                    <p>Use progressive disclosure for guidance that readers may want after understanding the headline result.</p>
                </ExperienceDisclosure>
                <ExperienceDisclosure Heading="What to do next"
                                      data-testid="experience-disclosure-secondary">
                    <p>Native details and summary preserve keyboard interaction without adding JavaScript behavior.</p>
                </ExperienceDisclosure>
            </ExperienceDisclosureGroup>
        </div>
    </Preview>
    <Controls>
        <AppCheckbox @bind-Value="_includeVisual" Label="Include visual" />
        <AppCheckbox @bind-Value="_visualIsDecorative" Label="Decorative visual" />
        <AppCheckbox @bind-Value="_accent" Label="Card accent" />
        <AppCheckbox @bind-Value="_elevated" Label="Elevated card" />
        <AppCheckbox @bind-Value="_interactive" Label="Interactive treatment" />
        <AppCheckbox @bind-Value="_recommended" Label="Recommended disclosure" />
    </Controls>
    <States>
        <article><span>Heading</span><strong>Unframed editorial hierarchy in Nexora</strong><small>Nexora places the title and introduction on the page background, with a larger desktop hierarchy and compact narrow typography so the following task stays visible. Other appearances retain their existing hero treatment; use PageHeading for task pages.</small></article>
        <article><span>Visual</span><strong>Absent, decorative, or meaningful</strong><small>Nexora removes unused visual space when no fragment is supplied. Supplied visuals keep content space and their decorative or accessible treatment.</small></article>
        <article><span>Card</span><strong>Composable surface</strong><small>Accent, elevation, and interactive treatments change presentation without owning copy.</small></article>
        <article><span>Disclosure</span><strong>Native details/summary</strong><small>Progressive guidance works with keyboard and browser semantics without JavaScript.</small></article>
    </States>
</ComponentSpecimenLayout>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private bool _visualIsDecorative;
    private bool _includeVisual = true;
    private string _taskStatus = "Ready to read the result.";
    private RenderFragment ScoreVisual => @<div role="@(_visualIsDecorative ? null : "img")"
        aria-label="@(_visualIsDecorative ? null : "Overall result score 82 out of 100")"
        data-testid="experience-visual"><strong>82</strong><span aria-hidden="true">/100</span></div>;
    private bool _accent = true;
    private bool _elevated = true;
    private bool _interactive;
    private bool _recommended = true;
}
