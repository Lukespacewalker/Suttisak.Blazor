<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="Layout and display controls">
    <Preview>
        <div class="component-specimen__demo">
            <AppStack Direction="@_direction"
                      Gap="@_gap"
                      Align="stretch"
                      Wrap="@_wrap"
                      data-testid="layout-stack">
                <AppCard Title="Assessment overview"
                         Description="Composable application surface with header, body, actions, and footer."
                         data-testid="surface-card">
                    <Actions>
                        <Pill>Ready</Pill>
                    </Actions>
                    <ChildContent>
                        <p>Three records are ready for review and one requires follow-up.</p>
                        <Toolbar AriaLabel="Assessment actions" data-testid="layout-toolbar">
                            <AppButton Variant="AppButtonVariant.Primary" OnClick="HandlePrimaryAction">Open review</AppButton>
                            <AppButton Variant="AppButtonVariant.Secondary">Export</AppButton>
                        </Toolbar>
                    </ChildContent>
                    <Footer>
                        <small>Updated a few moments ago</small>
                    </Footer>
                </AppCard>

                @if (_showInteractiveCard)
                {
                    <AppCard Title="Review queue"
                             Description="A dedicated selectable surface without nested interactive controls."
                             IsActive="@_cardActive"
                             OnClick="HandleCardClick"
                             aria-label="Review queue card"
                             data-testid="interactive-card">
                        <p>Activate this card with click, Enter, or Space.</p>
                    </AppCard>
                }

                <AppDivider Vertical="@_verticalDivider" data-testid="layout-divider" />

                <CardMenu Title="@_menuTitle"
                          Subtitle="@_menuSubtitle"
                          AriaLabel="Open participant settings"
                          Disabled="@_menuDisabled"
                          OnClick="HandleMenuClick"
                          data-testid="layout-card-menu" />
            </AppStack>

            <p role="status" data-testid="layout-status">@_status</p>
        </div>
    </Preview>
    <Controls>
        <label>Stack direction
            <select @bind="_direction">
                <option value="Vertical">Vertical</option>
                <option value="Horizontal">Horizontal</option>
            </select>
        </label>
        <label>Gap
            <select @bind="_gap">
                <option value="0.5rem">Compact</option>
                <option value="1rem">Comfortable</option>
                <option value="1.5rem">Spacious</option>
            </select>
        </label>
        <AppCheckbox @bind-Value="_wrap" Label="Wrap horizontal content" />
        <AppCheckbox @bind-Value="_verticalDivider" Label="Vertical divider" />
        <AppCheckbox @bind-Value="_showInteractiveCard" Label="Interactive card" />
        <AppCheckbox @bind-Value="_cardActive" Label="Active card" />
        <AppCheckbox @bind-Value="_menuDisabled" Label="Disabled card menu" />
        <label>Menu title
            <input @bind="_menuTitle" @bind:event="oninput" />
        </label>
        <label>Menu subtitle
            <input @bind="_menuSubtitle" @bind:event="oninput" />
        </label>
    </Controls>
    <States>
        <article><span>Composition</span><strong>Stack → card → toolbar</strong><small>Layout primitives compose without owning application-specific behavior</small></article>
        <article><span>Interactive</span><strong>Keyboard-operable surface</strong><small>Selectable cards avoid nested controls and support Enter/Space activation</small></article>
        <article><span>Separation</span><strong>Semantic divider</strong><small>Horizontal and vertical separators preserve orientation semantics</small></article>
        <article><span>Menu</span><strong>Native button contract</strong><small>CardMenu keeps disabled behavior and keyboard activation native</small></article>
    </States>
</ComponentSpecimenLayout>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private string _direction = "Vertical";
    private string _gap = "1rem";
    private bool _wrap = true;
    private bool _verticalDivider;
    private bool _showInteractiveCard = true;
    private bool _cardActive;
    private bool _menuDisabled;
    private string _menuTitle = "Participant settings";
    private string _menuSubtitle = "Profile, preferences, and access";
    private string _status = "No action yet.";

    private Task HandleCardClick(MouseEventArgs _)
    {
        _cardActive = !_cardActive;
        _status = _cardActive ? "Card activated." : "Card deactivated.";
        return Task.CompletedTask;
    }

    private Task HandlePrimaryAction(MouseEventArgs _)
    {
        _status = "Primary toolbar action selected.";
        return Task.CompletedTask;
    }

    private Task HandleMenuClick(MouseEventArgs _)
    {
        _status = "Participant settings selected.";
        return Task.CompletedTask;
    }
}
