<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="Preference controls">
    <Preview>
        <div class="preferences-specimen" data-testid="preferences-workbench">
            <header>
                <div>
                    <span>Application preferences</span>
                    <strong>Language and color scheme</strong>
                </div>
                <Suttisak.Blazor.UserInterface.Region.HeaderControl />
            </header>
            <p>This host opts into scheme and language icon popovers through BlazorUIOptions.CompactHeaderPreferences. Culture is handled by the host; the shared browser module remembers color mode.</p>
            <section aria-label="Explicit appearance settings">
                <AppearanceSelector Label="Saved appearance" />
                <p>Applications may place AppearanceSelector on a dedicated settings page. Appearance remains independent of color mode.</p>
            </section>
        </div>
    </Preview>
    <Controls>
        <label>Contract note
            <select @bind="_note">
                <option value="persistence">Browser persistence</option>
                <option value="system">System color scheme</option>
                <option value="responsive">Responsive disclosure</option>
            </select>
        </label>
        <p role="status">@NoteText</p>
    </Controls>
    <States>
        <article><span>Culture</span><strong>Host-owned redirect and persistence</strong><small>CultureSelector stores the requested culture, then lets the application apply it and return to the current route.</small></article>
        <article><span>Theme</span><strong>Light, dark, and system</strong><small>ThemeSwitcher synchronizes every mounted selector and reacts to system-scheme changes.</small></article>
        <article><span>Appearance settings</span><strong>Standard, Essential, Quiet Luxury, and Nexora</strong><small>The standalone AppearanceSelector remembers an explicitly requested setting without adding a dropdown to shared headers.</small></article>
        <article><span>Responsive</span><strong>One native disclosure on mobile</strong><small>PreferencesSelector keeps the controls together without duplicating a parallel interaction contract.</small></article>
    </States>
</ComponentSpecimenLayout>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private string _note = "persistence";
    private string NoteText => _note switch
    {
        "system" => "System mode follows prefers-color-scheme and updates while the page remains open.",
        "responsive" => "Below 900 pixels, the desktop controls become one keyboard-operable details disclosure.",
        _ => "Theme and culture choices persist after a route reload."
    };
}
