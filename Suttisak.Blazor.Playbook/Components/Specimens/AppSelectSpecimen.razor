<ComponentSpecimenLayout Viewport="@Viewport" ControlsLabel="AppSelect controls">
    <Preview>
        <div class="component-specimen__demo">
            <AppSelect TValue="string" @bind-Value="_value" Label="@_label" Placeholder="@_placeholder" Description="@_description" Required="@_required" Disabled="@_disabled">
                @foreach (var option in Options)
                {
                    <AppSelectItem TValue="string" Value="@option.Value" Label="@option.Label" Disabled="@option.Disabled" />
                }
            </AppSelect>
        </div>
    </Preview>
    <Controls>
        <label>Value<select @bind="_value">@foreach (var option in Options) { <option value="@option.Value">@option.Label</option> }</select></label>
        <label>Label<input @bind="_label" @bind:event="oninput" /></label>
        <label>Placeholder<input @bind="_placeholder" @bind:event="oninput" /></label>
        <label>Description<input @bind="_description" @bind:event="oninput" /></label>
        <label class="component-detail__check"><input type="checkbox" @bind="_required" /> Required</label>
        <label class="component-detail__check"><input type="checkbox" @bind="_disabled" /> Disabled</label>
    </Controls>
    <States>
        <article><span>Selected</span><AppSelect TValue="string" Value="@("th")" Label="Region" Options="@Options" /></article>
        <article><span>Required</span><AppSelect TValue="string" Value="@string.Empty" Label="Region" Placeholder="Choose a region" Options="@Options" Required="true" /></article>
        <article><span>Disabled</span><AppSelect TValue="string" Value="@("jp")" Label="Region" Options="@Options" Disabled="true" /></article>
    </States>
</ComponentSpecimenLayout>

@code {
    [Parameter, EditorRequired] public string Viewport { get; set; } = "desktop";

    private static readonly IReadOnlyList<AppSelectOption<string>> Options =
    [
        new("th", "Thailand"),
        new("sg", "Singapore"),
        new("jp", "Japan"),
        new("disabled", "Unavailable region", true)
    ];

    private string _value = "th";
    private string? _label = "Region";
    private string? _placeholder = "Choose a region";
    private string? _description = "Used for locale-aware defaults and display formatting.";
    private bool _required;
    private bool _disabled;
}
