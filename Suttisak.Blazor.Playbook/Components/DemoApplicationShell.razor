@inject PlaybookState State
@inject IThemeService ThemeService
@inject IJSRuntime JsRuntime

<ApplicationShell MainContentId="demo-application-main"
                    NavigationLabel="Demo application navigation"
                    MenuButtonLabel="Open demo navigation"
                    CloseMenuLabel="Close demo navigation">
    <Brand>
        <NavLink class="demo-app-brand" href="application-shell" Match="NavLinkMatch.All">
            <span aria-hidden="true"><img src="@CurrentTheme.LogoPath" alt="" /></span>
            <div><strong>@CurrentTheme.Name</strong><small>Operations workspace</small></div>
        </NavLink>
    </Brand>
    <HeaderActions>
        <span class="demo-app-environment">Playbook</span>
    </HeaderActions>
    <ThemeSwitcher>
        <div class="theme-selector" aria-label="Theme">
            <button class="@(State.Mode == "light" ? "active" : null)" type="button" aria-label="Use light theme" aria-pressed="@(State.Mode == "light" ? "true" : "false")" @onclick='() => ChangeModeAsync("light")'>☼</button>
            <button class="@(State.Mode == "dark" ? "active" : null)" type="button" aria-label="Use dark theme" aria-pressed="@(State.Mode == "dark" ? "true" : "false")" @onclick='() => ChangeModeAsync("dark")'>◐</button>
            <button class="@(State.Mode == "auto" ? "active" : null)" type="button" aria-label="Use system theme" aria-pressed="@(State.Mode == "auto" ? "true" : "false")" @onclick='() => ChangeModeAsync("auto")'>A</button>
        </div>
    </ThemeSwitcher>
    <LanguageSwitcher>
        <div class="culture-selector" aria-label="Language">
            <button class="@(State.Language == "en" ? "active" : null)" type="button" aria-pressed="@(State.Language == "en" ? "true" : "false")" @onclick='() => State.Language = "en"'>EN</button>
            <button class="@(State.Language == "th" ? "active" : null)" type="button" aria-pressed="@(State.Language == "th" ? "true" : "false")" @onclick='() => State.Language = "th"'>ไทย</button>
        </div>
    </LanguageSwitcher>
    <Profile>
        <details class="demo-profile">
            <summary aria-label="Open profile menu"><span>KS</span><b>Kanda</b><Suttisak.Blazor.Icons.Icon Name="ChevronDown" Size="16"  /></summary>
            <div class="demo-profile__menu">
                <div><span>KS</span><p><strong>Kanda S.</strong><small>Workspace administrator</small></p></div>
                <a href="#demo-profile"><Suttisak.Blazor.Icons.Icon Name="Person" Size="20"  /> Profile</a>
                <a href="#demo-signout"><Suttisak.Blazor.Icons.Icon Name="SignOut" Size="20"  /> Sign out</a>
            </div>
        </details>
    </Profile>
    <Navigation>
        <div class="demo-app-nav-group">
            <span>@(IsThai ? "พื้นที่ทำงาน" : "Workspace")</span>
            <NavLink href="application-shell" Match="NavLinkMatch.All">
                <Suttisak.Blazor.Icons.Icon Name="Home" Size="20"  /> @(IsThai ? "ภาพรวม" : "Overview")
            </NavLink>
            <NavLink href="application-shell/records">
                <Suttisak.Blazor.Icons.Icon Name="Table" Size="20"  /> @(IsThai ? "รายการ" : "Records")
                <small>@RecordCount</small>
            </NavLink>
            <NavLink href="application-shell/person">
                <Suttisak.Blazor.Icons.Icon Name="Person" Size="20"  /> @(IsThai ? "สุขภาพรายบุคคล" : "Individual health")
            </NavLink>
        </div>
        <div class="demo-app-nav-group">
            <span>@(IsThai ? "จัดการ" : "Manage")</span>
            <NavSubmenu Label="@(IsThai ? "การดูแลระบบ" : "Administration")"
                        IconName="@("Settings")"
                        Badge="3">
                <a href="#demo-team"><Suttisak.Blazor.Icons.Icon Name="People" Size="20"  /> @(IsThai ? "ทีม" : "Team")</a>
                <a href="#demo-permissions"><Suttisak.Blazor.Icons.Icon Name="PersonLock" Size="20"  /> @(IsThai ? "สิทธิ์" : "Permissions")</a>
                <a href="#demo-settings"><Suttisak.Blazor.Icons.Icon Name="Settings" Size="20"  /> @(IsThai ? "การตั้งค่า" : "Settings")</a>
            </NavSubmenu>
        </div>
    </Navigation>
    <NavigationFooter>
        <div class="demo-app-nav-footer"><i></i><span><strong>@(IsThai ? "ระบบพร้อมใช้งาน" : "All systems ready")</strong><small>@(IsThai ? "ตรวจสอบเมื่อสักครู่" : "Last checked just now")</small></span></div>
    </NavigationFooter>
    <PageHeader>
        @if (BreadcrumbItems?.Any() == true)
        {
            <nav class="demo-application-shell__breadcrumbs" aria-label="Breadcrumb">
                <AppBreadcrumb Items="@BreadcrumbItems" />
            </nav>
        }
        @PageHeader
    </PageHeader>
    <ChildContent>@ChildContent</ChildContent>
</ApplicationShell>

@code {
    [Inject] private DemoRecordStore Store { get; set; } = default!;
    [Parameter] public IEnumerable<Breadcrumb>? BreadcrumbItems { get; set; }
    [Parameter] public RenderFragment? PageHeader { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);
    private int RecordCount => Store.Records.Count;
    private bool IsThai => State.Language == "th";

    private async Task ChangeModeAsync(string mode)
    {
        State.Mode = mode;
        var isDark = mode == "dark"
            || mode == "auto" && await JsRuntime.InvokeAsync<bool>("playbookTheme.prefersDark");
        ThemeService.ThemeConfiguration = mode switch
        {
            "light" => DesignThemeMode.Light,
            "dark" => DesignThemeMode.Dark,
            _ => DesignThemeMode.System
        };
        ThemeService.CurrentThemeMode = isDark ? ThemeMode.Dark : ThemeMode.Light;
        await JsRuntime.InvokeVoidAsync("playbookTheme.setPrimaryColor", CurrentTheme.PrimaryColor);
    }
}
