@inject PlaybookState State
@inject IThemeService ThemeService
@inject IJSRuntime JsRuntime
@implements IDisposable

<div class="playbook theme-@State.Theme" data-viewport="@State.Viewport" data-color-mode="@State.Mode" style="color-scheme: @ColorSchemeValue;">
    <header class="playbook-bar">
        <NavLink class="playbook-brand" href="" Match="NavLinkMatch.All" aria-label="UI Playbook component gallery">
            <span>SB</span>
            <strong>UI Playbook</strong>
        </NavLink>

        <nav class="playbook-nav" aria-label="Playbook pages">
            <NavLink href="" Match="NavLinkMatch.All">Components</NavLink>
            <NavLink href="component-browser">Component browser</NavLink>
            <NavLink href="form-controls">Form controls</NavLink>
            <NavLink href="grid-performance">Virtual grid</NavLink>
            <NavLink href="landing">Landing page</NavLink>
            <NavLink href="access/login">Access pages</NavLink>
            <NavLink href="application-shell">Application shell</NavLink>
        </nav>

        <div class="playbook-control">
            <label for="theme-select">Application</label>
            <AppSelect TValue="string" Id="theme-select" Options="@ThemeOptions"
                       @bind-Value="State.Theme" @bind-Value:after="ApplyThemeAsync" />
        </div>

        <div class="playbook-segment playbook-segment--theme" aria-label="Color scheme">
            <button class="@Active(State.Mode, "light")" aria-label="Use light theme" title="Light" @onclick='() => ChangeModeAsync("light")'><span aria-hidden="true">☼</span></button>
            <button class="@Active(State.Mode, "dark")" aria-label="Use dark theme" title="Dark" @onclick='() => ChangeModeAsync("dark")'><span aria-hidden="true">◐</span></button>
            <button class="@Active(State.Mode, "auto")" aria-label="Use system theme" title="Auto" @onclick='() => ChangeModeAsync("auto")'><span aria-hidden="true">A</span></button>
        </div>

        <div class="playbook-segment playbook-segment--viewport" aria-label="Preview width">
            <button class="@Active(State.Viewport, "wide")" @onclick='() => State.Viewport = "wide"'>Wide</button>
            <button class="@Active(State.Viewport, "narrow")" @onclick='() => State.Viewport = "narrow"'>Narrow</button>
        </div>
    </header>

    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private static string Active(string value, string candidate) =>
        value == candidate ? "is-active" : string.Empty;
    private string ColorSchemeValue => State.Mode == "auto" ? "light dark" : State.Mode;
    private static AppSelectOption<string>[] ThemeOptions =>
        PlaybookCatalog.Themes.Select(theme => new AppSelectOption<string>(theme.Key, theme.Name)).ToArray();

    protected override void OnInitialized()
    {
        State.Changed += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyThemeAsync();
        }
    }

    private async Task ChangeModeAsync(string mode)
    {
        State.Mode = mode;
        await ApplyThemeAsync();
    }

    private async Task ApplyThemeAsync()
    {
        var theme = PlaybookCatalog.Themes.First(value => value.Key == State.Theme);
        await JsRuntime.InvokeVoidAsync("playbookTheme.setPrimaryColor", theme.PrimaryColor);
        var isDark = State.Mode == "dark"
            || State.Mode == "auto" && await JsRuntime.InvokeAsync<bool>("playbookTheme.prefersDark");
        ThemeService.ThemeConfiguration = State.Mode switch
        {
            "light" => DesignThemeMode.Light,
            "dark" => DesignThemeMode.Dark,
            _ => DesignThemeMode.System
        };
        ThemeService.CurrentThemeMode = isDark ? ThemeMode.Dark : ThemeMode.Light;
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= HandleStateChanged;
}
