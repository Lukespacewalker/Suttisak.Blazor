@page "/report-print"
@inject IJSRuntime JS
<PageTitle>Report / print composition</PageTitle>
<div class="report-print-example">
    <div class="report-print-example__screen">
        <PageHeading Title="Complete printable report" Description="A generic composition: application owns records, filters and report meaning." />
        <AppButton OnClick="_ => Print()">Print / save PDF</AppButton>
        <p>Screen page @(Page + 1) of 4. Print includes all 12 filtered records and their source detail.</p>
        <FormSection Title="Screen preview">
            @foreach (var number in Enumerable.Range(Page * 3 + 1, 3)) { <p>Record @number — application-owned description</p> }
            <AppButton Disabled="@(Page == 0)" OnClick="_ => Page--">Previous</AppButton>
            <AppButton Disabled="@(Page == 3)" OnClick="_ => Page++">Next</AppButton>
        </FormSection>
    </div>
    <section class="report-print-example__print" aria-label="Complete printable content">
        <h1>Complete printable report</h1>
        <p>Status: example draft · Filter: all records · Generated document: 12 records</p>
        <table>
            <thead><tr><th>Record</th><th>Description</th><th>Source detail</th></tr></thead>
            <tbody>@foreach (var number in Enumerable.Range(1, 12)) { <tr><td>@number</td><td>Application-owned description</td><td>Frozen source reference @number</td></tr> }</tbody>
        </table>
    </section>
</div>
@code { int Page; async Task Print() => await JS.InvokeVoidAsync("window.print"); }
