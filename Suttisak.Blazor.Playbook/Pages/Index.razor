@page "/"
@inject PlaybookState State
@inject NavigationManager Navigation

<PageTitle>Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <main class="playbook-home">
        <section class="playbook-home__hero" aria-labelledby="playbook-home-title">
            <div class="playbook-home__hero-copy">
                <span class="playbook-kicker">Suttisak.Blazor / The UI Playbook</span>
                <h1 id="playbook-home-title">Meet Nexora.<br /><em>Make it yours.</em></h1>
                <p>Calm surfaces. Clear interactions. Your application's identity. Explore the default appearance through working components and complete page patterns.</p>
                <div class="playbook-home__actions">
                    <AppButton Href="components" Class="playbook-home__primary-action" Variant="AppButtonVariant.Primary" IconEndName="ArrowRight">Browse components</AppButton>
                    <AppButton Href="patterns" Variant="AppButtonVariant.Subtle">View patterns</AppButton>
                </div>
                <form class="playbook-home__search" role="search" @onsubmit="SearchComponents" @onsubmit:preventDefault>
                    <AppTextBox Type="search" Label="Search the component library" Placeholder="Try button, grid, or navigation" Autocomplete="off" @bind-Value="_componentQuery" />
                    <AppButton Type="submit" AriaLabel="Search components" IconStartName="Search" IconOnly="true" />
                </form>
                <div class="playbook-home__edition"><span>Nexora is the default appearance</span><span>Light / Dark / System</span></div>
            </div>
            <section class="playbook-home__preview" aria-labelledby="preview-title">
                <img class="playbook-home__material" src="art/nexora-material-study.webp" alt="" width="1672" height="941" fetchpriority="high" />
                <div class="playbook-home__preview-content">
                    <div class="playbook-home__preview-meta"><span>Live component preview</span><span>@CurrentTheme.Name</span></div>
                    <h2 id="preview-title">A little space for your work.</h2>
                    <p>Try the controls. This example stays in your browser.</p>
                    <form class="playbook-home__preview-form" @onsubmit="ApplyPreview" @onsubmit:preventDefault>
                        <AppTextBox Label="Workspace name" @bind-Value="_workspaceName" Autocomplete="off" />
                        <AppSwitch Label="Weekly summaries" @bind-Value="_weeklySummaries" />
                        <div class="playbook-home__preview-actions">
                            <AppButton Type="submit" Variant="AppButtonVariant.Primary" IconEndName="ArrowRight">Apply changes</AppButton>
                            <a href="patterns/validated-form-workflow">View the recipe</a>
                        </div>
                        <p class="playbook-home__preview-status" role="status">@_previewStatus</p>
                    </form>
                </div>
                <div class="playbook-home__preview-footer"><span>AppTextBox · AppSwitch · AppButton</span><a href="form-controls">Explore form controls →</a></div>
            </section>
        </section>

        <section class="playbook-home__identities" aria-labelledby="identities-title">
            <div><span class="playbook-kicker">Appearance × identity</span><h2 id="identities-title">One system. Six identities.</h2><p>Nexora sets the surfaces. Your application sets the accent. MentalInsight keeps its copper.</p></div>
            <div class="playbook-home__palettes" role="group" aria-label="Application palette examples">
                @foreach (var theme in PlaybookCatalog.Themes)
                {
                    <button type="button" aria-label="@($"Preview {theme.Name} palette")" aria-pressed="@(State.Theme == theme.Key ? "true" : "false")" @onclick="() => SelectApplication(theme.Key)"><span style="@($"--palette-swatch: {AccentFor(theme)}")" aria-hidden="true"></span>@theme.Name</button>
                }
            </div>
        </section>

        <section class="playbook-home__dashboard" aria-labelledby="dashboard-title">
            <header><span class="playbook-kicker">The library at a glance</span><h2 id="dashboard-title">Ready to explore.</h2></header>
            <div class="playbook-home__metrics">
                <article><strong>@ComponentCount</strong><span>Components</span><p>Public Razor components listed in the generated manifest.</p></article>
                <article><strong>@WorkbenchCount</strong><span>Workbenches</span><p>Interactive specimen pages. Some components share a workbench.</p></article>
                <article><strong>@PatternCount</strong><span>Page patterns</span><p>Examples with component lists, sample Razor, and test references.</p></article>
                <article><strong>@ThemeCount</strong><span>Application palettes</span><p>Product identity, independent of appearance.</p></article>
            </div>
            <div class="playbook-home__dashboard-links">
                <a href="components/app-button"><span>Example</span><strong>AppButton reference →</strong></a>
                <a href="guidelines"><span>Guidelines</span><strong>Accessibility and theming →</strong></a>
                <a href="component-manifest.json"><span>Manifest</span><strong>component-manifest.json →</strong></a>
            </div>
        </section>

        <section class="playbook-home__start" aria-labelledby="start-title">
            <header><span class="playbook-kicker">Make something useful</span><h2 id="start-title">From a control<br />to a complete page.</h2></header>
            <div class="playbook-home__path-grid">
                <a href="foundations" class="playbook-home__path">
                    <span>01 / Foundations</span><h3>Start with the language.</h3>
                    <p>Understand the semantic colors, typography, spacing, and motion behind every component.</p><strong>View design tokens →</strong>
                </a>
                <a href="components" class="playbook-home__path playbook-home__path--featured">
                    <span>02 / Components</span><h3>Try the building blocks.</h3>
                    <p>Search the library, test real controls, and read the API beside responsive previews.</p><strong>Browse components →</strong>
                </a>
                <a href="patterns" class="playbook-home__path">
                    <span>03 / Patterns</span><h3>See how it comes together.</h3>
                    <p>Explore sign-in, data workspaces, landing pages, and application shells with working recipes.</p><strong>Explore page patterns →</strong>
                </a>
            </div>
        </section>

        <section class="playbook-home__contract" aria-labelledby="contract-title">
            <div><span class="playbook-kicker">Responsibilities</span><h2 id="contract-title">What the library controls</h2></div>
            <div class="playbook-home__contract-list">
                <article><span>Theme</span><p>Switch application and color mode from the workbench bar. Every specimen responds in place.</p></article>
                <article><span>Access</span><p>Keyboard focus, semantic state, narrow screens, and reduced motion stay part of the component contract.</p></article>
                <article><span>Ownership</span><p>The library owns structure and behavior. Consuming applications keep their copy, routes, and assets.</p></article>
                <article><span>Tooling</span><p>The manifest gives developers and code tools the same component catalog.</p></article>
            </div>
        </section>
    </main>
</PlaybookShell>

@code {
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);
    private static int ComponentCount => PlaybookComponentCatalog.All.Count;
    private static int WorkbenchCount => PlaybookSpecimenRegistry.DistinctSpecimenCount;
    private static int PatternCount => PlaybookPatternCatalog.All.Count;
    private static int ThemeCount => PlaybookCatalog.Themes.Count();
    private string? _componentQuery;
    private string? _workspaceName = "Northstar Studio";
    private bool _weeklySummaries = true;
    private string _previewStatus = "";

    private void SearchComponents() => Navigation.NavigateTo($"components?q={Uri.EscapeDataString(_componentQuery?.Trim() ?? "")}&theme={State.Theme}&appearance={State.Appearance}&mode={State.Mode}");
    private void ApplyPreview() => _previewStatus = $"Updated {_workspaceName?.Trim()}. Weekly summaries are {(_weeklySummaries ? "on" : "off")}.";
    private void SelectApplication(string key)
    {
        State.TrySetTheme(key);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("theme", key), replace: true);
    }
    private static string AccentFor(PlaybookTheme theme) => theme.Key == "mentalinsight" ? "#96502e" : theme.PrimaryColor;
}
