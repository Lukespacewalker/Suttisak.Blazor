@page "/"
@inject PlaybookState State

<PageTitle>Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <main class="playbook-home">
        <section class="playbook-home__hero" aria-labelledby="playbook-home-title">
            <div class="playbook-home__hero-copy">
                <span class="playbook-kicker">Shared UI system · @CurrentTheme.Name</span>
                <h1 id="playbook-home-title">Build once.<br /><em>Speak every product.</em></h1>
                <p>Explore live Razor components, learn their contracts, and test complete integration patterns against every application theme.</p>
                <div class="playbook-home__actions">
                    <a class="playbook-home__primary-action" href="components">Browse components <span aria-hidden="true">→</span></a>
                    <a class="playbook-home__secondary-action" href="application-shell">Open an integrated example</a>
                </div>
            </div>
            <div class="playbook-home__signal" aria-label="Playbook capabilities">
                <span class="playbook-home__signal-label">One contract / six voices</span>
                <div class="playbook-home__signal-orbit" aria-hidden="true"><strong>SB</strong></div>
                <div class="playbook-preferences playbook-home__preferences"><span>Try the theme</span><ThemeSwitcher /></div>
                <ul>
                    <li><strong>Live</strong><span>Interactive specimens</span></li>
                    <li><strong>Adaptive</strong><span>Theme and viewport controls</span></li>
                    <li><strong>Practical</strong><span>Full-page patterns</span></li>
                </ul>
            </div>
        </section>

        <section class="playbook-home__start" aria-labelledby="start-title">
            <header><span class="playbook-kicker">Start exploring</span><h2 id="start-title">Choose the level you need.</h2></header>
            <div class="playbook-home__path-grid">
                <a href="components" class="playbook-home__path playbook-home__path--featured">
                    <span>01 / Components</span><h3>Inspect the building blocks</h3>
                    <p>Pick a component from the sidebar, use the live preview, then copy the Razor usage pattern.</p><strong>Open component browser →</strong>
                </a>
                <a href="form-controls" class="playbook-home__path">
                    <span>02 / Forms</span><h3>Connect real inputs</h3>
                    <p>See validation and enhanced form behavior in a focused integration sandbox.</p><strong>View form pattern →</strong>
                </a>
                <a href="application-shell" class="playbook-home__path">
                    <span>03 / Application</span><h3>Study the complete shell</h3>
                    <p>Move through responsive navigation, records, details, and an individual workspace.</p><strong>Launch application shell →</strong>
                </a>
            </div>
        </section>

        <section class="playbook-home__contract" aria-labelledby="contract-title">
            <div><span class="playbook-kicker">The library contract</span><h2 id="contract-title">Product identity changes.<br />Behavior does not.</h2></div>
            <div class="playbook-home__contract-list">
                <article><span>Theme</span><p>Switch application and color mode from the workbench bar. Every specimen responds in place.</p></article>
                <article><span>Access</span><p>Keyboard focus, semantic state, narrow screens, and reduced motion stay part of the component contract.</p></article>
                <article><span>Ownership</span><p>The library owns structure and behavior. Consuming applications keep their copy, routes, and assets.</p></article>
            </div>
        </section>
    </main>
</PlaybookShell>

@code {
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);
}
