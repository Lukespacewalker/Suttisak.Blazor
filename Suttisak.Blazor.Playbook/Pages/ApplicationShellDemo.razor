@page "/application-shell"

<PageTitle>Application Shell · UI Playbook</PageTitle>

<PlaybookShell>
    <div class="application-shell-workbench">
        <DemoApplicationShell BreadcrumbItems="@OverviewBreadcrumbs">
            <PageHeading>
                <PageHeading Title="Good morning, Kanda"
                             Description="A compact home for daily operations, recent activity, and the work that needs attention."
                             IconName="@("Home")">
                    <PageActions>
                        <AppButton Href="application-shell/records" Variant="AppButtonVariant.Primary">
                            <IconStartContent><Suttisak.Blazor.Icons.Icon Name="Table" Size="20"  /></IconStartContent>
                            <ChildContent>Open records</ChildContent>
                        </AppButton>
                    </PageActions>
                </PageHeading>
            </PageHeading>

            <ChildContent>
            <div class="demo-overview-grid">
                <section class="demo-overview-card demo-overview-card--feature">
                    <span class="demo-overview-card__index">01 / RECORDS</span>
                    <h2>Record management</h2>
                    <p>Review the data grid, add or edit a record, and open its detail page.</p>
                    <a class="demo-text-link" href="application-shell/records">Manage records <span aria-hidden="true">→</span></a>
                </section>
                <section class="demo-overview-card">
                    <span class="demo-overview-card__index">TODAY</span>
                    <strong class="demo-overview-metric">6</strong>
                    <h2>Open items</h2>
                    <p>Two records have changed since your last visit.</p>
                </section>
                <section class="demo-overview-card">
                    <span class="demo-overview-card__index">PACE</span>
                    <strong class="demo-overview-metric">82%</strong>
                    <h2>On schedule</h2>
                    <p>Current programs are tracking above this month’s target.</p>
                </section>
            </div>
            </ChildContent>
        </DemoApplicationShell>
    </div>
</PlaybookShell>

@code {
    private readonly Breadcrumb[] OverviewBreadcrumbs =
    [
        new("Home", null, "Overview")
    ];
}
