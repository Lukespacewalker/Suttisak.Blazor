@page "/access/custom-error"
@using Suttisak.Blazor.UserInterface.Routing
@inject PlaybookState State

<PageTitle>Custom error pattern · UI Playbook</PageTitle>

<PlaybookShell>
    <AccessPageFrame Title="Application-owned error copy">
        <main class="custom-error-workbench">
            <aside class="custom-error-editor" aria-labelledby="custom-error-editor-title">
                <div class="custom-error-editor__heading">
                    <span>LIVE CONFIGURATION</span>
                    <h1 id="custom-error-editor-title">Make the error belong to the app.</h1>
                    <p>The generator owns routes. The application owns brand, language, actions, and support guidance.</p>
                </div>

                <AppSelect TValue="int" Label="Status" Options="@StatusOptions" @bind-Value="StatusCode" />

                <div class="custom-error-editor__row">
                    <AppTextBox Label="Brand name" @bind-Value="Options.BrandName" />
                    <AppTextBox Label="Eyebrow" @bind-Value="Current.Eyebrow" />
                </div>
                <AppTextBox Label="Title" @bind-Value="Current.Title" />
                <AppTextArea Label="Message" Rows="4" @bind-Value="Current.Message" />

                <div class="custom-error-editor__row">
                    <AppTextBox Label="Primary action" @bind-Value="Current.PrimaryActionLabel" />
                    <AppTextBox Label="Home path" @bind-Value="Options.HomeHref" />
                </div>
                <AppTextBox Label="Footer guidance" @bind-Value="Current.FooterText" />

                <div class="custom-error-editor__check">
                    <AppCheckbox Label="Show incident reference for support" @bind-Value="Options.ShowRequestId" />
                </div>

                <div class="custom-error-editor__actions">
                    <AppButton Variant="AppButtonVariant.Primary" OnClick="UseSelectedApp">Use selected app</AppButton>
                    <AppButton OnClick="ResetCopy">Reset copy</AppButton>
                </div>

                <details class="custom-error-editor__code">
                    <summary>Program.cs configuration</summary>
                    <pre><code>@ConfigurationExample</code></pre>
                </details>
            </aside>

            <section class="custom-error-preview" aria-label="Custom status page preview">
                <StatusRouteContent StatusCode="@StatusCode"
                                    RequestId="ERR-DEMO-9F2A"
                                    Options="@Options" />
            </section>
        </main>
    </AccessPageFrame>
</PlaybookShell>

@code {
    private int StatusCode { get; set; } = 500;
    private StatusRouteOptions Options { get; set; } = new();
    private StatusRoutePageOptions Current => Options.Resolve(StatusCode);

    private static readonly AppSelectOption<int>[] StatusOptions =
    [
        new(403, "403 · Forbidden"),
        new(404, "404 · Not found"),
        new(500, "500 · Server error")
    ];

    protected override void OnInitialized() => UseSelectedApp();

    private void UseSelectedApp()
    {
        var theme = PlaybookCatalog.Themes.First(value => value.Key == State.Theme);
        Options.BrandName = theme.Name;
        Options.LogoUrl = theme.LogoPath;
    }

    private void ResetCopy()
    {
        var brand = Options.BrandName;
        var logo = Options.LogoUrl;
        Options = new StatusRouteOptions { BrandName = brand, LogoUrl = logo };
    }

    private string ConfigurationExample => $$"""
        builder.Services.AddSuttisakStatusRoutes(options =>
        {
            options.BrandName = "{{Options.BrandName}}";
            options.LogoUrl = "/assets/logo.webp";
            options.HomeHref = "{{Options.HomeHref}}";
            options.Error.Title = "{{Options.Error.Title}}";
            options.Error.Message = "{{Options.Error.Message}}";
            options.Error.PrimaryActionLabel = "{{Options.Error.PrimaryActionLabel}}";
        });
        """;
}
