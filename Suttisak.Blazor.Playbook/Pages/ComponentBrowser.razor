@page "/component-browser"
@page "/components"
@inject NavigationManager Navigation

<PageTitle>Component Browser · Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <main class="component-browser">
        <header class="component-browser__hero">
            <div>
                <span class="playbook-kicker">Component Browser</span>
                <h1>Find the contract.<br /><em>Inspect the behavior.</em></h1>
                <p>Search the public component surface, open a focused executable story, and follow each building block into the patterns that use it. Coverage labels describe what is actually available.</p>
                <div class="component-browser__hero-actions">
                    <a href="patterns">Browse composition patterns →</a>
                    <a href="tokens">Inspect design tokens →</a>
                    <a href="component-manifest.json">Open component manifest ↗</a>
                </div>
            </div>

            <aside class="component-browser__coverage-summary" aria-label="Component coverage summary">
                <article><strong>@Coverage.Total</strong><span>catalogued</span></article>
                <article><strong>@Coverage.Interactive</strong><span>interactive</span></article>
                <article><strong>@PlaybookSpecimenRegistry.DistinctSpecimenCount</strong><span>workbenches</span></article>
                <article><strong>@Coverage.Reference</strong><span>references</span></article>
                <div><span style="@InteractiveProgressStyle"></span></div>
                <p>@Coverage.InteractivePercent% of catalogued components have executable coverage across @PlaybookSpecimenRegistry.DistinctSpecimenCount distinct workbenches.</p>
            </aside>
        </header>

        <div class="component-browser__workspace">
            <aside class="component-browser__sidebar" aria-label="Component Browser filters">
                <label class="component-browser__search">
                    <span>Find a component</span>
                    <input type="search"
                           name="component-search"
                           autocomplete="off"
                           placeholder="Button, grid, navigation…"
                           value="@Search"
                           @oninput="HandleSearchInput" />
                </label>

                <fieldset class="component-browser__coverage-filter">
                    <legend>Coverage</legend>
                    <button type="button" class="@FilterClass(null)" aria-pressed="@Pressed(SelectedCoverage is null)" @onclick="() => SetCoverageFilter(null)">All <small>@Coverage.Total</small></button>
                    @foreach (var kind in CoverageKinds)
                    {
                        <button type="button" class="@FilterClass(kind)" aria-pressed="@Pressed(SelectedCoverage == kind)" @onclick="() => SetCoverageFilter(kind)">
                            @PlaybookComponentCoverage.LabelFor(kind) <small>@CoverageCount(kind)</small>
                        </button>
                    }
                </fieldset>

                <nav class="component-browser__category-links" aria-label="Visible component categories">
                    <span>Jump to category</span>
                    @foreach (var group in FilteredGroups)
                    {
                        <a href="@CategoryHref(group.Key)"><span>@group.Key</span><small>@group.Count()</small></a>
                    }
                </nav>
            </aside>

            <div class="component-browser__content">
                <header class="component-browser__results-header" aria-live="polite" aria-atomic="true">
                    <div class="component-browser__results-copy">
                        <span>@FilteredComponentCount results</span>
                        <strong>@ResultsHeading</strong>
                    </div>
                    <div class="component-browser__results-actions">
                        <div class="component-browser__view-switcher" role="group" aria-label="Catalog view">
                            <button type="button" aria-pressed="@Pressed(ViewMode == "cards")" class="@(ViewMode == "cards" ? "is-active" : null)" @onclick='() => SetView("cards")'>Cards</button>
                            <button type="button" aria-pressed="@Pressed(ViewMode == "compact")" class="@(ViewMode == "compact" ? "is-active" : null)" @onclick='() => SetView("compact")'>Compact</button>
                        </div>
                        @if (HasActiveFilters)
                        {
                            <button type="button" @onclick="ClearFilters">Clear filters</button>
                        }
                    </div>
                </header>

                @if (FilteredComponentCount == 0)
                {
                    <section class="component-browser__empty" aria-live="polite">
                        <strong>No component matches those filters.</strong>
                        <p>Try a broader term or clear the coverage filter.</p>
                        <button type="button" @onclick="ClearFilters">Show the complete catalog</button>
                    </section>
                }
                else
                {
                    @foreach (var group in FilteredGroups)
                    {
                        <section id="@GroupId(group.Key)" class="component-browser__group" aria-labelledby="@($"{GroupId(group.Key)}-title")">
                            <header>
                                <h2 id="@($"{GroupId(group.Key)}-title")">@group.Key</h2>
                                <span>@group.Count()</span>
                            </header>

                            <div class="component-browser__grid component-browser__grid--@ViewMode">
                                @foreach (var component in group)
                                {
                                    var coverageKind = PlaybookComponentCoverage.KindFor(component);
                                    <a class="component-browser__card" href="@component.DetailHref" data-component-name="@component.Name" data-component-coverage="@PlaybookComponentCoverage.SlugFor(coverageKind)">
                                        <div class="component-browser__card-meta">
                                            <span class="component-browser__status component-browser__status--@component.Status.ToString().ToLowerInvariant()">@component.Status</span>
                                            <span class="component-browser__coverage component-browser__coverage--@PlaybookComponentCoverage.SlugFor(coverageKind)">@PlaybookComponentCoverage.LabelFor(coverageKind)</span>
                                        </div>
                                        <h3>@component.Name</h3>
                                        <p>@component.Summary</p>
                                        <small>@component.SourceArea · @string.Join(" · ", component.Tags.Take(3))</small>
                                        <footer>
                                            <span>@ActionLabel(coverageKind)</span>
                                            <span aria-hidden="true">→</span>
                                        </footer>
                                    </a>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </div>
    </main>
</PlaybookShell>

@code {
    private static readonly PlaybookComponentCoverageKind[] CoverageKinds =
    [
        PlaybookComponentCoverageKind.Interactive,
        PlaybookComponentCoverageKind.Pattern,
        PlaybookComponentCoverageKind.Reference
    ];

    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "coverage")] public string? CoverageFilter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private static PlaybookComponentCoverageSummary Coverage => PlaybookComponentCoverage.Summary;

    private PlaybookComponentCoverageKind? SelectedCoverage =>
        Enum.TryParse<PlaybookComponentCoverageKind>(CoverageFilter, true, out var value) ? value : null;

    private string ViewMode => View?.Equals("compact", StringComparison.OrdinalIgnoreCase) == true ? "compact" : "cards";

    private IEnumerable<PlaybookComponentDefinition> FilteredComponents =>
        PlaybookComponentCatalog.All.Where(MatchesSearch).Where(MatchesCoverage);

    private IReadOnlyList<IGrouping<string, PlaybookComponentDefinition>> FilteredGroups =>
        FilteredComponents.GroupBy(component => component.Category).ToArray();

    private int FilteredComponentCount => FilteredComponents.Count();
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(Search) || SelectedCoverage is not null;
    private string InteractiveProgressStyle => $"width:{Coverage.InteractivePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%";

    private string ResultsHeading => SelectedCoverage is null
        ? string.IsNullOrWhiteSpace(Search) ? "Complete component map" : $"Matching “{Search.Trim()}”"
        : $"{PlaybookComponentCoverage.LabelFor(SelectedCoverage.Value)} coverage";

    private bool MatchesSearch(PlaybookComponentDefinition component)
    {
        if (string.IsNullOrWhiteSpace(Search))
        {
            return true;
        }

        var search = Search.Trim();
        return component.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
            || component.Category.Contains(search, StringComparison.OrdinalIgnoreCase)
            || component.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)
            || component.SourceArea.Contains(search, StringComparison.OrdinalIgnoreCase)
            || component.Tags.Any(tag => tag.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesCoverage(PlaybookComponentDefinition component) =>
        SelectedCoverage is null || PlaybookComponentCoverage.KindFor(component) == SelectedCoverage;

    private void HandleSearchInput(ChangeEventArgs args)
    {
        Search = args.Value?.ToString();
        SyncUrl();
    }

    private void SetCoverageFilter(PlaybookComponentCoverageKind? kind)
    {
        CoverageFilter = kind?.ToString().ToLowerInvariant();
        SyncUrl();
    }

    private void SetView(string view)
    {
        View = view;
        SyncUrl();
    }

    private void ClearFilters()
    {
        Search = null;
        CoverageFilter = null;
        SyncUrl();
    }

    private void SyncUrl()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(Search) ? null : Search.Trim(),
            ["coverage"] = SelectedCoverage?.ToString().ToLowerInvariant(),
            ["view"] = ViewMode == "compact" ? "compact" : null
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private string FilterClass(PlaybookComponentCoverageKind? kind) => SelectedCoverage == kind ? "is-active" : string.Empty;

    private static string Pressed(bool value) => value ? "true" : "false";

    private static int CoverageCount(PlaybookComponentCoverageKind kind) => kind switch
    {
        PlaybookComponentCoverageKind.Interactive => Coverage.Interactive,
        PlaybookComponentCoverageKind.Pattern => Coverage.Pattern,
        _ => Coverage.Reference
    };

    private static string ActionLabel(PlaybookComponentCoverageKind kind) => kind switch
    {
        PlaybookComponentCoverageKind.Interactive => "Open executable workbench",
        PlaybookComponentCoverageKind.Pattern => "Open integration documentation",
        _ => "Open component reference"
    };

    private static string GroupId(string category) => $"components-{PlaybookSlug.FromText(category)}";

    private string CategoryHref(string category)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        return $"{uri.PathAndQuery}#{GroupId(category)}";
    }
}
