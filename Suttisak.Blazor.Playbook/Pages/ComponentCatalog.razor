@page "/catalog"
@inject NavigationManager Navigation

<PageTitle>Redirecting to components · Suttisak.Blazor UI Playbook</PageTitle>

<main class="playbook-compatibility-redirect" aria-labelledby="catalog-redirect-title">
    <h1 id="catalog-redirect-title">Redirecting to components…</h1>
    <p>The card and compact catalog views are available on the Components page.</p>
    <a href="components?view=compact">View components</a>
</main>

@code {
    protected override void OnInitialized()
    {
        var target = Navigation.GetUriWithQueryParameter("view", "compact")
            .Replace("/catalog", "/components", StringComparison.OrdinalIgnoreCase);
        Navigation.NavigateTo(target, replace: true);
    }
}
