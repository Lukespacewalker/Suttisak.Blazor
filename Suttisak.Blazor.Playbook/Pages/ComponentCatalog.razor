@page "/catalog"
@inject NavigationManager Navigation

<PageTitle>Opening compact Component Browser · Suttisak.Blazor UI Playbook</PageTitle>

<main class="playbook-compatibility-redirect" aria-labelledby="catalog-redirect-title">
    <h1 id="catalog-redirect-title">Opening the compact Component Browser…</h1>
    <p>The catalog now shares one discovery surface with component cards, filters, and deep links.</p>
    <a href="components?view=compact">Continue to Components</a>
</main>

@code {
    protected override void OnInitialized()
    {
        var target = Navigation.GetUriWithQueryParameter("view", "compact")
            .Replace("/catalog", "/components", StringComparison.OrdinalIgnoreCase);
        Navigation.NavigateTo(target, replace: true);
    }
}
