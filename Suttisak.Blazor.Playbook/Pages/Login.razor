@page "/access/login"
@inject PlaybookState State

<PageTitle>Login pattern · UI Playbook</PageTitle>

<PlaybookShell>
    <AccessPageFrame Title="Login with password, OAuth, or passkey">
        <main class="access-page" aria-labelledby="login-title">
            <section class="access-form-panel">
                <AccessBrand />
                <div class="access-form-panel__body">
                    <div class="access-heading">
                        <span>WELCOME BACK</span>
                        <h1 id="login-title">Sign in to continue</h1>
                        <p>Use the method your organization has enabled for you.</p>
                    </div>

                    <div class="access-provider-grid" aria-label="Alternative sign in methods">
                        <button type="button" aria-label="Continue with Microsoft (demo only)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z" /></svg>
                            Microsoft
                        </button>
                        <button type="button" aria-label="Continue with Google (demo only)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.8h5.4a4.6 4.6 0 0 1-2 3l3.1 2.4c1.9-1.7 3.1-4.3 3.1-7.3Z" /><path d="M12 22c2.7 0 5-.9 6.6-2.4l-3.1-2.4c-.9.6-2 1-3.5 1-2.6 0-4.8-1.8-5.6-4.2l-3.2 2.5A10 10 0 0 0 12 22Z" /><path d="M6.4 14a6 6 0 0 1 0-3.9L3.2 7.6a10 10 0 0 0 0 8.9L6.4 14Z" /><path d="M12 5.9c1.6 0 3 .5 4.1 1.6l2.6-2.6A9 9 0 0 0 12 2a10 10 0 0 0-8.8 5.6l3.2 2.5C7.2 7.7 9.4 5.9 12 5.9Z" /></svg>
                            Google
                        </button>
                    </div>

                    <div class="access-divider"><span>or use your account</span></div>

                    <form class="access-form" @onsubmit="PreventSubmit" @onsubmit:preventDefault>
                        <AppTextBox Label="Username" Type="text" Autocomplete="username" Placeholder="name@company.com" @bind-Value="_username">
                            <IconContent><FluentIcon Value="@(new Icons.Regular.Size20.Person())" /></IconContent>
                        </AppTextBox>
                        <AppTextBox Label="Password" Type="password" Autocomplete="current-password" Placeholder="Enter your password" @bind-Value="_password">
                            <IconContent><FluentIcon Value="@(new Icons.Regular.Size20.Password())" /></IconContent>
                        </AppTextBox>
                        <div class="access-form__options">
                            <label class="access-check"><input type="checkbox" /> <span>Keep me signed in</span></label>
                            <button class="access-text-action" type="button">Forgot password?</button>
                        </div>
                        <button class="access-primary-action" type="submit">Sign in</button>
                        <button class="access-passkey-action" type="button">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 13a5.5 5.5 0 1 1 4.9-3H22v3h-2v2h-3v2h-4.1A5.5 5.5 0 0 1 8.5 13Zm0-3a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" /></svg>
                            Sign in with a passkey
                        </button>
                    </form>

                    <div class="access-switch">
                        <span>New to @CurrentTheme.Name?</span>
                        <a href="access/register">Create an account</a>
                    </div>
                    <p class="access-demo-note">Playbook preview — authentication actions are intentionally disabled.</p>
                </div>
            </section>

            <aside class="access-story" aria-label="Product message">
                <div class="access-story__grid" aria-hidden="true"></div>
                <span class="access-story__index">SECURE ACCESS</span>
                <div>
                    <blockquote>“One clear doorway into the work that matters.”</blockquote>
                    <p>Sign in securely to continue your work in @CurrentTheme.Name.</p>
                </div>
                <div class="access-story__status"><i></i><span>Private, protected access</span><b>@CurrentTheme.Name.ToUpperInvariant()</b></div>
            </aside>
        </main>
    </AccessPageFrame>
</PlaybookShell>

@code {
    private string? _username;
    private string? _password;
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);
    private static void PreventSubmit() { }
}
