@page "/access/login"
@inject PlaybookState State

<PageTitle>Login pattern · UI Playbook</PageTitle>

<PlaybookShell>
    <AccessPageFrame Title="Login with password, OAuth, or passkey">
        <AccessPageLayout HeadingId="login-title" ShowcaseLabel="Product message">
            <Brand><AccessBrand /></Brand>
            <Controls><AccessPreferences /></Controls>
            <Kicker>@(IsThai ? "ยินดีต้อนรับกลับ" : "WELCOME BACK")</Kicker>
            <Title>@(IsThai ? "เข้าสู่ระบบเพื่อดำเนินการต่อ" : "Sign in to continue")</Title>
            <Intro><p>@(IsThai ? "เลือกวิธีที่องค์กรของคุณเปิดใช้งานไว้" : "Use the method your organization has enabled for you.")</p></Intro>
            <ChildContent>

                    <div class="access-provider-grid" aria-label="@T("Alternative sign in methods", "วิธีเข้าสู่ระบบทางเลือก")">
                        <button type="button" aria-label="@T("Continue with Microsoft (demo only)", "ดำเนินการต่อด้วย Microsoft (ตัวอย่างเท่านั้น)")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z" /></svg>
                            Microsoft
                        </button>
                        <button type="button" aria-label="@T("Sign in with a passkey (demo only)", "เข้าสู่ระบบด้วยพาสคีย์ (ตัวอย่างเท่านั้น)")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 13a5.5 5.5 0 1 1 4.9-3H22v3h-2v2h-3v2h-4.1A5.5 5.5 0 0 1 8.5 13Zm0-3a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" /></svg>
                            @T("Passkey", "พาสคีย์")
                        </button>
                    </div>

                    <div class="access-divider"><span>@T("or use your account", "หรือใช้บัญชีของคุณ")</span></div>

                    <form class="access-form" @onsubmit="PreventSubmit" @onsubmit:preventDefault>
                        <AppTextBox Label="@T("Username", "ชื่อผู้ใช้")" Type="text" Autocomplete="username" Placeholder="name@company.com" @bind-Value="_username">
                            <IconContent><Suttisak.Blazor.Icons.Icon Name="Person" Size="20"  /></IconContent>
                        </AppTextBox>
                        <AppTextBox Label="@T("Password", "รหัสผ่าน")" Type="password" Autocomplete="current-password" Placeholder="@T("Enter your password", "กรอกรหัสผ่าน")" @bind-Value="_password">
                            <IconContent><Suttisak.Blazor.Icons.Icon Name="Password" Size="20"  /></IconContent>
                        </AppTextBox>
                        <div class="access-form__options">
                            <AppCheckbox Label="@T("Keep me signed in", "ให้ฉันอยู่ในระบบ")" @bind-Value="_keepSignedIn" />
                            <AppButton Variant="AppButtonVariant.Subtle" Class="access-text-action">@T("Forgot password?", "ลืมรหัสผ่าน?")</AppButton>
                        </div>
                        <AppButton Type="submit" Variant="AppButtonVariant.Primary" Class="access-primary-action">@T("Sign in", "เข้าสู่ระบบ")</AppButton>
                    </form>

                    <div class="access-switch">
                        <span>@(IsThai ? $"เพิ่งเริ่มใช้ {CurrentTheme.Name}?" : $"New to {CurrentTheme.Name}?")</span>
                        <a href="access/register">@(IsThai ? "สร้างบัญชี" : "Create an account")</a>
                    </div>
                    <p class="access-demo-note">@T("Playbook preview — authentication actions are intentionally disabled.", "ตัวอย่าง Playbook — การยืนยันตัวตนถูกปิดไว้โดยตั้งใจ")</p>
            </ChildContent>
            <Showcase>
                <span class="access-story__index">@(IsThai ? "การเข้าถึงที่ปลอดภัย" : "SECURE ACCESS")</span>
                <div>
                    <blockquote>@(IsThai ? "“ประตูเดียวที่ชัดเจน สู่งานสำคัญของคุณ”" : "“One clear doorway into the work that matters.”")</blockquote>
                    <p>@(IsThai ? $"เข้าสู่ระบบอย่างปลอดภัยเพื่อทำงานต่อใน {CurrentTheme.Name}" : $"Sign in securely to continue your work in {CurrentTheme.Name}.")</p>
                </div>
                <div class="access-story__status"><i></i><span>@(IsThai ? "การเข้าถึงส่วนบุคคลที่ได้รับการปกป้อง" : "Private, protected access")</span><b>@CurrentTheme.Name.ToUpperInvariant()</b></div>
            </Showcase>
        </AccessPageLayout>
    </AccessPageFrame>
</PlaybookShell>

@code {
    private string? _username;
    private string? _password;
    private bool _keepSignedIn;
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);
    private bool IsThai => State.Language == "th";
    private string T(string english, string thai) => IsThai ? thai : english;
    private static void PreventSubmit() { }
}
