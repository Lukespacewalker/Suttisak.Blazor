@page "/landing"
@inject PlaybookState State
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<PageTitle>Landing Page Sandbox · Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <div class="landing-workbench">
        <header class="landing-workbench__note">
            <div><span class="playbook-kicker">Live composition</span><strong>@CurrentTheme.Name landing page</strong></div>
            <p>This page uses the shared Marketing components and the selected application theme.</p>
            <span class="landing-workbench__badge">@State.Mode · @State.Viewport</span>
        </header>

        <div class="landing-preview">
            <MarketingPage Id="landing-demo" SkipTarget="landing-features" SkipText="Skip to features">
                <header class="landing-site-header">
                    <MarketingContainer>
                        <a class="landing-site-brand" href="#landing-demo" aria-label="@CurrentTheme.Name home">
                            <img src="@CurrentTheme.LogoPath" alt="" width="@CurrentTheme.LogoWidth" height="@CurrentTheme.LogoHeight" />
                            <strong>@CurrentTheme.Name</strong>
                        </a>
                        <nav aria-label="Landing page sections">
                            <a href="#landing-product-preview">Product</a>
                            <a href="#landing-features">Benefits</a>
                            <a href="#landing-how">How it works</a>
                        </nav>
                        <a class="landing-site-header__action" href="#landing-product-preview">Product</a>
                    </MarketingContainer>
                </header>

                <MarketingHero Class="landing-reveal landing-reveal--hero"
                               Title="See the result and decide what to do next"
                               Description="@($"{CurrentTheme.Name} presents the result, supporting detail, and available follow-up in one page.")">
                    <Eyebrow>
                        <span class="landing-brand-lockup">
                            <span class="landing-brand-lockup__mark"><img src="@CurrentTheme.LogoPath" alt="" width="@CurrentTheme.LogoWidth" height="@CurrentTheme.LogoHeight" /></span>
                            <span><strong>@CurrentTheme.Name</strong><small>DESIGNED FOR CLARITY</small></span>
                        </span>
                    </Eyebrow>
                    <Actions>
                        <MarketingActionLink Href="#landing-features">View benefits</MarketingActionLink>
                        <MarketingActionLink Href="#landing-product-preview" Variant="MarketingActionVariant.Secondary">View product</MarketingActionLink>
                    </Actions>
                    <Media>
                        <figure class="landing-hero-visual @(CurrentTheme.CropHero ? "landing-hero-visual--framed landing-hero-visual--cover" : "landing-hero-visual--floating")">
                            <img src="@CurrentTheme.HeroPath" alt="@CurrentTheme.HeroAlt" width="@CurrentTheme.HeroWidth" height="@CurrentTheme.HeroHeight" fetchpriority="high" />
                            <figcaption><i aria-hidden="true"></i><span>Original @CurrentTheme.Name hero asset</span></figcaption>
                        </figure>
                    </Media>
                </MarketingHero>

                <MarketingProofStrip Class="landing-reveal" AriaLabel="Product details">
                    <MarketingProofItem Value="01" Title="Shared data" Description="The same result appears across user roles." />
                    <MarketingProofItem Value="24/7" Title="Responsive layout" Description="The page adapts from desktop to phone width." />
                    <MarketingProofItem Value="AA" Title="Keyboard support" Description="Controls include visible focus and semantic labels." />
                </MarketingProofStrip>

                <section class="landing-product-preview landing-reveal" id="landing-product-preview" aria-labelledby="landing-preview-title">
                    <MarketingContainer>
                        <div class="landing-product-preview__heading">
                                    <div><span class="landing-section__eyebrow">PRODUCT PREVIEW</span><h2 id="landing-preview-title">Product overview</h2></div>
                                    <p>The preview shows the interface after the page introduction.</p>
                        </div>
                        <MarketingProductFrame Label="INTERACTIVE PRODUCT DIRECTION">
                            <div class="landing-dashboard">
                                <div class="landing-dashboard__top"><span></span><span></span><span></span><b>@CurrentTheme.ShortName</b></div>
                                <div class="landing-dashboard__body">
                                    <div class="landing-dashboard__score"><strong>82</strong><span>On track</span></div>
                                    <div class="landing-dashboard__copy"><small>LATEST RESULT</small><h3>Assessment summary</h3><p>Three follow-up recommendations are available.</p></div>
                                </div>
                                <div class="landing-dashboard__bars"><i></i><i></i><i></i><i></i><i></i></div>
                            </div>
                        </MarketingProductFrame>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-reveal" id="landing-features" aria-labelledby="landing-features-title">
                    <MarketingContainer>
                        <MarketingSectionHeader HeadingId="landing-features-title" Title="What the product helps with" Description="The same page structure is shown with each application theme.">
                            <Eyebrow><span class="landing-section__eyebrow">WHY @CurrentTheme.ShortName</span></Eyebrow>
                        </MarketingSectionHeader>
                        <MarketingFeatureGrid>
                            <MarketingCard Title="Recommended action" Featured="true"><Visual><span class="landing-card-number">01</span></Visual><ChildContent><p>Show the current recommendation before the supporting detail.</p></ChildContent></MarketingCard>
                            <MarketingCard Title="Result details"><Visual><span class="landing-card-number">02</span></Visual><ChildContent><p>Keep scores, trends, and explanations on the same page.</p></ChildContent></MarketingCard>
                            <MarketingCard Title="Responsive layout"><Visual><span class="landing-card-number">03</span></Visual><ChildContent><p>Use the same page structure at desktop and phone widths.</p></ChildContent></MarketingCard>
                        </MarketingFeatureGrid>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-section--muted landing-reveal" id="landing-how" aria-labelledby="landing-how-title">
                    <MarketingContainer>
                        <div class="landing-split">
                            <MarketingSectionHeader HeadingId="landing-how-title" Title="How the workflow works" Description="The steps explain what happens after the result is available." Compact="true">
                                <Eyebrow><span class="landing-section__eyebrow">HOW IT WORKS</span></Eyebrow>
                            </MarketingSectionHeader>
                            <MarketingStepList>
                                <MarketingStep Number="01" Title="Collect the required information" Description="Request the fields needed to calculate the result." />
                                <MarketingStep Number="02" Title="Display the result" Description="Show the summary before optional detail." />
                                <MarketingStep Number="03" Title="Show the next action" Description="Link the recommendation to a specific task." />
                            </MarketingStepList>
                        </div>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-section--cta landing-reveal">
                    <MarketingContainer>
                        <MarketingCallToAction>
                            <Content><span class="landing-section__eyebrow">PAGE EXAMPLE</span><h2>Review the product workflow</h2><p>Shared Marketing components are used throughout this page.</p></Content>
                            <Actions><MarketingActionLink Href="#landing-demo">Back to top</MarketingActionLink></Actions>
                        </MarketingCallToAction>
                    </MarketingContainer>
                </section>

                <footer class="landing-footer"><MarketingContainer><strong>@CurrentTheme.Name</strong><span>Rendered in the Suttisak.Blazor Playbook</span></MarketingContainer></footer>
            </MarketingPage>
        </div>
    </div>
</PlaybookShell>

@code {
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("playbookMotion.observeScrollReveals", ".playbook");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("playbookMotion.disconnect");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
