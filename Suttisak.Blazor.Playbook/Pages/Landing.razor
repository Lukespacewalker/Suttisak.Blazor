@page "/landing"
@inject PlaybookState State
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<PageTitle>Landing Page Sandbox · Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <div class="landing-workbench">
        <header class="landing-workbench__note">
            <div><span class="playbook-kicker">Live composition</span><strong>@CurrentTheme.Name landing page</strong></div>
            <p>Built entirely from shared Marketing components. Edit this route to prototype a product landing page without touching an application.</p>
            <span class="landing-workbench__badge">@State.Mode · @State.Viewport</span>
        </header>

        <div class="landing-preview">
            <MarketingPage Id="landing-demo" SkipTarget="landing-features" SkipText="Skip to features">
                <header class="landing-site-header">
                    <MarketingContainer>
                        <a class="landing-site-brand" href="#landing-demo" aria-label="@CurrentTheme.Name home">
                            <img src="@CurrentTheme.LogoPath" alt="" width="@CurrentTheme.LogoWidth" height="@CurrentTheme.LogoHeight" />
                            <strong>@CurrentTheme.Name</strong>
                        </a>
                        <nav aria-label="Landing page sections">
                            <a href="#landing-product-preview">Product</a>
                            <a href="#landing-features">Benefits</a>
                            <a href="#landing-how">How it works</a>
                        </nav>
                        <a class="landing-site-header__action" href="#landing-product-preview">Explore</a>
                    </MarketingContainer>
                </header>

                <MarketingHero Class="landing-reveal landing-reveal--hero"
                               Title="Understand the signal. Act with confidence."
                               Description="@($"{CurrentTheme.Name} turns complex information into a focused next step for every person who needs it.")">
                    <Eyebrow>
                        <span class="landing-brand-lockup">
                            <span class="landing-brand-lockup__mark"><img src="@CurrentTheme.LogoPath" alt="" width="@CurrentTheme.LogoWidth" height="@CurrentTheme.LogoHeight" /></span>
                            <span><strong>@CurrentTheme.Name</strong><small>DESIGNED FOR CLARITY</small></span>
                        </span>
                    </Eyebrow>
                    <Actions>
                        <MarketingActionLink Href="#landing-features">Explore the product</MarketingActionLink>
                        <MarketingActionLink Href="#landing-product-preview" Variant="MarketingActionVariant.Secondary">See live preview</MarketingActionLink>
                    </Actions>
                    <Media>
                        <figure class="landing-hero-visual @(CurrentTheme.CropHero ? "landing-hero-visual--framed landing-hero-visual--cover" : "landing-hero-visual--floating")">
                            <img src="@CurrentTheme.HeroPath" alt="@CurrentTheme.HeroAlt" width="@CurrentTheme.HeroWidth" height="@CurrentTheme.HeroHeight" fetchpriority="high" />
                            <figcaption><i aria-hidden="true"></i><span>Original @CurrentTheme.Name hero asset</span></figcaption>
                        </figure>
                    </Media>
                </MarketingHero>

                <MarketingProofStrip Class="landing-reveal" AriaLabel="Product highlights">
                    <MarketingProofItem Value="01" Title="One clear source" Description="Shared language across every role." />
                    <MarketingProofItem Value="24/7" Title="Ready when needed" Description="Responsive from desk to phone." />
                    <MarketingProofItem Value="AA" Title="Accessible foundation" Description="Contrast and focus built into the system." />
                </MarketingProofStrip>

                <section class="landing-product-preview landing-reveal" id="landing-product-preview" aria-labelledby="landing-preview-title">
                    <MarketingContainer>
                        <div class="landing-product-preview__heading">
                            <div><span class="landing-section__eyebrow">LIVE PRODUCT PREVIEW</span><h2 id="landing-preview-title">See the product before the details.</h2></div>
                            <p>The real hero establishes each app’s identity first. This preview follows as product proof, where the interface can be refined without competing with the opening message.</p>
                        </div>
                        <MarketingProductFrame Label="INTERACTIVE PRODUCT DIRECTION">
                            <div class="landing-dashboard">
                                <div class="landing-dashboard__top"><span></span><span></span><span></span><b>@CurrentTheme.ShortName</b></div>
                                <div class="landing-dashboard__body">
                                    <div class="landing-dashboard__score"><strong>82</strong><span>On track</span></div>
                                    <div class="landing-dashboard__copy"><small>LATEST INSIGHT</small><h3>Your result, explained clearly</h3><p>Three focused recommendations are ready to review.</p></div>
                                </div>
                                <div class="landing-dashboard__bars"><i></i><i></i><i></i><i></i><i></i></div>
                            </div>
                        </MarketingProductFrame>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-reveal" id="landing-features" aria-labelledby="landing-features-title">
                    <MarketingContainer>
                        <MarketingSectionHeader HeadingId="landing-features-title" Title="Useful detail, without the noise" Description="A complete product story composed from reusable blocks. Swap the app theme above and the identity changes without changing the page structure.">
                            <Eyebrow><span class="landing-section__eyebrow">WHY @CurrentTheme.ShortName</span></Eyebrow>
                        </MarketingSectionHeader>
                        <MarketingFeatureGrid>
                            <MarketingCard Title="A guided next step" Featured="true"><Visual><span class="landing-card-number">01</span></Visual><ChildContent><p>Lead with the action that matters now, then reveal detail when the reader asks for it.</p></ChildContent></MarketingCard>
                            <MarketingCard Title="Evidence in context"><Visual><span class="landing-card-number">02</span></Visual><ChildContent><p>Keep scores, trends, and explanations together so decisions are easier to trust.</p></ChildContent></MarketingCard>
                            <MarketingCard Title="One system, every screen"><Visual><span class="landing-card-number">03</span></Visual><ChildContent><p>Move from an overview to administration without losing the product’s visual voice.</p></ChildContent></MarketingCard>
                        </MarketingFeatureGrid>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-section--muted landing-reveal" id="landing-how" aria-labelledby="landing-how-title">
                    <MarketingContainer>
                        <div class="landing-split">
                            <MarketingSectionHeader HeadingId="landing-how-title" Title="From information to action" Description="A short, visible path helps a general audience understand what happens next." Compact="true">
                                <Eyebrow><span class="landing-section__eyebrow">HOW IT WORKS</span></Eyebrow>
                            </MarketingSectionHeader>
                            <MarketingStepList>
                                <MarketingStep Number="01" Title="Bring the signal together" Description="Collect only the information needed for this decision." />
                                <MarketingStep Number="02" Title="Explain what it means" Description="Use reader-first language and progressive disclosure." />
                                <MarketingStep Number="03" Title="Offer a practical next step" Description="Turn the result into an action someone can complete." />
                            </MarketingStepList>
                        </div>
                    </MarketingContainer>
                </section>

                <section class="landing-section landing-section--cta landing-reveal">
                    <MarketingContainer>
                        <MarketingCallToAction>
                            <Content><span class="landing-section__eyebrow">READY TO BEGIN?</span><h2>Make the next decision feel simple.</h2><p>This is a sandbox CTA—safe to reshape while refining the shared component system.</p></Content>
                            <Actions><MarketingActionLink Href="#landing-demo">Start with @CurrentTheme.Name</MarketingActionLink></Actions>
                        </MarketingCallToAction>
                    </MarketingContainer>
                </section>

                <footer class="landing-footer"><MarketingContainer><strong>@CurrentTheme.Name</strong><span>Rendered in the Suttisak.Blazor Playbook</span></MarketingContainer></footer>
            </MarketingPage>
        </div>
    </div>
</PlaybookShell>

@code {
    private PlaybookTheme CurrentTheme => PlaybookCatalog.Themes.First(theme => theme.Key == State.Theme);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("playbookMotion.observeScrollReveals", ".playbook");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("playbookMotion.disconnect");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
