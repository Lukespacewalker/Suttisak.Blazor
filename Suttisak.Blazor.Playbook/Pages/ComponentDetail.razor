@page "/components/{Slug}"

<PageTitle>@(Component is null ? "Component not found" : $"{Component.Name} · UI Playbook")</PageTitle>

<PlaybookShell>
    <main class="component-detail">
        @if (Component is null)
        {
            <section class="component-detail__not-found">
                <span class="playbook-kicker">Component documentation</span>
                <h1>That component is not in the catalog.</h1>
                <p>The URL may be stale, or the component has not been registered with the Playbook metadata yet.</p>
                <a href="components">Return to Component Browser</a>
            </section>
        }
        else
        {
            <nav class="component-detail__breadcrumbs" aria-label="Breadcrumb">
                <a href="components">Components</a><span aria-hidden="true">/</span><span>@Component.Category</span><span aria-hidden="true">/</span><strong>@Component.Name</strong>
            </nav>

            <header class="component-detail__hero">
                <div>
                    <span class="playbook-kicker">@Component.Category</span>
                    <h1>@Component.Name</h1>
                    <p>@Component.Summary</p>
                </div>
                <div class="component-detail__meta">
                    <span class="component-detail__status component-detail__status--@Component.Status.ToString().ToLowerInvariant()">@Component.Status</span>
                    <span class="component-detail__coverage component-detail__coverage--@PlaybookComponentCoverage.SlugFor(Component)">@PlaybookComponentCoverage.LabelFor(Component)</span>
                    <span>@Component.SourceArea</span>
                    @if (CoverageKind == PlaybookComponentCoverageKind.Interactive)
                    {
                        <span>Executable workbench</span>
                    }
                    else if (CoverageDocumentation?.IntegrationRoute is not null)
                    {
                        <a href="@CoverageDocumentation.IntegrationRoute">@CoverageDocumentation.IntegrationRouteLabel ↗</a>
                    }
                    else
                    {
                        <a href="catalog">Return to compact catalog →</a>
                    }
                </div>
            </header>

            <section class="component-detail__section" aria-labelledby="preview-title">
                <header>
                    <div><span>01 / Coverage</span><h2 id="preview-title">@PreviewTitle</h2></div>
                    <p>@PlaybookComponentCoverage.DescriptionFor(Component)</p>
                    @if (HasInteractiveSpecimen)
                    {
                        <div class="component-detail__viewport" aria-label="Preview width">
                            <button class="@ViewportClass("mobile")" @onclick='() => _viewport = "mobile"'>375</button>
                            <button class="@ViewportClass("tablet")" @onclick='() => _viewport = "tablet"'>768</button>
                            <button class="@ViewportClass("desktop")" @onclick='() => _viewport = "desktop"'>1280</button>
                            <button class="@ViewportClass("full")" @onclick='() => _viewport = "full"'>Full</button>
                        </div>
                    }
                </header>

                @if (SpecimenType is not null)
                {
                    <DynamicComponent Type="@SpecimenType" Parameters="@SpecimenParameters" />
                }
                else
                {
                    @if (CoverageDocumentation is not null)
                    {
                        <div class="component-detail__documentation component-detail__documentation--@PlaybookComponentCoverage.SlugFor(Component)" data-testid="coverage-documentation">
                            <div class="component-detail__documentation-intro">
                                <span>Documentation only · not executed here</span>
                                <h3>@(CoverageKind == PlaybookComponentCoverageKind.Pattern ? "Why this is a Pattern" : "Why this is a Reference")</h3>
                                <p>@CoverageDocumentation.Rationale</p>
                                @if (CoverageDocumentation.IntegrationRoute is not null)
                                {
                                    <a href="@CoverageDocumentation.IntegrationRoute">@CoverageDocumentation.IntegrationRouteLabel →</a>
                                }
                            </div>

                            <div class="component-detail__documentation-grid">
                                <article>
                                    <strong>Composition responsibilities</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.CompositionResponsibilities) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Application-owned responsibilities</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.ApplicationResponsibilities) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Regression evidence</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.RegressionEvidence) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Related components</strong>
                                    <ul>
                                        @foreach (var related in DocumentationRelatedComponents)
                                        {
                                            <li><a href="@related.DetailHref">@related.Name</a></li>
                                        }
                                    </ul>
                                </article>
                            </div>
                        </div>
                    }
                }
            </section>

            <section class="component-detail__section" aria-labelledby="api-title">
                <header><div><span>02 / API</span><h2 id="api-title">Parameters</h2></div><p>Read from the runtime component type where one is registered, so public API changes remain visible without maintaining a second handwritten table.</p></header>
                <ComponentParameterTable ComponentType="@ResolvedRuntimeType" />
            </section>

            <section class="component-detail__section" aria-labelledby="accessibility-title">
                <header><div><span>03 / Quality</span><h2 id="accessibility-title">Accessibility contract</h2></div><p>Coverage is not complete merely because a component renders. Semantics, focus, keyboard behavior, responsive containment, and reduced motion remain part of the public contract.</p></header>
                <div class="component-detail__quality-grid">
                    <article><strong>Keyboard</strong><p>Interactive controls must remain reachable and usable without a pointing device.</p></article>
                    <article><strong>Focus</strong><p>Focus visibility is tokenized and must survive every product theme.</p></article>
                    <article><strong>Semantics</strong><p>Prefer native elements and preserve labels, roles, state, and relationships exposed to assistive technology.</p></article>
                    <article><strong>Responsive</strong><p>Verify constrained containers, long content, reduced motion, light mode, and dark mode.</p></article>
                </div>
            </section>

            <section class="component-detail__section" aria-labelledby="related-title">
                <header><div><span>04 / Compose</span><h2 id="related-title">Related components</h2></div><p>Nearby contracts from the same category help agents and developers reuse the system instead of inventing parallel UI.</p></header>
                <div class="component-detail__related">
                    @foreach (var related in RelatedComponents)
                    {
                        <a href="@related.DetailHref">
                            <strong>@related.Name</strong>
                            <span>@related.Summary</span>
                            <small>@PlaybookComponentCoverage.LabelFor(related)</small>
                        </a>
                    }
                </div>
            </section>

            <footer class="component-detail__footer">
                <span>Machine-readable ID</span><code>@Component.Slug</code><span>Tags</span><p>@string.Join(" · ", Component.Tags)</p>
            </footer>
        }
    </main>
</PlaybookShell>

@code {
    [Parameter] public string? Slug { get; set; }

    private string _viewport = "desktop";

    private PlaybookComponentDefinition? Component => PlaybookComponentCatalog.Find(Slug);
    private Type? SpecimenType => Component is null ? null : PlaybookSpecimenRegistry.SpecimenTypeFor(Component);
    private Type? ResolvedRuntimeType => Component is null ? null : PlaybookSpecimenRegistry.RuntimeTypeFor(Component);
    private bool HasInteractiveSpecimen => SpecimenType is not null;
    private PlaybookComponentCoverageKind CoverageKind => Component is null ? PlaybookComponentCoverageKind.Reference : PlaybookComponentCoverage.KindFor(Component);
    private PlaybookCoverageDocumentation? CoverageDocumentation => Component is null ? null : PlaybookComponentCoverage.DocumentationFor(Component);
    private IDictionary<string, object> SpecimenParameters => new Dictionary<string, object> { ["Viewport"] = _viewport };

    private string PreviewTitle => CoverageKind switch
    {
        PlaybookComponentCoverageKind.Interactive => "Interactive contract",
        PlaybookComponentCoverageKind.Pattern => "Integration pattern",
        _ => "Reference contract"
    };

    private IEnumerable<PlaybookComponentDefinition> RelatedComponents => Component is null
        ? []
        : PlaybookComponentCatalog.All.Where(candidate => candidate.Category == Component.Category && candidate.Slug != Component.Slug).Take(6);

    private IEnumerable<PlaybookComponentDefinition> DocumentationRelatedComponents => CoverageDocumentation is null
        ? []
        : CoverageDocumentation.RelatedComponents
            .Select(name => PlaybookComponentCatalog.All.FirstOrDefault(component => component.Name == name))
            .Where(component => component is not null)
            .Cast<PlaybookComponentDefinition>();

    private string ViewportClass(string candidate) => candidate == _viewport ? "is-active" : string.Empty;
}
