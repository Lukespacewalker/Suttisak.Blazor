@page "/components/{Slug}"
@inject NavigationManager Navigation
@inject PlaybookState State
@inject IJSRuntime JsRuntime

<PageTitle>@(Component is null ? "Component not found" : $"{Component.Name} · UI Playbook")</PageTitle>

<PlaybookShell>
    <main class="component-detail">
        @if (Component is null)
        {
            <section class="component-detail__not-found">
                <span class="playbook-kicker">Component documentation</span>
                <h1>That component is not in the catalog.</h1>
                <p>The URL may be stale, or the component has not been registered with the Playbook metadata yet.</p>
                <a href="components">Return to Component Browser</a>
            </section>
        }
        else
        {
            <div class="component-detail__workspace">
                <aside class="component-detail__sidebar" aria-label="Component Browser">
                    <a class="component-detail__all-components" href="components">← All components</a>
                    <nav aria-label="Component groups">
                        @foreach (var group in ComponentGroups)
                        {
                            <details open="@(group.Key == Component.Category)">
                                <summary><span>@group.Key</span><small>@group.Count()</small></summary>
                                <div>
                                    @foreach (var candidate in group)
                                    {
                                        <a class="@ComponentLinkClass(candidate)" href="@candidate.DetailHref" aria-current="@(candidate.Slug == Component.Slug ? "page" : null)">@candidate.Name</a>
                                    }
                                </div>
                            </details>
                        }
                    </nav>
                </aside>

                <div class="component-detail__content">
                    <nav class="component-detail__breadcrumbs" aria-label="Breadcrumb">
                        <a href="components">Components</a><span aria-hidden="true">/</span><span>@Component.Category</span><span aria-hidden="true">/</span><strong>@Component.Name</strong>
                    </nav>

                    <header class="component-detail__hero">
                        <div>
                            <span class="playbook-kicker">@Component.Category</span>
                            <h1>@Component.Name</h1>
                            <p>@Component.Summary</p>
                        </div>
                        <div class="component-detail__meta">
                            <span class="component-detail__status component-detail__status--@Component.Status.ToString().ToLowerInvariant()">@Component.Status</span>
                            <span class="component-detail__coverage component-detail__coverage--@PlaybookComponentCoverage.SlugFor(Component)">@PlaybookComponentCoverage.LabelFor(Component)</span>
                            <span>@Component.SourceArea</span>
                            @if (CoverageKind == PlaybookComponentCoverageKind.Interactive)
                            {
                                <span>@SpecimenCoverageLabel</span>
                            }
                            else if (CoverageDocumentation?.IntegrationRoute is not null)
                            {
                                <a href="@CoverageDocumentation.IntegrationRoute">@CoverageDocumentation.IntegrationRouteLabel ↗</a>
                            }
                            else
                            {
                                <a href="catalog">Return to compact catalog →</a>
                            }
                        </div>
                    </header>

                    <section class="component-detail__section" aria-labelledby="preview-title">
                <header>
                    <div><span>01 / Coverage</span><h2 id="preview-title">@PreviewTitle</h2></div>
                    <p>@PlaybookComponentCoverage.DescriptionFor(Component)</p>
                    @if (HasInteractiveSpecimen)
                    {
                        <div class="component-detail__viewport" role="group" aria-label="Preview viewport">
                            <button type="button" class="@ViewportClass("mobile")" aria-pressed="@Pressed(ActiveViewport == "mobile")" @onclick='() => SetViewport("mobile")'>375</button>
                            <button type="button" class="@ViewportClass("tablet")" aria-pressed="@Pressed(ActiveViewport == "tablet")" @onclick='() => SetViewport("tablet")'>768</button>
                            <button type="button" class="@ViewportClass("desktop")" aria-pressed="@Pressed(ActiveViewport == "desktop")" @onclick='() => SetViewport("desktop")'>1280</button>
                            <button type="button" class="@ViewportClass("full")" aria-pressed="@Pressed(ActiveViewport == "full")" @onclick='() => SetViewport("full")'>Full</button>
                        </div>
                    }
                </header>

                @if (SpecimenType is not null)
                {
                    @if (ActiveViewport == "full")
                    {
                        <DynamicComponent Type="@SpecimenType" Parameters="@SpecimenParameters" />
                    }
                    else
                    {
                        <div class="component-detail__isolated-stage" data-testid="isolated-specimen-stage">
                            <iframe class="component-detail__isolated-frame component-detail__isolated-frame--@ActiveViewport"
                                    src="@IsolatedSpecimenHref"
                                    title="@($"{Component.Name} at {ViewportLabel}")"
                                    loading="eager"
                                    data-testid="isolated-specimen-frame"></iframe>
                        </div>
                    }
                }
                else
                {
                    @if (CoverageDocumentation is not null)
                    {
                        <div class="component-detail__documentation component-detail__documentation--@PlaybookComponentCoverage.SlugFor(Component)" data-testid="coverage-documentation">
                            <div class="component-detail__documentation-intro">
                                <span>@(CoverageKind == PlaybookComponentCoverageKind.Pattern ? "Pattern documentation" : "Reference documentation")</span>
                                <h3>@(CoverageKind == PlaybookComponentCoverageKind.Pattern ? "Pattern coverage" : "Reference coverage")</h3>
                                <p>@CoverageDocumentation.Rationale</p>
                                @if (CoverageDocumentation.IntegrationRoute is not null)
                                {
                                    <a href="@CoverageDocumentation.IntegrationRoute">@CoverageDocumentation.IntegrationRouteLabel →</a>
                                }
                            </div>

                            <div class="component-detail__documentation-grid">
                                <article>
                                    <strong>Composition responsibilities</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.CompositionResponsibilities) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Application-owned responsibilities</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.ApplicationResponsibilities) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Tests</strong>
                                    <ul>@foreach (var item in CoverageDocumentation.RegressionEvidence) { <li>@item</li> }</ul>
                                </article>
                                <article>
                                    <strong>Related components</strong>
                                    <ul>
                                        @foreach (var related in DocumentationRelatedComponents)
                                        {
                                            <li><a href="@related.DetailHref">@related.Name</a></li>
                                        }
                                    </ul>
                                </article>
                            </div>
                        </div>
                    }
                }
                    </section>

                    <section class="component-detail__section" aria-labelledby="usage-title">
                <header><div><span>03 / Use</span><h2 id="usage-title">@(HasCuratedUsage ? "Focused usage" : "Usage skeleton")</h2></div><p>@UsageGuidance</p></header>
                <div class="component-detail__usage">
                    <pre tabindex="0" aria-label="@($"{Component.Name} Razor usage")"><code>@UsageExample</code></pre>
                    <div>
                        @if (HasCuratedUsage)
                        {
                            <button type="button" @onclick="CopyUsageAsync">Copy Razor</button>
                        }
                        else
                        {
                            <a href="patterns">Find a complete composition recipe →</a>
                        }
                        <span role="status" aria-live="polite">@_copyStatus</span>
                    </div>
                </div>
                    </section>

                    <section class="component-detail__section" aria-labelledby="api-title">
                <header><div><span>04 / API</span><h2 id="api-title">Parameters</h2></div><p>The table is generated from the public parameters on the component type.</p></header>
                <ComponentParameterTable ComponentType="@ResolvedRuntimeType" />
                    </section>

                    <section class="component-detail__section" aria-labelledby="accessibility-title">
                <header><div><span>05 / Quality</span><h2 id="accessibility-title">Accessibility</h2></div><p>Check semantics, focus, keyboard behavior, constrained widths, and reduced motion.</p></header>
                <div class="component-detail__quality-grid">
                    <article><strong>Keyboard</strong><p>Interactive controls must remain reachable and usable without a pointing device.</p></article>
                    <article><strong>Focus</strong><p>Focus visibility is tokenized and must survive every product theme.</p></article>
                    <article><strong>Semantics</strong><p>Prefer native elements and preserve labels, roles, state, and relationships exposed to assistive technology.</p></article>
                    <article><strong>Responsive</strong><p>Verify constrained containers, long content, reduced motion, light mode, and dark mode.</p></article>
                </div>
                    </section>

                    @if (ComponentPatterns.Count > 0)
                    {
                        <section class="component-detail__section" aria-labelledby="patterns-title">
                            <header><div><span>06 / Patterns</span><h2 id="patterns-title">Used in patterns</h2></div><p>These patterns show the component alongside the other parts of the page.</p></header>
                            <div class="component-detail__patterns">
                                @foreach (var pattern in ComponentPatterns)
                                {
                                    <a href="@pattern.DetailHref">
                                        <span>@pattern.Category</span>
                                        <strong>@pattern.Name</strong>
                                        <p>@pattern.Summary</p>
                                        <small>View pattern →</small>
                                    </a>
                                }
                            </div>
                        </section>
                    }

                    <section class="component-detail__section" aria-labelledby="related-title">
                <header><div><span>07 / Related</span><h2 id="related-title">Related components</h2></div><p>Components from the same page patterns are listed first, followed by components in the same category.</p></header>
                <div class="component-detail__related">
                    @foreach (var related in RelatedComponents)
                    {
                        <a href="@related.DetailHref">
                            <strong>@related.Name</strong>
                            <span>@related.Summary</span>
                            <small>@PlaybookComponentCoverage.LabelFor(related)</small>
                        </a>
                    }
                </div>
                    </section>

                    <footer class="component-detail__footer">
                <span>Machine-readable ID</span><code>@Component.Slug</code>
                <span>Tags</span><p>@string.Join(" · ", Component.Tags)</p>
                <span>Source</span><p><a href="@SourceSearchHref" target="_blank" rel="noreferrer">Search repository source for @Component.Name ↗</a></p>
                    </footer>
                </div>
            </div>
        }
    </main>
</PlaybookShell>

@code {
    [Parameter] public string? Slug { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "viewport")] public string? Viewport { get; set; }
    private string _copyStatus = string.Empty;

    private PlaybookComponentDefinition? Component => PlaybookComponentCatalog.Find(Slug);
    private Type? SpecimenType => Component is null ? null : PlaybookSpecimenRegistry.SpecimenTypeFor(Component);
    private Type? ResolvedRuntimeType => Component is null ? null : PlaybookSpecimenRegistry.RuntimeTypeFor(Component);
    private bool HasInteractiveSpecimen => SpecimenType is not null;
    private int MappedComponentCount => SpecimenType is null
        ? 0
        : PlaybookSpecimenRegistry.All.Values.Count(registration => registration.SpecimenType == SpecimenType);
    private string SpecimenCoverageLabel => MappedComponentCount <= 1
        ? "Dedicated specimen"
        : $"Shared workbench · {MappedComponentCount} components";
    private PlaybookComponentCoverageKind CoverageKind => Component is null ? PlaybookComponentCoverageKind.Reference : PlaybookComponentCoverage.KindFor(Component);
    private PlaybookCoverageDocumentation? CoverageDocumentation => Component is null ? null : PlaybookComponentCoverage.DocumentationFor(Component);
    private IDictionary<string, object> SpecimenParameters => new Dictionary<string, object> { ["Viewport"] = "full" };

    private string ActiveViewport => Viewport is "mobile" or "tablet" or "desktop" ? Viewport : "full";
    private string ViewportLabel => ActiveViewport switch
    {
        "mobile" => "375 pixel viewport",
        "tablet" => "768 pixel viewport",
        "desktop" => "1280 pixel viewport",
        _ => "the full browser width"
    };

    private string IsolatedSpecimenHref => Component is null
        ? string.Empty
        : $"specimens/{Component.Slug}?theme={Uri.EscapeDataString(State.Theme)}&mode={Uri.EscapeDataString(State.Mode)}";

    private string UsageExample => Component is null ? string.Empty : PlaybookUsageExamples.For(Component);
    private bool HasCuratedUsage => Component is not null && PlaybookUsageExamples.HasCuratedExample(Component);
    private string UsageGuidance => HasCuratedUsage
        ? "This sample shows the component's basic Razor structure. Page-level examples are listed under Patterns."
        : "This skeleton omits required values. Check the API table or a related pattern before using it.";
    private string SourceSearchHref => Component is null
        ? string.Empty
        : $"https://github.com/Lukespacewalker/Suttisak.Blazor/search?q={Uri.EscapeDataString(Component.Name)}&type=code";

    private string PreviewTitle => CoverageKind switch
    {
        PlaybookComponentCoverageKind.Interactive => "Interactive specimen",
        PlaybookComponentCoverageKind.Pattern => "Pattern documentation",
        _ => "Reference notes"
    };

    private IReadOnlyList<PlaybookPatternDefinition> ComponentPatterns => Component is null
        ? []
        : PlaybookPatternCatalog.PatternsForComponent(Component.Name);

    private IEnumerable<PlaybookComponentDefinition> RelatedComponents
    {
        get
        {
            if (Component is null)
            {
                return [];
            }

            var composed = ComponentPatterns
                .SelectMany(pattern => pattern.Ingredients)
                .Where(ingredient => !ingredient.ComponentName.Equals(Component.Name, StringComparison.OrdinalIgnoreCase))
                .Select(ingredient => PlaybookComponentCatalog.All.FirstOrDefault(candidate =>
                    candidate.Name.Equals(ingredient.ComponentName, StringComparison.OrdinalIgnoreCase)))
                .Where(candidate => candidate is not null)
                .Cast<PlaybookComponentDefinition>()
                .DistinctBy(candidate => candidate.Name)
                .Take(6)
                .ToArray();

            return composed.Length > 0
                ? composed
                : PlaybookComponentCatalog.All
                    .Where(candidate => candidate.Category == Component.Category && candidate.Slug != Component.Slug)
                    .Take(6);
        }
    }

    private IEnumerable<PlaybookComponentDefinition> DocumentationRelatedComponents => CoverageDocumentation is null
        ? []
        : CoverageDocumentation.RelatedComponents
            .Select(name => PlaybookComponentCatalog.All.FirstOrDefault(component => component.Name == name))
            .Where(component => component is not null)
            .Cast<PlaybookComponentDefinition>();

    private IReadOnlyList<IGrouping<string, PlaybookComponentDefinition>> ComponentGroups =>
        PlaybookComponentCatalog.All.GroupBy(component => component.Category).ToArray();

    private string ComponentLinkClass(PlaybookComponentDefinition candidate) =>
        candidate.Slug == Component?.Slug ? "is-current" : string.Empty;

    private void SetViewport(string viewport)
    {
        Viewport = viewport == "full" ? null : viewport;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("viewport", Viewport), replace: true);
    }

    private async Task CopyUsageAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", UsageExample);
            _copyStatus = "Copied.";
        }
        catch (JSException)
        {
            _copyStatus = "Copy failed; select the code manually.";
        }
    }

    private string ViewportClass(string candidate) => candidate == ActiveViewport ? "is-active" : string.Empty;
    private static string Pressed(bool value) => value ? "true" : "false";
}
