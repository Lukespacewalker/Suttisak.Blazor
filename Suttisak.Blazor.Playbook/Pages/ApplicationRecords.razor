@page "/application-shell/records"
@inject DemoRecordStore Store

<PageTitle>Records · Application Shell V2</PageTitle>

<PlaybookShell>
    <div class="application-shell-workbench">
        <DemoApplicationShell>
            <PageHeader>
                <PageHeading Title="Program records"
                             SectionTitle="Operations"
                             SectionDescription="Program administration"
                             SectionIcon="@(new Icons.Regular.Size20.Briefcase())"
                             Description="Create, review, update, and remove records from one focused workspace."
                             Icon="@(new Icons.Regular.Size24.Table())">
                    <Breadcrumbs><AppBreadcrumb Items="@RecordBreadcrumbs" /></Breadcrumbs>
                    <PageActions>
                        <AppButton Variant="AppButtonVariant.Primary" OnClick="@(_ => CreateRecord())">
                            <IconStartContent><FluentIcon Value="@(new Icons.Regular.Size20.Add())" /></IconStartContent>
                            <ChildContent>New record</ChildContent>
                        </AppButton>
                    </PageActions>
                </PageHeading>
            </PageHeader>

            <ChildContent>
            <section class="demo-data-panel" aria-labelledby="record-table-title">
                <div class="demo-data-panel__heading"><div><span>LIVE DATA</span><h2 id="record-table-title">All records</h2></div></div>
                <AppDataGrid AriaLabel="Program records">
                    <Search>
                        <div class="demo-data-search" role="search">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Search())" aria-hidden="true" />
                            <input id="record-search"
                                   type="search"
                                   aria-label="Search records"
                                   placeholder="Search records…"
                                   autocomplete="off"
                                   @bind="_searchText"
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(_searchText))
                            {
                                <AppButton IconOnly="true" Variant="AppButtonVariant.Subtle" AriaLabel="Clear search" OnClick="@(_ => ClearSearch())">×</AppButton>
                            }
                        </div>
                    </Search>
                    <Filters>
                        <div class="demo-data-meta">
                            <small aria-live="polite">@RecordCountLabel</small>
                            <span>Select a column heading to sort</span>
                        </div>
                    </Filters>
                    <ChildContent>
                    <AppQuickGrid TGridItem="DemoRecord" Items="@FilteredRecords" Pagination="_pagination" AriaLabel="Program records" ItemKey="@(record => record.Id)">
                        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="DemoRecord" Title="Record" Sortable="true" SortBy="@SortByName">
                            <a class="demo-record-link" href="@($"application-shell/records/{context.Id}")"><strong>@context.Name</strong><small>#@context.Id</small></a>
                        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
                        <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn TGridItem="DemoRecord" TProp="string" Property="@(record => record.Program)" Title="Program" Sortable="true" />
                        <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn TGridItem="DemoRecord" TProp="string" Property="@(record => record.Owner)" Title="Owner" Sortable="true" />
                        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="DemoRecord" Title="Status" Sortable="true" SortBy="@SortByStatus"><span class="demo-status demo-status--@Slug(context.Status)">@context.Status</span></Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
                        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="DemoRecord" Title="Updated"
                                        Sortable="true"
                                        SortBy="@SortByUpdated"
                                        IsDefaultSortColumn="true"
                                        InitialSortDirection="Microsoft.AspNetCore.Components.QuickGrid.SortDirection.Descending">@context.UpdatedOn.ToString("dd MMM")</Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
                        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="DemoRecord" Title="Actions">
                            <div class="demo-row-actions">
                                <AppButton Variant="AppButtonVariant.Subtle" Size="AppButtonSize.Compact" IconOnly="true" AriaLabel="@($"Edit {context.Name}")" OnClick="@(_ => EditRecord(context))">
                                    <IconStartContent><FluentIcon Value="@(new Icons.Regular.Size20.Edit())" /></IconStartContent>
                                </AppButton>
                                <AppButton Variant="AppButtonVariant.Danger" Size="AppButtonSize.Compact" IconOnly="true" AriaLabel="@($"Delete {context.Name}")" OnClick="@(_ => DeleteRecord(context))">
                                    <IconStartContent><FluentIcon Value="@(new Icons.Regular.Size20.Delete())" /></IconStartContent>
                                </AppButton>
                            </div>
                        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
                    </AppQuickGrid>
                    </ChildContent>
                    <Pagination><AppQuickPaginator State="_pagination" /></Pagination>
                </AppDataGrid>
            </section>
            </ChildContent>
        </DemoApplicationShell>
    </div>

    <AppDrawer TInput="DemoRecordDraft" TResult="DemoRecordDraft" @ref="_recordDrawer"
               Title="Record editor" Description="Changes are returned to the page only after Save is selected."
               Position="AppDrawerPosition.End" Size="AppDrawerSize.Standard">
        <Body Context="drawer">
            <FormGrid Columns="1">
                <FormField><AppTextBox Label="Record name" @bind-Value="drawer.Value.Name" /></FormField>
                <FormField><AppTextBox Label="Program" @bind-Value="drawer.Value.Program" /></FormField>
                <FormField><AppTextBox Label="Owner" @bind-Value="drawer.Value.Owner" /></FormField>
                <FormField><AppSelect TValue="string" Label="Status" Options="@StatusOptions" @bind-Value="drawer.Value.Status" /></FormField>
            </FormGrid>
        </Body>
        <Footer Context="drawer">
            <AppButton OnClick="@(_ => drawer.CancelAsync())">Cancel</AppButton>
            <AppButton Variant="AppButtonVariant.Primary" Disabled="@(!CanSave(drawer.Value))" OnClick="@(_ => drawer.CloseAsync(drawer.Value))">Save record</AppButton>
        </Footer>
    </AppDrawer>

    <AppDialog TInput="DemoRecord" TResult="DemoRecord" @ref="_deleteDialog"
               Title="Delete this record?" Description="This action permanently removes the record from the playbook store."
               Dangerous="true">
        <Body Context="dialog"><p><strong>@dialog.Value.Name</strong> and its current status will be removed.</p></Body>
        <Footer Context="dialog">
            <AppButton OnClick="@(_ => dialog.CancelAsync())">Keep record</AppButton>
            <AppButton Variant="AppButtonVariant.Danger" OnClick="@(_ => dialog.CloseAsync(dialog.Value))">Delete record</AppButton>
        </Footer>
    </AppDialog>
</PlaybookShell>

@code {
    private AppDrawer<DemoRecordDraft, DemoRecordDraft>? _recordDrawer;
    private AppDialog<DemoRecord, DemoRecord>? _deleteDialog;
    private string _searchText = string.Empty;
    private readonly Microsoft.AspNetCore.Components.QuickGrid.PaginationState _pagination = new() { ItemsPerPage = 4 };

    private static readonly Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord> SortByName = Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord>.ByAscending(record => record.Name);
    private static readonly Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord> SortByStatus = Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord>.ByAscending(record => record.Status);
    private static readonly Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord> SortByUpdated = Microsoft.AspNetCore.Components.QuickGrid.GridSort<DemoRecord>.ByAscending(record => record.UpdatedOn);
    private static readonly AppSelectOption<string>[] StatusOptions =
    [
        new("Draft", "Draft"),
        new("Active", "Active"),
        new("In review", "In review"),
        new("Complete", "Complete")
    ];

    private readonly Breadcrumb[] RecordBreadcrumbs =
    [
        new(new Icons.Regular.Size16.Home(), "/application-shell", "Overview"),
        new(null, null, "Records")
    ];

    private static bool CanSave(DemoRecordDraft draft) => !string.IsNullOrWhiteSpace(draft.Name)
        && !string.IsNullOrWhiteSpace(draft.Program)
        && !string.IsNullOrWhiteSpace(draft.Owner);

    private IQueryable<DemoRecord> FilteredRecords => Store.Records
        .Where(MatchesSearch)
        .AsQueryable();

    private string RecordCountLabel => string.IsNullOrWhiteSpace(_searchText)
        ? $"{Store.Records.Count} records"
        : $"{FilteredRecords.Count()} of {Store.Records.Count} records";

    private async Task CreateRecord()
    {
        var result = await _recordDrawer!.ShowAsync(new DemoRecordDraft());
        if (result is { HasValue: true, Value: not null }) Store.Save(result.Value);
    }

    private async Task EditRecord(DemoRecord record)
    {
        var result = await _recordDrawer!.ShowAsync(new DemoRecordDraft
        {
            Id = record.Id,
            Name = record.Name,
            Program = record.Program,
            Owner = record.Owner,
            Status = record.Status
        });
        if (result is { HasValue: true, Value: not null }) Store.Save(result.Value);
    }

    private async Task DeleteRecord(DemoRecord record)
    {
        var result = await _deleteDialog!.ShowAsync(record);
        if (result is { HasValue: true, Value: not null }) Store.Delete(result.Value.Id);
    }

    private void ClearSearch() => _searchText = string.Empty;

    private bool MatchesSearch(DemoRecord record)
    {
        var query = _searchText.Trim();
        return query.Length == 0
            || record.Id.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Program.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Owner.Contains(query, StringComparison.OrdinalIgnoreCase)
            || record.Status.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private static string Slug(string value) => value.ToLowerInvariant().Replace(' ', '-');
}
