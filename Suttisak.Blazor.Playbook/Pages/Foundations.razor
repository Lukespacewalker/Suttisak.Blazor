@page "/foundations"
@page "/tokens"
@inject HttpClient Http

<PageTitle>Design tokens · Suttisak.Blazor UI Playbook</PageTitle>

<PlaybookShell>
    <main class="foundations-page">
        <header class="foundations-page__hero">
            <div>
                <span class="playbook-kicker">Token reference</span>
                <h1>Design tokens</h1>
                <p>The JSON manifest and public CSS define the same semantic token names. Product themes replace values without changing those names.</p>
                <div class="foundations-page__hero-actions">
                    <a href="_content/Suttisak.Blazor.UserInterface/design-tokens.json">View JSON manifest ↗</a>
                    <a href="components">View components →</a>
                </div>
            </div>

            @if (_manifest is not null)
            {
                <aside class="foundations-page__summary" aria-label="Design token summary">
                    <article><strong>@_manifest.TokenCount</strong><span>public tokens</span></article>
                    <article><strong>@_manifest.Categories.Count</strong><span>semantic groups</span></article>
                    <article><strong>1</strong><span>packaged contract</span></article>
                </aside>
            }
        </header>

        @if (_loadError is not null)
        {
            <section class="foundations-page__state" role="alert">
                <strong>The design-token manifest could not be loaded.</strong>
                <p>@_loadError</p>
                <button type="button" @onclick="LoadManifestAsync">Retry</button>
            </section>
        }
        else if (_manifest is null)
        {
            <section class="foundations-page__state" aria-live="polite">
                <strong>Loading design tokens…</strong>
            </section>
        }
        else
        {
            <nav class="foundations-page__category-nav" aria-label="Design token categories">
                @foreach (var category in _manifest.Categories)
                {
                    <a href="@($"tokens#{CategoryId(category)}")"><span>@category.Label</span><small>@category.Tokens.Count</small></a>
                }
            </nav>

            @foreach (var category in _manifest.Categories)
            {
                <section id="@CategoryId(category)" class="foundations-page__section" aria-labelledby="@($"{CategoryId(category)}-title")">
                    <header>
                        <span>@category.Id</span>
                        <div>
                            <h2 id="@($"{CategoryId(category)}-title")">@category.Label</h2>
                            <p>@category.Description</p>
                        </div>
                        <strong>@category.Tokens.Count</strong>
                    </header>

                    <div class="foundations-page__token-grid">
                        @foreach (var token in category.Tokens)
                        {
                            <article class="foundations-page__token" data-design-token="@token.Name" data-token-kind="@token.Kind">
                                <div class="foundations-page__preview foundations-page__preview--@token.Kind" style="@PreviewStyle(token)" aria-hidden="true">
                                    <span>@PreviewText(token.Kind)</span>
                                </div>
                                <div class="foundations-page__token-copy">
                                    <strong>@token.Label</strong>
                                    <code>@token.Name</code>
                                    <small>@token.DefaultValue</small>
                                    <p>@token.Description</p>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="foundations-page__section foundations-page__guardrails" aria-labelledby="guardrails-title">
                <header>
                    <span>rules</span>
                    <div>
                        <h2 id="guardrails-title">Token usage</h2>
                        <p>Applications set brand values. Shared components use semantic token names.</p>
                    </div>
                    <strong>4</strong>
                </header>
                <div>
                    <article><strong>Use semantic roles</strong><p>Choose the token by purpose rather than by its current color.</p></article>
                    <article><strong>Define both modes</strong><p>Set light and dark values and check their contrast.</p></article>
                    <article><strong>Keep focus visible</strong><p>Keyboard focus must remain visible in product themes and forced-colors mode.</p></article>
                    <article><strong>Keep product colors outside the library</strong><p>Shared components must not define product colors or local token aliases.</p></article>
                </div>
            </section>
        }
    </main>
</PlaybookShell>

@code {
    private const string ManifestPath = "_content/Suttisak.Blazor.UserInterface/design-tokens.json";

    private PlaybookDesignTokenManifest? _manifest;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadManifestAsync();

    private async Task LoadManifestAsync()
    {
        _manifest = null;
        _loadError = null;

        try
        {
            _manifest = await Http.GetFromJsonAsync<PlaybookDesignTokenManifest>(ManifestPath);
            if (_manifest is null)
            {
                _loadError = "The manifest response was empty.";
            }
        }
        catch (Exception exception)
        {
            _loadError = exception.Message;
        }
    }

    private static string CategoryId(PlaybookDesignTokenCategory category) => $"tokens-{category.Id}";

    private static string PreviewStyle(PlaybookDesignToken token) => $"--token-value:var({token.Name});";

    private static string PreviewText(string kind) => kind switch
    {
        "font" => "Aa กข",
        "type" => "Aa",
        "duration" => "→",
        "layout" => "↔",
        _ => string.Empty
    };
}
