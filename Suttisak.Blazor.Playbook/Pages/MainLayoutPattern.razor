@page "/layout-patterns/application"
@layout MainLayout

<PageTitle>MainLayout pattern · UI Playbook</PageTitle>

<SectionContent SectionId="@MainLayout.HeaderSection">Application layout pattern</SectionContent>
<SectionContent SectionId="@MainLayout.NavigationSection">
    <Nav Embedded="true">
        <NavGroup Label="Layout contracts">
            <NavItem Href="layout-patterns/application" Match="NavLinkMatch.All" IconRestName="Home">Application</NavItem>
            <NavItem Href="layout-patterns/landing" IconRestName="AppsList">Landing</NavItem>
            <NavItem Href="layout-patterns/identity" IconRestName="Key">Identity</NavItem>
        </NavGroup>
    </Nav>
</SectionContent>
<SectionContent SectionId="@MainLayout.NavigationFooterSection">
    <small>MainLayout section outlet</small>
</SectionContent>
<SectionContent SectionName="@CommonSections.PageHeading">
    <PageHeading Title="Application layout contract"
                 Description="Breadcrumb state, named sections, responsive shell, and routed body execute together." />
</SectionContent>

<PageBreadcrumbs Items="@Breadcrumbs" />

<section class="layout-contract-page" aria-labelledby="main-layout-pattern-title" data-testid="main-layout-pattern">
    <div class="layout-contract-page__intro">
        <span>Router-level application layout</span>
        <h1 id="main-layout-pattern-title">MainLayout page structure</h1>
        <p>ApplicationShell supplies the main landmark. The page supplies sections, breadcrumbs, heading content, and the routed body.</p>
    </div>
    <div class="layout-contract-page__grid">
        <article><strong>Named sections</strong><p>Header, navigation, navigation footer, messages, and page heading use separate section outlets.</p></article>
        <article><strong>Breadcrumb cascade</strong><p>PageBreadcrumbs populates MainLayout and clears when navigation changes.</p></article>
        <article><strong>Responsive shell</strong><p>ApplicationShell provides desktop collapse and the mobile navigation overlay. Hosts can opt into two header icon popovers with BlazorUIOptions.CompactHeaderPreferences; mobile pickers remain in the drawer.</p></article>
    </div>
    <a class="layout-contract-page__back" href="components/main-layout">Return to MainLayout documentation</a>
    @if (LongContent)
    {
        <section aria-label="Long routed content">
            @foreach (var index in Enumerable.Range(1, 40))
            {
                <p>Record @index. This routed content demonstrates natural document scrolling while the shell keeps its navigation and header accessible.</p>
            }
            <p data-testid="layout-long-content-end">End of the long content example.</p>
        </section>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "longContent")] public bool LongContent { get; set; }
    private static readonly Breadcrumb[] Breadcrumbs =
    [
        new("Home", "/layout-patterns/application", "Layouts"),
        new(null, null, "Application")
    ];
}
