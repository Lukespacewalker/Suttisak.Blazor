@page "/Culture/Set"
@using System.Globalization
@inject NavigationManager Navigation
@inject IJSRuntime JS

@code {
    [SupplyParameterFromQuery(Name = "culture")]
    public string? CultureName { get; set; }

    [SupplyParameterFromQuery(Name = "redirectUri")]
    public string? RedirectUri { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cultureName = CultureName == "auto"
                ? await JS.InvokeAsync<string>("blazorCulture.get", "en-US")
                : CultureName;
            var culture = CultureInfo.GetCultureInfo(cultureName ?? string.Empty);
            CultureInfo.DefaultThreadCurrentCulture = culture;
            CultureInfo.DefaultThreadCurrentUICulture = culture;
        }
        catch (CultureNotFoundException)
        {
        }

        var destination = !string.IsNullOrWhiteSpace(RedirectUri)
            && RedirectUri.StartsWith("/", StringComparison.Ordinal)
            && !RedirectUri.StartsWith("//", StringComparison.Ordinal)
                ? RedirectUri
                : "/";
        Navigation.NavigateTo(destination);
    }
}
