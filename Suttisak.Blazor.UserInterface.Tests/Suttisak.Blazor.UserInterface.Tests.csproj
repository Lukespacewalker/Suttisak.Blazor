<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Suttisak.Blazor.UserInterface\Suttisak.Blazor.UserInterface.csproj" />
    <ProjectReference Include="..\Suttisak.Blazor.Identity\Suttisak.Blazor.Identity.csproj" />
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Suttisak.Blazor.UserInterface\wwwroot\design-tokens.json"
          Link="DesignTokenFixtures\design-tokens.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Suttisak.Blazor.UserInterface\wwwroot\css\color.css"
          Link="DesignTokenFixtures\color.css"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Suttisak.Blazor.UserInterface\wwwroot\css\application.css"
          Link="DesignTokenFixtures\application.css"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Suttisak.Blazor.UserInterface\wwwroot\css\main.css"
          Link="DesignTokenFixtures\main.css"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
