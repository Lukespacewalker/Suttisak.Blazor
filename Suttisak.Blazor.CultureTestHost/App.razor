@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Suttisak.Blazor.CultureTestHost.Client
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@(HttpContext.Request.PathBase + "/")" />
    <ImportMap />
    <link rel="stylesheet" href="_content/Suttisak.Blazor.UserInterface/css/main.css" />
    <link rel="stylesheet" href="Suttisak.Blazor.CultureTestHost.styles.css" />
</head>
<body>
    <Routes @rendermode="Mode" />
    <script src="_content/Suttisak.Blazor.UserInterface/js/blazor-utilities.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? Mode => HttpContext.Request.Path.Value switch
    {
        { } path when path.StartsWith("/probe/server/") => RenderMode.InteractiveServer,
        { } path when path.StartsWith("/probe/wasm/") => RenderMode.InteractiveWebAssembly,
        _ => null
    };
}
