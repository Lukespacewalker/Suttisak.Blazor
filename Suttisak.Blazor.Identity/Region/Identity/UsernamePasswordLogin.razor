@using Microsoft.AspNetCore.Components.Forms


<EditForm Model="UsernamePasswordInput" method="post" OnValidSubmit="@OnValidSubmit" FormName="@FormName">
	<DataAnnotationsValidator />
	<FluentValidationSummary class="text-danger" role="alert" />
	<FluentStack Orientation="Orientation.Vertical">
		<FluentTextField Name="Input.Username" @bind-Value="UsernamePasswordInput.Username" AutoComplete="username" Required="true" Placeholder="@UserNamePlaceholder" Label="@UsernamePasswordLogin_razor.Username" Style="width: 100%" />
		<FluentValidationMessage For="() => UsernamePasswordInput.Username" class="text-danger" />
		<FluentTextField type="password" Name="Input.Password" @bind-Value="UsernamePasswordInput.Password" Required="true" AutoComplete="current-password" Placeholder="@PasswordPlaceholder" Label="@UsernamePasswordLogin_razor.Password" Style="width: 100%" />
		<FluentValidationMessage For="() => UsernamePasswordInput.Password" class="text-danger" />
		<FluentCheckbox Name="Input.RememberMe" @bind-Value="UsernamePasswordInput.RememberMe" Label="@UsernamePasswordLogin_razor.RememberMe" />
		<FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" IconStart="@(new Icons.Filled.Size20.Key())"
		              Style="width: 100%">
			@UsernamePasswordLogin_razor.Login
		</FluentButton>
	</FluentStack>
	@ChildContent
</EditForm>


@code {
	[Parameter,EditorRequired] public required string FormName { get; set; }

	[Parameter, EditorRequired]
	public required UsernamePasswordInputModel UsernamePasswordInput { get; set; }

	[Parameter]
	public string? UserNamePlaceholder { get; set; }

	[Parameter]
	public string? PasswordPlaceholder { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public EventCallback<EditContext> OnValidSubmit { get; set; }
}
