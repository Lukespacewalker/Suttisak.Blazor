@using Microsoft.AspNetCore.Components.Forms


<EditForm Model="UsernamePasswordInput" method="post" OnValidSubmit="@OnValidSubmit" FormName="@FormName">
	<DataAnnotationsValidator />
	<FormValidationSummary class="text-danger" role="alert" />
	<AppStack Direction="Vertical">
        <AppTextBox Name="LoginWithUsernamePasswordInput.Username" @bind-Value="UsernamePasswordInput.Username" AutoComplete="username" Required="true" Placeholder="@UserNamePlaceholder" Label="@UsernamePasswordLogin_razor.Username" />
		<AppTextBox Type="password" Name="LoginWithUsernamePasswordInput.Password" @bind-Value="UsernamePasswordInput.Password" Required="true" AutoComplete="current-password" Placeholder="@PasswordPlaceholder" Label="@UsernamePasswordLogin_razor.Password"/>
		<AppCheckbox Name="LoginWithUsernamePasswordInput.RememberMe" @bind-Value="UsernamePasswordInput.RememberMe" Label="@UsernamePasswordLogin_razor.RememberMe" />
		<AppButton Type="submit" Variant="AppButtonVariant.Primary" IconStartName="Key" IconStartSize="20"
		              Style="width: 100%">
			@UsernamePasswordLogin_razor.Login
		</AppButton>
	</AppStack>
	@ChildContent
</EditForm>


@code {
	[Parameter,EditorRequired] public required string FormName { get; set; }

	[Parameter, EditorRequired]
	public required UsernamePasswordInputModel UsernamePasswordInput { get; set; }

	[Parameter]
	public string? UserNamePlaceholder { get; set; }

	[Parameter]
	public string? PasswordPlaceholder { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public EventCallback<EditContext> OnValidSubmit { get; set; }
}
