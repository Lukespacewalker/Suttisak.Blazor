@using Microsoft.AspNetCore.Components.Forms


<section>
    <h1>@Login_razor.Login</h1>
    <FluentCard>
        <StatusMessage Message="@StatusMessage" />
        <EditForm EditContext="EditContext" method="post" OnValidSubmit="@OnValidSubmit" FormName="login">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            <FluentStack Orientation="Orientation.Vertical">
                <FluentTextField Name="Input.Username" @bind-Value="Input.Username" AutoComplete="username" Required="true" Placeholder="@UserNamePlaceholder" Label="@Login_razor.Username" Style="width: 100%" />
                <FluentValidationMessage For="() => Input.Username" class="text-danger" />
                <FluentTextField type="password" Name="Input.Password" @bind-Value="Input.Password" AutoComplete="current-password" Required="true" Placeholder="@PasswordPlaceholder" Label="@Login_razor.Password" Style="width: 100%" />
                <FluentValidationMessage For="() => Input.Password" class="text-danger" />
                <FluentCheckbox Name="Input.RememberMe" @bind-Value="Input.RememberMe" Label="@Login_razor.RememberMe" />
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" IconStart="@(new Icons.Filled.Size20.Key())"
                              Style="width: 100%">
	                @Login_razor.Login
                </FluentButton>
                <hr />
                @PasskeySubmitFragment
            </FluentStack>
        </EditForm>
    </FluentCard>
</section>

@code {
	[Parameter]
	public string? StatusMessage { get; set; }

	[Parameter]
    public required InputModel Input { get; set; }

    [Parameter]
	public string? UserNamePlaceholder { get; set; }

    [Parameter]
	public string? PasswordPlaceholder { get; set; }

	[Parameter]
	public required EditContext EditContext { get; set; }

    [Parameter]
	public RenderFragment? ChildContent { get; set; }

    [Parameter]
	public RenderFragment? PasskeySubmitFragment { get; set; }

    [Parameter]
	public EventCallback<EditContext> OnValidSubmit { get; set; }
}
