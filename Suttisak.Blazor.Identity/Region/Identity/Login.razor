@using Microsoft.AspNetCore.Components.Forms

<section>
	<h1 style="align-self:center">@Login_razor.Login</h1>
	<StatusMessage Message="@StatusMessage" />
	<EditForm EditContext="EditContext" method="post" OnSubmit="@OnSubmit" FormName="login">
		<DataAnnotationsValidator />
		<FluentValidationSummary class="text-danger" role="alert" />
		<FluentStack Orientation="Orientation.Vertical">
			<FluentTextField Name="Input.Username" @bind-Value="Input.Username" AutoComplete="username" Placeholder="@UserNamePlaceholder" Label="@Login_razor.Username" Style="width: 100%" />
			<FluentValidationMessage For="() => Input.Username" class="text-danger" />
			<FluentTextField type="password" Name="Input.Password" @bind-Value="Input.Password" AutoComplete="current-password" Placeholder="@PasswordPlaceholder" Label="@Login_razor.Password" Style="width: 100%" />
			<FluentValidationMessage For="() => Input.Password" class="text-danger" />
			<FluentCheckbox Name="Input.RememberMe" @bind-Value="Input.RememberMe" Label="@Login_razor.RememberMe" />
			<FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" IconStart="@(new Icons.Filled.Size20.Key())"
						  Style="width: 100%">
				@Login_razor.Login
			</FluentButton>
		</FluentStack>
		@if (PasskeySubmitFragment is not null || ExternalLoginPickerFragment is not null)
		{
			<FluentDivider Style="width: 100%;border-color: var(--accent-fill-rest); margin: calc(var(--design-unit) * 2px) 0;" />
			<div style="align-self:center">
				@Login_razor.Alternative
			</div>
			@PasskeySubmitFragment
		}
	</EditForm>
	@if (ExternalLoginPickerFragment is not null)
	{
		<div style="display:flex; gap: calc(var(--design-unit) * 2px); margin: calc(var(--design-unit) * 2px) 0;">
			@ExternalLoginPickerFragment
		</div>
	}
</section>

@code {
	[Parameter]
	public string? StatusMessage { get; set; }

	[Parameter]
	public required InputModel Input { get; set; }

	[Parameter]
	public string? UserNamePlaceholder { get; set; }

	[Parameter]
	public string? PasswordPlaceholder { get; set; }

	[Parameter]
	public required EditContext EditContext { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public RenderFragment? PasskeySubmitFragment { get; set; }

	[Parameter]
	public RenderFragment? ExternalLoginPickerFragment { get; set; }

	[Parameter]
	public EventCallback<EditContext> OnSubmit { get; set; }
}
