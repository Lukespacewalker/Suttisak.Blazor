@typeparam TUser where TUser : class

@using System.ComponentModel.DataAnnotations
@using System.Text

@inject IdentityRedirectManager RedirectManager
@inject UserManager<TUser> UserManager

<PageTitle>@ResetPassword_razor.PageTitle</PageTitle>

<IdentityFlowPanel Title="@ResetPassword_razor.Header" Description="@ResetPassword_razor.ResetPasswordMessage">
@if (HasRecoveryCode)
{
    <FormGrid Columns="1">
        <div>
            <StatusMessage Message="@Message" />
            <EditForm Model="Input" FormName="@ResetFormName" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <FormValidationSummary class="text-danger" role="alert" />

                <input type="hidden" name="Input.Code" value="@Input!.Code" />
                <AppTextBox Name="Input.Email" @bind-Value="Input!.Email" AutoComplete="username" Required="true" Placeholder="@ResetPassword_razor.EmailPlaceholder" Label="@ResetPassword_razor.EmailLabel" Style="width: 100%;" />
                <AppTextBox type="password" Name="Input.Password" @bind-Value="Input!.Password" AutoComplete="new-password" Required="true" Placeholder="@ResetPassword_razor.PasswordPlaceholder" Label="@ResetPassword_razor.PasswordLabel" Style="width: 100%;" />
                <AppTextBox type="password" Name="Input.ConfirmPassword" @bind-Value="Input!.ConfirmPassword" AutoComplete="new-password" Required="true" Placeholder="@ResetPassword_razor.ConfirmPasswordPlaceholder" Label="@ResetPassword_razor.ConfirmPasswordLabel" Style="width: 100%;" />
                <AppButton Type="submit" Variant="AppButtonVariant.Primary" Style="width: 100%;">@ResetPassword_razor.ButtonText</AppButton>
            </EditForm>
        </div>
    </FormGrid>
}
else if (IsPost)
{
    <form @formname="@ResetFormName" @onsubmit="RedirectToInvalidReset" method="post" hidden>
        <AntiforgeryToken />
    </form>
}
</IdentityFlowPanel>

@code {
    private const string ResetFormName = "reset-password";
    private IEnumerable<IdentityError>? _identityErrors;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsPost => HttpContext is not null && HttpMethods.IsPost(HttpContext.Request.Method);
    private bool HasRecoveryCode => !string.IsNullOrEmpty(Input?.Code);

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? Message => _identityErrors is null ? null : string.Format(ResetPassword_razor.ErrorMessage, string.Join(", ", _identityErrors.Select(error => error.Description)));

    protected override void OnInitialized()
    {
        Input ??= new();

        // Reset the bound value before validating the code from the recovery link.
        Input.Code = string.Empty;
        if (!string.IsNullOrWhiteSpace(Code))
        {
            try
            {
                Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            }
            catch (FormatException)
            {
                // Handle malformed codes through the same recovery path as a missing code.
            }
        }

        if (!HasRecoveryCode && !IsPost)
        {
            RedirectToInvalidReset();
        }
    }

    private void RedirectToInvalidReset() => RedirectManager.RedirectTo("Account/InvalidPasswordReset");

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input!.Email);
        if (user is null)
        {
            // Don't reveal that the user does not exist
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        _identityErrors = result.Errors;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessageResourceType = typeof(ResetPassword_razor), ErrorMessageResourceName = nameof(ResetPassword_razor.ValidationMessage), MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessageResourceType = typeof(ResetPassword_razor), ErrorMessageResourceName = nameof(ResetPassword_razor.CompareMessage))]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}
