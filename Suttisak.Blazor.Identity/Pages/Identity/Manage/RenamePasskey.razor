@typeparam TUser where TUser : class

@using System.Buffers.Text

@inject UserManager<TUser> UserManager
@inject IdentityRedirectManager<TUser> RedirectManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text


<PageTitle>@Manage_razor.RenamePasskey</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
<PageHeading Title="@Manage_razor.RenamePasskey">
        <Breadcrumbs><AppBreadcrumb Items="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(Passkeys<TUser>.StaticPageIcon, Passkeys<TUser>.StaticPageUrl, Manage_razor.Passkeys), new Breadcrumb(StaticPageIcon, null, Manage_razor.RenamePasskey) })" /></Breadcrumbs>
    </PageHeading>
</SectionContent>
<IdentityManageShell Title="@Manage_razor.RenamePasskey" Description="@Text["PasskeysDescription"]" ActiveUrl="@IdentityRoutes.Account.Manage.Passkeys" Icon="@StaticPageIcon">

<EditForm Model="Input" OnValidSubmit="Rename" method="post">
    <DataAnnotationsValidator />
    @if (_passkey?.Name is { } name)
    {
        <h4>@string.Format(RenamePasskey_razor.EnterNewName, name)</h4>
    }
    else
    {
        <h4>@RenamePasskey_razor.EnterName</h4>
    }
    <ValidationSummary class="text-danger" role="alert" />
    <FluentTextInput Label="@RenamePasskey_razor.PasskeyNameLabel" @bind-Value="Input!.Name" Name="Input.Name" aria-required="true" Placeholder="@RenamePasskey_razor.PasskeyNamePlaceholder" />
    <ValidationMessage For="() => Input!.Name" class="text-danger" />
    <AppButton Type="ButtonType.Submit">@RenamePasskey_razor.ContinueButton</AppButton>
</EditForm>

</IdentityManageShell>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.Edit();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.RenamePasskeyTemplate;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.RenamePasskey);

    private TUser? _user;
    private UserPasskeyInfo? _passkey;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [Parameter]
    public string? CredentialId { get; set; }

    [SupplyParameterFromForm]
    protected virtual InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = (await UserManager.GetUserAsync(HttpContext.User))!;
        if (_user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(CredentialId);
        }
        catch (FormatException)
        {
            RedirectManager.RedirectToWithStatus(IdentityRoutes.Account.Manage.Passkeys, RenamePasskey_razor.ErrorInvalidFormat, HttpContext);
            return;
        }

        _passkey = await UserManager.GetPasskeyAsync(_user, credentialId);
        if (_passkey is null)
        {
            RedirectManager.RedirectToWithStatus(IdentityRoutes.Account.Manage.Passkeys, RenamePasskey_razor.ErrorNotFound, HttpContext);
            return;
        }
    }

    protected virtual async Task Rename()
    {
        _passkey!.Name = Input!.Name;
        var result = await UserManager.AddOrUpdatePasskeyAsync(_user!, _passkey);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToWithStatus(IdentityRoutes.Account.Manage.Passkeys, RenamePasskey_razor.ErrorUpdateFailed, HttpContext);
            return;
        }

        RedirectManager.RedirectToWithStatus(IdentityRoutes.Account.Manage.Passkeys, RenamePasskey_razor.SuccessUpdate, HttpContext);
    }

    protected class InputModel
    {
        [Required]
        [StringLength(200, ErrorMessageResourceType = typeof(RenamePasskey_razor), ErrorMessageResourceName = nameof(RenamePasskey_razor.ErrorNameLength))]
        public string Name { get; set; } = "";
    }
}
