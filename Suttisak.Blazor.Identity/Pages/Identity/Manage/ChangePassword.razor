@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword<TUser>> Logger
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text

<PageTitle>@Manage_razor.ChangePassword</PageTitle>


<SectionContent SectionName="@CommonSections.PageTitle">
<PageHeading Title="@Manage_razor.ChangePassword">
        <Breadcrumbs><AppBreadcrumb Items="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(StaticPageIcon, null, Manage_razor.ChangePassword) })" /></Breadcrumbs>
    </PageHeading>
</SectionContent>

<IdentityManageShell Title="@Manage_razor.ChangePassword" Description="@Text["PasswordDescription"]" ActiveUrl="@StaticPageUrl" Icon="@StaticPageIcon">
<StatusMessage Message="@_message" />
<FormGrid Columns="1">
    <div>
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            <FluentTextInput type="password" Name="Input.OldPassword" @bind-Value="Input!.OldPassword" class="form-control" AutoComplete="current-password" Required="true" Placeholder="@ChangePassword_razor.OldPasswordPlaceholder" Label="@ChangePassword_razor.OldPasswordLabel" Style="width: 100%" />
            @*<FluentValidationMessage For="() => Input.OldPassword" class="text-danger" />*@
            @* TODO: restore FluentValidationMessage later in RC3 *@
            <FluentTextInput type="password" Name="Input.NewPassword" @bind-Value="Input!.NewPassword" class="form-control" AutoComplete="new-password" Required="true" Placeholder="@ChangePassword_razor.NewPasswordPlaceholder" Label="@ChangePassword_razor.NewPasswordLabel" Style="width: 100%" />
            @*<FluentValidationMessage For="() => Input.NewPassword" class="text-danger" />*@
            @* TODO: restore FluentValidationMessage later in RC3 *@
            <FluentTextInput type="password" Name="Input.ConfirmPassword" @bind-Value="Input!.ConfirmPassword" class="form-control" AutoComplete="new-password" Required="true" Placeholder="@ChangePassword_razor.ConfirmPasswordPlaceholder" Label="@ChangePassword_razor.ConfirmPasswordLabel" Style="width: 100%" />
            @*<FluentValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />*@
            @* TODO: restore FluentValidationMessage later in RC3 *@
            <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width: 100%;">@ChangePassword_razor.UpdatePasswordButton</AppButton>
        </EditForm>
    </div>
</FormGrid>
</IdentityManageShell>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.Password();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.ChangePassword;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.ChangePassword);

    private string? _message;
    private TUser _user = null!;
    private bool _hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    protected virtual InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _hasPassword = await UserManager.HasPasswordAsync(_user);
        if (!_hasPassword)
        {
            RedirectManager.RedirectTo(IdentityRoutes.Account.Manage.SetPassword);
        }
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(_user, Input!.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            _message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(_user);
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus(ChangePassword_razor.PasswordChangedMessage, HttpContext);
    }

    protected class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = nameof(ChangePassword_razor.OldPasswordLabel), ResourceType = typeof(ChangePassword_razor))]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessageResourceName = nameof(ChangePassword_razor.PasswordLengthError), ErrorMessageResourceType = typeof(ChangePassword_razor), MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = nameof(ChangePassword_razor.NewPasswordLabel), ResourceType = typeof(ChangePassword_razor))]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = nameof(ChangePassword_razor.ConfirmPasswordLabel), ResourceType = typeof(ChangePassword_razor))]
        [Compare(nameof(NewPassword), ErrorMessageResourceName = nameof(ChangePassword_razor.PasswordMismatchError), ErrorMessageResourceType = typeof(ChangePassword_razor))]
        public string ConfirmPassword { get; set; } = "";
    }
}
