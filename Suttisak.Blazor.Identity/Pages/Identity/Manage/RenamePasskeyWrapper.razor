@typeparam TUser where TUser : class

@inject AppOverlayService DialogService
@inject NavigationManager NavigationManager

<AppButton OnClick="() => EditPasskeyName(Passkey)"
              Title="@Passkeys_razor.RenameTitle" 
              IconStartName="Edit" IconStartSize="20">@Passkeys_razor.RenameButton</AppButton>

@code {
    [Parameter]
    public UserPasskeyInfo Passkey { get; set; } = null!;

    private async Task EditPasskeyName(UserPasskeyInfo passkey)
    {
        var result = await DialogService.ShowDialogAsync<RenamePasskeyDialog<TUser>, bool>(
            new AppOverlayOptions { Title = Manage_razor.RenamePasskey },
            AppOverlayParameters.Create((nameof(RenamePasskeyDialog<TUser>.Passkey), passkey)));

        if (result is { HasValue: true, Value: true })
        {
            NavigationManager.NavigateTo(IdentityRoutes.Account.Manage.Passkeys);
        }
    }
}
