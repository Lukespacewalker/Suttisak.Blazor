@typeparam TUser where TUser : class

@using Microsoft.AspNetCore.Http.Features

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text

<PageTitle>@Manage_razor.TwoFactorAuthentication</PageTitle>


<IdentityManageShell Title="@Manage_razor.TwoFactorAuthentication" Description="@Text["TwoFactorDescription"]" ActiveUrl="@StaticPageUrl" Icon="@StaticPageIcon"
                     BreadcrumbItems="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(StaticPageIcon, null, Manage_razor.TwoFactorAuthentication) })">
<StatusMessage />
@if (_canTrack)
{
    if (_is2FaEnabled)
    {
        if (_recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>@TwoFactorAuthentication_razor.NoRecoveryCodesLeft</strong>
                <p>@((MarkupString)string.Format(TwoFactorAuthentication_razor.GenerateNewCodesMessage, IdentityRoutes.Account.Manage.GenerateRecoveryCodes))</p>
            </div>
        }
        else if (_recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>@TwoFactorAuthentication_razor.OneRecoveryCodeLeft</strong>
                <p>@((MarkupString)string.Format(TwoFactorAuthentication_razor.CanGenerateNewCodesMessage, IdentityRoutes.Account.Manage.GenerateRecoveryCodes))</p>
            </div>
        }
        else if (_recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>@string.Format(TwoFactorAuthentication_razor.RecoveryCodesLeft, _recoveryCodesLeft)</strong>
                <p>@((MarkupString)string.Format(TwoFactorAuthentication_razor.ShouldGenerateNewCodesMessage, IdentityRoutes.Account.Manage.GenerateRecoveryCodes))</p>
            </div>
        }

        <IdentitySettingCard Title="@Manage_razor.TwoFactorAuthentication"
                             Description="@Text["TwoFactorDescription"]"
                             Icon="@(new Icons.Regular.Size20.KeyMultiple())">
            <Badge><IdentityStatusBadge Tone="success">@Text["Enabled"]</IdentityStatusBadge></Badge>
            <Actions>
                <a class="identity-card-action" href="@IdentityRoutes.Account.Manage.GenerateRecoveryCodes">@TwoFactorAuthentication_razor.ResetRecoveryCodes</a>
                <a class="identity-card-action identity-card-action--danger" href="@IdentityRoutes.Account.Manage.DisableTwoFactorAuthentication">@TwoFactorAuthentication_razor.Disable2FA</a>
            </Actions>
        </IdentitySettingCard>

        @if (_isMachineRemembered)
        {
            <IdentitySettingCard Title="@TwoFactorAuthentication_razor.ForgetBrowserButton" Icon="@(new Icons.Regular.Size20.Desktop())">
                <Badge><IdentityStatusBadge Tone="success">@Text["Enabled"]</IdentityStatusBadge></Badge>
                <Actions>
                    <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                        <AntiforgeryToken />
                        <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Outline">@TwoFactorAuthentication_razor.ForgetBrowserButton</AppButton>
                    </form>
                </Actions>
            </IdentitySettingCard>
        }
    }

    <IdentitySettingCard Title="@TwoFactorAuthentication_razor.AuthenticatorAppHeader"
                         Description="@Text["TwoFactorDescription"]"
                         Icon="@(new Icons.Regular.Size20.Phone())">
        <Badge><IdentityStatusBadge Tone="@(_hasAuthenticator ? "success" : "warning")">@(_hasAuthenticator ? Text["Enabled"] : Text["NotConfigured"])</IdentityStatusBadge></Badge>
        <Actions>
            <a class="identity-card-action" href="@IdentityRoutes.Account.Manage.EnableAuthenticator">@(_hasAuthenticator ? TwoFactorAuthentication_razor.SetupAuthenticatorApp : TwoFactorAuthentication_razor.AddAuthenticatorApp)</a>
            @if (_hasAuthenticator)
            {
                <a class="identity-card-action" href="@IdentityRoutes.Account.Manage.ResetAuthenticator">@TwoFactorAuthentication_razor.ResetAuthenticatorApp</a>
            }
        </Actions>
    </IdentitySettingCard>
}
else
{
    <div class="alert alert-danger">
        <strong>@TwoFactorAuthentication_razor.PrivacyPolicyNotAccepted</strong>
        <p>@TwoFactorAuthentication_razor.AcceptPolicyMessage</p>
    </div>
}

</IdentityManageShell>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.KeyMultiple();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.TwoFactorAuthentication;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.TwoFactorAuthentication);

    private bool _canTrack;
    private bool _hasAuthenticator;
    private int _recoveryCodesLeft;
    private bool _is2FaEnabled;
    private bool _isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        _hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        _is2FaEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        _isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        _recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    protected virtual async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            TwoFactorAuthentication_razor.BrowserForgottenMessage,
            HttpContext);
    }
}
