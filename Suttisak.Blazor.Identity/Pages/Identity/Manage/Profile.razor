@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>@Manage_razor.Profile</PageTitle>

<FluentBreadcrumb>
	<FluentBreadcrumbItem Href="@IdentityRoutes.Account.Manage.Root">@Manage_razor.Account</FluentBreadcrumbItem>
    <FluentBreadcrumbItem Href="@IdentityRoutes.Account.Manage.Profile">@Manage_razor.Profile</FluentBreadcrumbItem>
</FluentBreadcrumb>

<FluentLabel Typo="Typography.PageTitle">@Manage_razor.Profile</FluentLabel>

<StatusMessage />

<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            <FluentTextField Value="@_username" Placeholder="@Profile_razor.UsernamePlaceholder" Disabled Label="@Profile_razor.UsernameLabel" Appearance=FluentInputAppearance.Filled Style="width: 100%" />
            <FluentTextField Name="Input.PhoneNumber" @bind-Value="Input.PhoneNumber" Placeholder="@Profile_razor.PhoneNumberPlaceholder" Label="@Profile_razor.PhoneNumberLabel" Style="width: 100%" />
            <FluentValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width: 100%;">@Profile_razor.SaveButton</FluentButton>
        </EditForm>
    </FluentGridItem>
</FluentGrid>

@code {
    private TUser _user = null!;
    private string? _username;
    private string? _phoneNumber;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _username = await UserManager.GetUserNameAsync(_user);
        _phoneNumber = await UserManager.GetPhoneNumberAsync(_user);

        Input.PhoneNumber ??= _phoneNumber;
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        if (Input.PhoneNumber != _phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(_user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus(Profile_razor.ErrorSetPhoneNumber, HttpContext);
            }
        }

        await SignInManager.RefreshSignInAsync(_user);
        RedirectManager.RedirectToCurrentPageWithStatus(Profile_razor.ProfileUpdated, HttpContext);
    }

    protected class InputModel
    {
        [Phone]
        [Display(Name = nameof(Profile_razor.PhoneNumberLabel), ResourceType = typeof(Profile_razor))]
        public string? PhoneNumber { get; set; }
    }
}
