@typeparam TUser where TUser : class
@using Microsoft.Extensions.Localization
@inject UserManager<TUser> UserManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IStringLocalizer<IdentityManageShell> Text

<PageTitle>@Text["AccountCenter"]</PageTitle>


<IdentityManageShell Title="@Text["Overview"]"
                     Description="@Text["OverviewDescription"]"
                     ActiveUrl="@IdentityRoutes.Account.Manage.Root"
                     IconName="@StaticPageIcon"
                     BreadcrumbItems="@(new[] { new Breadcrumb(StaticPageIcon, null, Text["AccountCenter"]) })">
    <StatusMessage />

    <div class="identity-overview-grid">
        <IdentitySettingCard Title="@Manage_razor.Email"
                             Description="@Text["EmailDescription"]"
                             IconName="Mail">
            <Badge><IdentityStatusBadge Tone="@(_isEmailConfirmed ? "success" : "warning")">@(_isEmailConfirmed ? Text["Verified"] : Text["NotVerified"])</IdentityStatusBadge></Badge>
            <Actions><AppButton Href="@IdentityRoutes.Account.Manage.Email" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>

        <IdentitySettingCard Title="@Manage_razor.ChangePassword"
                             Description="@Text["PasswordDescription"]"
                             IconName="Password">
            <Badge><IdentityStatusBadge Tone="@(_hasPassword ? "success" : "warning")">@(_hasPassword ? Text["PasswordSet"] : Text["NoPassword"])</IdentityStatusBadge></Badge>
            <Actions><AppButton Href="@(_hasPassword ? IdentityRoutes.Account.Manage.ChangePassword : IdentityRoutes.Account.Manage.SetPassword)" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>

        <IdentitySettingCard Title="@Manage_razor.TwoFactorAuthentication"
                             Description="@Text["TwoFactorDescription"]"
                             IconName="KeyMultiple">
            <Badge><IdentityStatusBadge Tone="@(_is2FaEnabled ? "success" : "warning")">@(_is2FaEnabled ? Text["Enabled"] : Text["NotConfigured"])</IdentityStatusBadge></Badge>
            <Actions><AppButton Href="@IdentityRoutes.Account.Manage.TwoFactorAuthentication" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>

        <IdentitySettingCard Title="@Manage_razor.Passkeys"
                             Description="@Text["PasskeysDescription"]"
                             IconName="PersonPasskey">
            <Badge><IdentityStatusBadge Tone="@(_passkeyCount > 0 ? "success" : "neutral")">@string.Format(Text["PasskeyCount"], _passkeyCount)</IdentityStatusBadge></Badge>
            <Actions><AppButton Href="@IdentityRoutes.Account.Manage.Passkeys" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>

        <IdentitySettingCard Title="@Manage_razor.ExternalLogins"
                             Description="@Text["ExternalLoginsDescription"]"
                             IconName="GlobeSurface">
            <Badge><IdentityStatusBadge>@string.Format(Text["ExternalLoginCount"], _externalLoginCount)</IdentityStatusBadge></Badge>
            <Actions><AppButton Href="@IdentityRoutes.Account.Manage.ExternalLogins" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>

        <IdentitySettingCard Title="@Manage_razor.PersonalData"
                             Description="@Text["PersonalDataDescription"]"
                             IconName="DatabasePerson">
            <Actions><AppButton Href="@IdentityRoutes.Account.Manage.PersonalData" Variant="AppButtonVariant.Secondary">@Text["ManageAction"]</AppButton></Actions>
        </IdentitySettingCard>
    </div>
</IdentityManageShell>

@code {
    public static string StaticPageIcon { get; } = "PersonCircle";
    public static string StaticPageUrl { get; } = IdentityRoutes.Account.Manage.Root;
    public static string StaticPageTitleKey { get; } = nameof(Manage_razor.Manage);

    private bool _isEmailConfirmed;
    private bool _hasPassword;
    private bool _is2FaEnabled;
    private int _passkeyCount;
    private int _externalLoginCount;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _isEmailConfirmed = await UserManager.IsEmailConfirmedAsync(user);
        _hasPassword = await UserManager.HasPasswordAsync(user);
        _is2FaEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        _passkeyCount = (await UserManager.GetPasskeysAsync(user)).Count;
        _externalLoginCount = (await UserManager.GetLoginsAsync(user)).Count;
    }
}
