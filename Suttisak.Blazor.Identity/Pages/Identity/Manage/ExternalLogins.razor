@typeparam TUser where TUser : class

@using Microsoft.AspNetCore.Authentication

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IUserStore<TUser> UserStore
@inject IdentityRedirectManager RedirectManager
@inject IExternalLoginProfileStore<TUser> ExternalLoginProfileStore
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text

<PageTitle>@Manage_razor.ExternalLogins</PageTitle>


<SectionContent SectionName="@CommonSections.PageTitle">
<PageHeading Title="@Manage_razor.ExternalLogins">
        <Breadcrumbs><AppBreadcrumb Items="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(StaticPageIcon, null, Manage_razor.ExternalLogins) })" /></Breadcrumbs>
    </PageHeading>
</SectionContent>

<IdentityManageShell Title="@Manage_razor.ExternalLogins" Description="@Text["ExternalLoginsDescription"]" ActiveUrl="@StaticPageUrl" Icon="@StaticPageIcon">
<StatusMessage />
@if (_currentLogins?.Count > 0)
{
    <div class="identity-settings-list" aria-label="@ExternalLogins_razor.RegisteredLogins">
        @foreach (var login in _currentLogins)
        {
            var profile = GetProfile(login);
            <IdentitySettingCard Title="@(profile?.DisplayName ?? login.ProviderDisplayName)"
                                 Description="@profile?.Email"
                                 Icon="@(new Icons.Regular.Size20.GlobeSurface())">
                <Badge><IdentityStatusBadge Tone="success">@Text["Enabled"]</IdentityStatusBadge></Badge>
                <Actions>
                    @if (_showRemoveButton)
                    {
                        <form @formname="@($"remove-login-{login.LoginProvider}")" @onsubmit="OnSubmitAsync" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="@nameof(LoginProvider)" value="@login.LoginProvider" />
                            <input type="hidden" name="@nameof(ProviderKey)" value="@login.ProviderKey" />
                            <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Outline" Title="@string.Format(ExternalLogins_razor.RemoveLoginTitle, login.ProviderDisplayName)">@ExternalLogins_razor.RemoveButton</AppButton>
                        </form>
                    }
                </Actions>
            </IdentitySettingCard>
        }
    </div>
}
@if (_otherLogins?.Count > 0)
{
    <FormSection Title="@ExternalLogins_razor.AddAnotherService">
        <form class="identity-provider-actions" action="Account/Manage/LinkExternalLogin" method="post">
            <AntiforgeryToken />
                @foreach (var provider in _otherLogins)
                {
                    <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Outline" Name="Provider" Value="@provider.Name" Title="@string.Format(ExternalLogins_razor.LogInUsingTitle, provider.DisplayName)">
                        @provider.DisplayName
                    </AppButton>
                }
        </form>
    </FormSection>
}

</IdentityManageShell>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.GlobeSurface();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.ExternalLogins;
	public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.ExternalLogins);

    public const string LinkLoginCallback = "LinkLoginCallback";

    private TUser _user = null!;
    private IList<UserLoginInfo>? _currentLogins;
    private IList<AuthenticationScheme>? _otherLogins;
    private IReadOnlyCollection<ExternalLoginProfileInfo> _externalLoginProfiles = [];
    private bool _showRemoveButton;

    [CascadingParameter]
    protected virtual HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    protected virtual string? LoginProvider { get; set; }

    [SupplyParameterFromForm]
    protected virtual string? ProviderKey { get; set; }

    [SupplyParameterFromForm]
    protected virtual string? Action { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _currentLogins = await UserManager.GetLoginsAsync(_user);
        _externalLoginProfiles = await ExternalLoginProfileStore.GetAsync(_user, HttpContext.RequestAborted);
        _otherLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync())
            .Where(auth => _currentLogins.All(ul => auth.Name != ul.LoginProvider))
            .ToList();

        string? passwordHash = null;
        if (UserStore is IUserPasswordStore<TUser> userPasswordStore)
        {
            passwordHash = await userPasswordStore.GetPasswordHashAsync(_user, HttpContext.RequestAborted);
        }

        _showRemoveButton = passwordHash is not null || _currentLogins.Count > 1;

        if (HttpMethods.IsGet(HttpContext.Request.Method) && Action == LinkLoginCallback)
        {
            await OnGetLinkLoginCallbackAsync();
        }
    }

    protected virtual async Task OnSubmitAsync()
    {
        var result = await UserManager.RemoveLoginAsync(_user, LoginProvider!, ProviderKey!);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(ExternalLogins_razor.ErrorRemoveLogin, HttpContext);
        }

        await ExternalLoginProfileStore.RemoveAsync(_user, LoginProvider!, ProviderKey!, HttpContext.RequestAborted);

        await SignInManager.RefreshSignInAsync(_user);
        RedirectManager.RedirectToCurrentPageWithStatus(ExternalLogins_razor.LoginRemoved, HttpContext);
    }

    protected virtual async Task OnGetLinkLoginCallbackAsync()
    {
        var userId = await UserManager.GetUserIdAsync(_user);
        var info = await SignInManager.GetExternalLoginInfoAsync(userId);
        if (info is null)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(ExternalLogins_razor.ErrorLoadLoginInfo, HttpContext);
        }

        var result = await UserManager.AddLoginAsync(_user, info!);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(ExternalLogins_razor.ErrorAddLogin, HttpContext);
        }

        await ExternalLoginProfileStore.SaveAsync(_user, ExternalLoginProfileInfo.From(info!), HttpContext.RequestAborted);

        // Clear the existing external cookie to ensure a clean login process
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

        RedirectManager.RedirectToCurrentPageWithStatus(ExternalLogins_razor.LoginAdded, HttpContext);
    }

    private ExternalLoginProfileInfo? GetProfile(UserLoginInfo login)
        => _externalLoginProfiles.SingleOrDefault(profile =>
            profile.LoginProvider == login.LoginProvider && profile.ProviderKey == login.ProviderKey);
}
