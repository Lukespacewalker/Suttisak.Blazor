@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa<TUser>> Logger
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text



<PageTitle>@Manage_razor.DisableTwoFactorAuthentication</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
<PageHeading Title="@Manage_razor.DisableTwoFactorAuthentication">
        <Breadcrumbs><AppBreadcrumb Items="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(TwoFactorAuthentication<TUser>.StaticPageIcon, TwoFactorAuthentication<TUser>.StaticPageUrl, Manage_razor.TwoFactorAuthentication), new Breadcrumb(StaticPageIcon, null, Manage_razor.DisableTwoFactorAuthentication) })" /></Breadcrumbs>
    </PageHeading>
</SectionContent>
<IdentityManageShell Title="@Manage_razor.DisableTwoFactorAuthentication" Description="@Text["TwoFactorDescription"]" ActiveUrl="@IdentityRoutes.Account.Manage.TwoFactorAuthentication" Icon="@StaticPageIcon">

<StatusMessage />

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@Disable2fa_razor.WarningTitle</strong>
    </p>
    <p>
        @Disable2fa_razor.WarningContent <a href="@IdentityRoutes.Account.Manage.ResetAuthenticator">@Disable2fa_razor.ResetAuthenticatorLink</a>
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width: 100%;">@Disable2fa_razor.DisableButton</AppButton>
    </form>
</div>

</IdentityManageShell>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.ShieldDismiss();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.DisableTwoFactorAuthentication;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.DisableTwoFactorAuthentication);

    private TUser _user = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(_user))
        {
            throw new InvalidOperationException(Disable2fa_razor.ErrorNotEnabled);
        }
    }

    protected virtual async Task OnSubmitAsync()
    {
        var disable2FaResult = await UserManager.SetTwoFactorEnabledAsync(_user, false);
        if (!disable2FaResult.Succeeded)
        {
            throw new InvalidOperationException(Disable2fa_razor.ErrorUnexpected);
        }

        var userId = await UserManager.GetUserIdAsync(_user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        RedirectManager.RedirectToWithStatus(
            IdentityRoutes.Account.Manage.TwoFactorAuthentication,
            Disable2fa_razor.StatusMessage,
            HttpContext);
    }
}
