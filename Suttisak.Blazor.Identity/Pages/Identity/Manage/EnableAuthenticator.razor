@typeparam TUser where TUser : class

@using System.Globalization
@using System.Text
@using System.Text.Encodings.Web

@inject UserManager<TUser> UserManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject UrlEncoder UrlEncoder
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator<TUser>> Logger
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text


<PageTitle>@Manage_razor.EnableAuthenticator</PageTitle>

<IdentityManageShell Title="@Manage_razor.EnableAuthenticator" Description="@Text["TwoFactorDescription"]" ActiveUrl="@IdentityRoutes.Account.Manage.TwoFactorAuthentication" IconName="@StaticPageIcon"
                     BreadcrumbItems="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(TwoFactorAuthentication<TUser>.StaticPageIcon, TwoFactorAuthentication<TUser>.StaticPageUrl, Manage_razor.TwoFactorAuthentication), new Breadcrumb(StaticPageIcon, null, Manage_razor.EnableAuthenticator) })">

@if (_recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="_recoveryCodes.ToArray()" StatusMessage="@_message" />
}
else
{
   <StatusMessage Message="@_message" />
    <FormGrid Columns="1">
        <div>
            <p>@EnableAuthenticator_razor.StepsTitle</p>
            <ol class="list">
                <li>
                    <p>
                        @EnableAuthenticator_razor.Step1
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072">@EnableAuthenticator_razor.Android</a> and
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073">@EnableAuthenticator_razor.iOS</a>
                        @EnableAuthenticator_razor.OrGoogleAuthenticator
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">@EnableAuthenticator_razor.Android</a> and
                        <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">@EnableAuthenticator_razor.iOS</a>.
                    </p>
                </li>
                <li>
                    <p>@EnableAuthenticator_razor.Step2Part1 <kbd>@_sharedKey</kbd> @EnableAuthenticator_razor.Step2Part2</p>
                    <div class="alert alert-info">@EnableAuthenticator_razor.LearnHowTo <a href="https://go.microsoft.com/fwlink/?Linkid=852423">@EnableAuthenticator_razor.EnableQRCodeGeneration</a>.</div>
                    <div></div>
                    <div data-url="@_authenticatorUri"></div>
                </li>
                <li>
                    <p>
                        @EnableAuthenticator_razor.Step3
                    </p>

                    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" method="post">
                        <DataAnnotationsValidator />
                        <AppTextBox Name="Input.Code" @bind-Value="Input!.Code" AutoComplete="off" Placeholder="@EnableAuthenticator_razor.CodePlaceholder" Style="width: 100%;" />
                        <AppButton Type="submit" Variant="AppButtonVariant.Primary" Style="width: 100%;">@EnableAuthenticator_razor.VerifyButton</AppButton>
                        <ValidationSummary class="text-danger" role="alert" />
                    </EditForm>
                </li>
            </ol>
        </div>
    </FormGrid>
}

</IdentityManageShell>

@code {
    public static string StaticPageIcon { get; set; } = "KeyMultiple";
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.EnableAuthenticator;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.EnableAuthenticator);

    private const string AuthenticatorUriFormat = "otpauth://totp/{0}:{1}?secret={2}&issuer={0}&digits=6";

    private string? _message;
    private TUser _user = null!;
    private string? _sharedKey;
    private string? _authenticatorUri;
    private IEnumerable<string>? _recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    protected virtual InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        await LoadSharedKeyAndQrCodeUriAsync(_user);
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        // Strip spaces and hyphens
        var verificationCode = Input!.Code.Replace(" ", string.Empty).Replace("-", string.Empty);

        var is2FaTokenValid = await UserManager.VerifyTwoFactorTokenAsync(
            _user, UserManager.Options.Tokens.AuthenticatorTokenProvider, verificationCode);

        if (!is2FaTokenValid)
        {
            _message = EnableAuthenticator_razor.ErrorInvalidCode;
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(_user, true);
        var userId = await UserManager.GetUserIdAsync(_user);
        Logger.LogInformation("User with ID '{UserId}' has enabled 2FA with an authenticator app.", userId);

        _message = EnableAuthenticator_razor.SuccessMessage;

        if (await UserManager.CountRecoveryCodesAsync(_user) == 0)
        {
            _recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);
        }
        else
        {
            RedirectManager.RedirectToWithStatus(IdentityRoutes.Account.Manage.TwoFactorAuthentication, _message, HttpContext);
        }
    }

    protected virtual async ValueTask LoadSharedKeyAndQrCodeUriAsync(TUser user)
    {
        // Load the authenticator key & QR code URI to display on the form
        var unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(unformattedKey))
        {
            await UserManager.ResetAuthenticatorKeyAsync(user);
            unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        }

        _sharedKey = FormatKey(unformattedKey!);

        var email = await UserManager.GetEmailAsync(user);
        _authenticatorUri = GenerateQrCodeUri(email!, unformattedKey!);
    }

    protected virtual string FormatKey(string unformattedKey)
    {
        var result = new StringBuilder();
        int currentPosition = 0;
        while (currentPosition + 4 < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition, 4)).Append(' ');
            currentPosition += 4;
        }
        if (currentPosition < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition));
        }

        return result.ToString().ToLowerInvariant();
    }

    protected virtual string GenerateQrCodeUri(string email, string unformattedKey)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            AuthenticatorUriFormat,
            UrlEncoder.Encode("Microsoft.AspNetCore.Identity.UI"),
            UrlEncoder.Encode(email),
            unformattedKey);
    }

    protected sealed class InputModel
    {
        [Required]
        [StringLength(7, ErrorMessageResourceName = nameof(EnableAuthenticator_razor.CodeLengthError), ErrorMessageResourceType = typeof(EnableAuthenticator_razor), MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = nameof(EnableAuthenticator_razor.VerificationCodeLabel), ResourceType = typeof(EnableAuthenticator_razor))]
        public string Code 
        { 
            get => field; 
            set => field = value.Trim(); 
        } = "";
    }
}
