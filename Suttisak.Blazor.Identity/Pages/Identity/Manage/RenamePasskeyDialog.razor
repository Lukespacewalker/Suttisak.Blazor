@typeparam TUser where TUser : class
@inherits AppOverlayInstance<bool>

@inject UserManager<TUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (_showError)
{
    <FeedbackBanner Intent="FeedbackIntent.Error" Title="@RenamePasskey_razor.Error">
        @RenamePasskey_razor.ErrorUpdateFailed
    </FeedbackBanner>
}

<div class="app-overlay-form">
    <AppTextBox Label="@RenamePasskey_razor.PasskeyNameLabel"
    @bind-Value:get="Passkey.Name" 
    @bind-Value:set="value => Passkey.Name = value?.Trim()" aria-required="true" Placeholder="@RenamePasskey_razor.PasskeyNamePlaceholder" />
    <FormActions>
        <AppButton Variant="AppButtonVariant.Secondary" OnClick="CancelAsync">Cancel</AppButton>
        <AppButton Variant="AppButtonVariant.Primary" OnClick="SaveAsync">Save</AppButton>
    </FormActions>
</div>

@code {

    [Parameter, EditorRequired]
    public UserPasskeyInfo Passkey { get; set; }

    private bool _showError;

    private async Task SaveAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        var passkeyResult = await UserManager.AddOrUpdatePasskeyAsync(user!, Passkey);
        if (!passkeyResult.Succeeded)
        {
            _showError = true;
            return;
        }
        await CloseAsync(true);
    }
}
