@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text

<PageTitle>@Manage_razor.SetPassword</PageTitle>



<SectionContent SectionName="@CommonSections.PageTitle">
<PageHeading Title="@Manage_razor.SetPassword">
        <Breadcrumbs><AppBreadcrumb Items="@(new Suttisak.Blazor.UserInterface.Models.Breadcrumb[]
    {
        new(null, IdentityRoutes.Account.Manage.Root, Manage_razor.Account),
        new(null, IdentityRoutes.Account.Manage.Profile, Manage_razor.Profile),
        new(null, null, Manage_razor.SetPassword)
    })" /></Breadcrumbs>
    </PageHeading>
</SectionContent>
<IdentityManageShell Title="@Manage_razor.SetPassword" Description="@Text["PasswordDescription"]" ActiveUrl="@IdentityRoutes.Account.Manage.ChangePassword" Icon="@(new Icons.Regular.Size20.Password())">

<StatusMessage Message="@_message" />
<p class="text-info">
    @SetPassword_razor.NoLocalAccountMessage
</p>
<FormGrid Columns="1">
    <div>
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            <FluentTextInput TextInputType="TextInputType.Password" Name="Input.NewPassword" @bind-Value="Input!.NewPassword" AutoComplete="new-password" Placeholder="@SetPassword_razor.NewPasswordPlaceholder" Label="@SetPassword_razor.NewPasswordLabel" Style="width: 100%" />
            @*<FluentValidationMessage For="() => Input.NewPassword" class="text-danger" />*@
            @* TODO: restore FluentValidationMessage later in RC3 *@
            <FluentTextInput TextInputType="TextInputType.Password" Name="Input.ConfirmPassword" @bind-Value="Input!.ConfirmPassword" AutoComplete="new-password" Placeholder="@SetPassword_razor.ConfirmPasswordPlaceholder" Label="@SetPassword_razor.ConfirmPasswordLabel" Style="width: 100%" />
            @*<FluentValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />*@
            @* TODO: restore FluentValidationMessage later in RC3 *@
            <AppButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width: 100%;">@SetPassword_razor.SetPasswordButton</AppButton>
        </EditForm>
    </div>
</FormGrid>

</IdentityManageShell>

@code {
    private string? _message;
    private TUser _user = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    protected virtual InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var hasPassword = await UserManager.HasPasswordAsync(_user);
        if (hasPassword)
        {
            RedirectManager.RedirectTo(IdentityRoutes.Account.Manage.ChangePassword);
        }
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        var addPasswordResult = await UserManager.AddPasswordAsync(_user, Input!.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            _message = $"Error: {string.Join(",", addPasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(_user);
        RedirectManager.RedirectToCurrentPageWithStatus(SetPassword_razor.SuccessMessage, HttpContext);
    }

    protected class InputModel
    {
        [Required]
        [StringLength(100, ErrorMessageResourceType = typeof(SetPassword_razor), ErrorMessageResourceName = nameof(SetPassword_razor.ErrorPasswordLength), MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(ResourceType = typeof(SetPassword_razor), Name = nameof(SetPassword_razor.NewPasswordDisplayName))]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Display(ResourceType = typeof(SetPassword_razor), Name = nameof(SetPassword_razor.ConfirmPasswordDisplayName))]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(SetPassword_razor), ErrorMessageResourceName = nameof(SetPassword_razor.ErrorPasswordMismatch))]
        public string? ConfirmPassword { get; set; }
    }
}

