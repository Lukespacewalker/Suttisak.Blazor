@using System.Text
@using System.Text.Encodings.Web
@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject IEmailSender<TUser> EmailSender
@inject NavigationManager NavigationManager
@inherits BreadcrumbPage

<PageTitle>@Manage_razor.Email</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
    <h1>@Manage_razor.Email</h1>
</SectionContent>

<StatusMessage Message="@_message" />
<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
            <AntiforgeryToken />
        </form>
        <EditForm Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            @if (_isEmailConfirmed)
            {
                <FluentTextInput Value="@_email" Placeholder="@Email_razor.EmailPlaceholder" ReadOnly Label="@Email_razor.EmailLabel" Appearance=TextInputAppearance.Outline Style="width: 100%">
                    <span slot="end">✓</span>
                </FluentTextInput>
            }
            else
            {
                <FluentTextInput value="@_email" Placeholder="@Email_razor.EmailPlaceholder" ReadOnly Label="@Email_razor.EmailLabel" Appearance=TextInputAppearance.Outline Style="width: 100%" />
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Form="send-verification-form" Style="width: 100%">@Email_razor.SendVerificationButton</FluentButton>
            }
            <FluentTextInput 
                Name="Input.NewEmail" 
                @bind-Value="Input.NewEmail" AutoComplete="email" Required="true" Placeholder="@Email_razor.NewEmailPlaceholder" Label="@Email_razor.NewEmailLabel" Style="width: 100%" />
            <!-- TODO : Restore Fluent Validation Message Later-->
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width: 100%;">@Email_razor.ChangeEmailButton</FluentButton>
        </EditForm>
    </FluentGridItem>
</FluentGrid>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.Mail();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.Email;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.Email);

    private string? _message;
    private TUser _user = null!;
    private string? _email;
    private bool _isEmailConfirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "change-email")]
    protected virtual InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AddPage<Manage>().AddThisPageAndPopulate<Email<TUser>>();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _email = await UserManager.GetEmailAsync(_user);
        _isEmailConfirmed = await UserManager.IsEmailConfirmedAsync(_user);
        Input.NewEmail ??= _email;
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        if (Input.NewEmail is null || Input.NewEmail == _email)
        {
            _message = Email_razor.EmailUnchangedMessage;
            return;
        }

        var userId = await UserManager.GetUserIdAsync(_user);
        var code = await UserManager.GenerateChangeEmailTokenAsync(_user, Input.NewEmail);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmailChange").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["email"] = Input.NewEmail, ["code"] = code });

#if DEBUG
        RedirectManager.RedirectTo(callbackUrl);
        return;
#endif

        await EmailSender.SendConfirmationLinkAsync(_user, Input.NewEmail, HtmlEncoder.Default.Encode(callbackUrl));

        _message = Email_razor.ConfirmationLinkSentMessage;
    }

    protected virtual async Task OnSendEmailVerificationAsync()
    {
        if (_email is null)
        {
            return;
        }

        var userId = await UserManager.GetUserIdAsync(_user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(_user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

#if DEBUG
			RedirectManager.RedirectTo(callbackUrl);
            return;
#endif

        await EmailSender.SendConfirmationLinkAsync(_user, _email, HtmlEncoder.Default.Encode(callbackUrl));

        _message = Email_razor.VerificationEmailSentMessage;
    }

    protected class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = nameof(Email_razor.NewEmailLabel), ResourceType = typeof(Email_razor))]
        public string? NewEmail { get; set; }
    }
}
