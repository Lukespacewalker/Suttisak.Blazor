@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject ILogger<GenerateRecoveryCodes<TUser>> Logger
@inherits BreadcrumbPage

<PageTitle>@Manage_razor.GenerateRecoveryCodes</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
    <FluentLabel>@Manage_razor.GenerateRecoveryCodes</FluentLabel>
</SectionContent>

@if (_recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="_recoveryCodes.ToArray()" StatusMessage="@_message" />
}
else
{
    <div class="alert alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>@GenerateRecoveryCodes_razor.WarningTitle</strong>
        </p>
        <p>
            @GenerateRecoveryCodes_razor.WarningContent1
        </p>
        <p>
            @GenerateRecoveryCodes_razor.WarningContent2 <a href="@IdentityRoutes.Account.Manage.ResetAuthenticator">@GenerateRecoveryCodes_razor.ResetAuthenticatorLink</a>
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary">@GenerateRecoveryCodes_razor.GenerateButton</FluentButton>
        </form>
    </div>
}

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.KeyMultiple();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.GenerateRecoveryCodes;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.GenerateRecoveryCodes);

    private string? _message;
    private TUser _user = null!;
    private IEnumerable<string>? _recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AddPage<Manage>().AddPage<TwoFactorAuthentication<TUser>>().AddThisPageAndPopulate<GenerateRecoveryCodes<TUser>>();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(_user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException(GenerateRecoveryCodes_razor.ErrorNotEnabled);
        }
    }

    protected virtual async Task OnSubmitAsync()
    {
        var userId = await UserManager.GetUserIdAsync(_user);
        _recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);
        _message = GenerateRecoveryCodes_razor.SuccessMessage;

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
