@typeparam TUser where TUser : class
@inject IdentityUserAccessor<TUser> UserAccessor
@inherits BreadcrumbPage

<PageTitle>@Manage_razor.PersonalData</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
    <h1>@Manage_razor.PersonalData</h1>
</SectionContent>
<StatusMessage />

<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <p>@PersonalData_razor.Description</p>
        <p>
            <strong>@PersonalData_razor.Warning</strong>
        </p>
        <form action="@IdentityRoutes.Api.DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width:20%;">@PersonalData_razor.DownloadButton</FluentButton>
        </form>

        <hr />

        <p>
            <FluentLink Href="@IdentityRoutes.Account.Manage.DeletePersonalData" Style="width:20%;">@PersonalData_razor.DeleteLink</FluentLink>
        </p>
    </FluentGridItem>
</FluentGrid>

@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.DatabasePerson();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.PersonalData;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.PersonalData);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AddPage<Manage>().AddThisPageAndPopulate<PersonalData<TUser>>();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
