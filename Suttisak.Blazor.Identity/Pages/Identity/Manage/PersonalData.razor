@typeparam TUser where TUser : class
@inject IdentityUserAccessor<TUser> UserAccessor

<PageTitle>@Manage_razor.PersonalData</PageTitle>

<FluentBreadcrumb>
    <FluentBreadcrumbItem Href="@IdentityRoutes.Account.Manage.Root">@Manage_razor.Account</FluentBreadcrumbItem>
    <FluentBreadcrumbItem Href="@IdentityRoutes.Account.Manage.PersonalData">@Manage_razor.PersonalData</FluentBreadcrumbItem>
</FluentBreadcrumb>

<FluentLabel Typo="Typography.PageTitle">@Manage_razor.PersonalData</FluentLabel>

<StatusMessage />

<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <p>@PersonalData_razor.Description</p>
        <p>
            <strong>@PersonalData_razor.Warning</strong>
        </p>
        <form action="@IdentityRoutes.Api.DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:20%;">@PersonalData_razor.DownloadButton</FluentButton>
        </form>
        
        <hr />
        
        <p>
            <FluentAnchor Href="@IdentityRoutes.Account.Manage.DeletePersonalData" Style="width:20%;">@PersonalData_razor.DeleteLink</FluentAnchor>
        </p>
    </FluentGridItem>
</FluentGrid>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
