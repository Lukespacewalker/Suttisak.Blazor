@typeparam TUser where TUser : class

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityUserAccessor<TUser> UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData<TUser>> Logger
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityManageShell> Text
<PageBreadcrumbs Items="@(new[] { new Breadcrumb(Manage<TUser>.StaticPageIcon, Manage<TUser>.StaticPageUrl, Manage_razor.Manage), new Breadcrumb(PersonalData<TUser>.StaticPageIcon, PersonalData<TUser>.StaticPageUrl, Manage_razor.PersonalData), new Breadcrumb(StaticPageIcon, null, Manage_razor.DeletePersonalData) })" />

<PageTitle>@Manage_razor.DeletePersonalData</PageTitle>

<SectionContent SectionName="@CommonSections.PageTitle">
    <h1>@Manage_razor.DeletePersonalData</h1>
</SectionContent>

<IdentityManageShell Title="@Manage_razor.DeletePersonalData" Description="@Text["PersonalDataDescription"]" ActiveUrl="@IdentityRoutes.Account.Manage.PersonalData" Icon="@StaticPageIcon">
<StatusMessage Message="@_message" />

<FluentGrid>
    <FluentGridItem sm="6">
        <div class="alert alert-danger" role="alert">
            <p>
                <strong>@DeletePersonalData_razor.WarningMessage</strong>
            </p>
        </div>
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FluentValidationSummary class="text-danger" role="alert" />
            @if (_requirePassword)
            {
                <FluentTextInput type="password" Name="Input.Password" @bind-Value="Input!.Password" AutoComplete="new-password" Required="true" Placeholder="@DeletePersonalData_razor.PasswordPlaceholder" Label="@DeletePersonalData_razor.PasswordLabel" Style="width: 100%" />
                @*<FluentValidationMessage For="() => Input.Password" class="text-danger" />*@
                @* TODO: restore FluentValidationMessage later in RC3 *@
            }
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Class="identity-danger-button" Style="width: 100%;">@DeletePersonalData_razor.SubmitButton</FluentButton>
        </EditForm>
    </FluentGridItem>
</FluentGrid>
</IdentityManageShell>
@code {
    public static Icon StaticPageIcon { get; set; } = new Icons.Regular.Size20.Delete();
    public static string StaticPageUrl { get; set; } = IdentityRoutes.Account.Manage.DeletePersonalData;
    public static string? StaticPageTitleResource { get; set; } = typeof(Manage_razor).FullName!.Replace("_", ".");
    public static string StaticPageTitleKey { get; set; } = nameof(Manage_razor.DeletePersonalData);

    private string? _message;
    private TUser _user = null!;
    private bool _requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    protected virtual InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _requirePassword = await UserManager.HasPasswordAsync(_user);
    }

    protected virtual async Task OnValidSubmitAsync()
    {
        if (_requirePassword && !await UserManager.CheckPasswordAsync(_user, Input!.Password))
        {
            _message = DeletePersonalData_razor.IncorrectPasswordError;
            return;
        }

        var result = await UserManager.DeleteAsync(_user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(DeletePersonalData_razor.UnexpectedErrorDeletingUser);
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(_user);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    protected class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
