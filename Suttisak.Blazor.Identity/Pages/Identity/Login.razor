@typeparam TUser where TUser : class

@using Microsoft.AspNetCore.Authentication
@using Suttisak.Blazor.Identity.Region.Identity


@inject SignInManager<TUser> SignInManager
@inject ILogger<Login<TUser>> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>@Login_razor.Login</PageTitle>
<text>
	<StatusMessage Message="@_statusMessage" />

	<EditForm Model="LoginWithUsernamePasswordInput" asp-route-returnUrl="@ReturnUrl" method="post"
			  OnValidSubmit="LoginWithUsernamePassword" FormName="@LoginWithUsernameFormName" class="login-form">
		<DataAnnotationsValidator />
		<FluentValidationSummary class="text-danger" role="alert" />

		<div>
			<FluentTextInput Name="LoginWithUsernamePasswordInput.Username" Width="100%"
							 @bind-Value="LoginWithUsernamePasswordInput.Username" AutoComplete="username" Required="true"
							 Placeholder="@Login_razor.EmailOrUsername" Label="@Login_razor.Username" Style="width: 100%" />

			<FluentTextInput Name="LoginWithUsernamePasswordInput.Password" " Width="100%"
							 @bind-Value="LoginWithUsernamePasswordInput.Password" AutoComplete="current-password" Required="true"
							 Placeholder="@Login_razor.Password" Label="@Login_razor.Password" Style="width: 100%"
							 InputType="InputType.Password" />

			<label class="login-remember-row" for="remember-me">
				<input id="remember-me" name="@($"{LoginWithUsernameFormName}.RememberMe")" type="checkbox"
					   @bind="LoginWithUsernamePasswordInput.RememberMe" />
				<span>@Login_razor.KeepMeSignedInOnThisDevice</span>
			</label>
		</div>

		<div class="login-form-actions">
			<FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit">@Login_razor.SignIn
			</FluentButton>
			<a class="login-secondary-link"
			   href="@IdentityRoutes.Account.ForgotPassword">@Login_razor.ForgotPassword</a>
		</div>
	</EditForm>

	<div class="identity-separator" aria-hidden="true">
		<span></span>
		<p>@Login_razor.AlternativeAccess</p>
		<span></span>
	</div>

	<div class="login-alt-actions" role="group" aria-label="@Login_razor.AlternativeAccess">
		<PasskeySubmit FormName="@LoginWithPasskeyFormName" Operation="PasskeyOperation.Request"
					   OutputParameterName="@nameof(LoginWithPasskeyOutput)" OnSubmit="LoginWithPasskey">
			@Login_razor.ContinueWithPasskey
		</PasskeySubmit>

		<div class="login-provider-block">
			<ExternalLoginPicker TUser="TUser" />
		</div>
	</div>
</text>
@code {
	private string? _statusMessage;

	protected const string LoginWithUsernameFormName = "login-with-username";
	protected const string LoginWithPasskeyFormName = "login-with-passkey";

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = null!;

	[SupplyParameterFromForm(FormName = LoginWithUsernameFormName)]
	protected virtual UsernamePasswordInputModel LoginWithUsernamePasswordInput { get; set; } = new();

	[SupplyParameterFromForm(FormName = LoginWithPasskeyFormName)]
	protected virtual PasskeyOutputModel LoginWithPasskeyOutput { get; set; } = new();

	[SupplyParameterFromQuery]
	private string? ReturnUrl { get; set; }

	protected virtual string RedirectUrl { get; set; } = "/";
	protected virtual string UserNamePlaceholder { get; set; } = "";
	protected virtual string PasswordPlaceholder { get; set; } = "";

	protected override async Task OnInitializedAsync()
	{
		if (HttpMethods.IsGet(HttpContext.Request.Method))
		{
			// Clear the existing external cookie to ensure a clean login process
			await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
		}
	}

	public async Task LoginWithPasskey()
	{
		if (!string.IsNullOrEmpty(LoginWithPasskeyOutput.Error))
		{
			_statusMessage = $"{Login_razor.Error}: {LoginWithPasskeyOutput.Error}";
			return;
		}
		SignInResult? result = null;
		if (!string.IsNullOrEmpty(LoginWithPasskeyOutput.CredentialJson))
		{
			// When performing passkey sign-in, don't perform form validation.
			result = await SignInManager.PasskeySignInAsync(LoginWithPasskeyOutput.CredentialJson);
		}

		HandleResult(result);
	}

	public async Task LoginWithUsernamePassword()
	{
		var result = await SignInManager.PasswordSignInAsync(LoginWithUsernamePasswordInput.Username,
LoginWithUsernamePasswordInput.Password, LoginWithUsernamePasswordInput.RememberMe, lockoutOnFailure: false);
		HandleResult(result);
	}

	private void HandleResult(SignInResult? result)
	{
		if (result is null)
		{
			_statusMessage = $"{Login_razor.Error}: {Login_razor.InvalidLoginAttempt}";
			return;
		}

		if (result.Succeeded)
		{
			Logger.LogInformation("User logged in.");
			RedirectManager.RedirectTo(string.IsNullOrWhiteSpace(ReturnUrl) ? RedirectUrl : ReturnUrl);
		}
		else if (result.RequiresTwoFactor)
		{
			RedirectManager.RedirectTo(
				IdentityRoutes.Account.LoginWith2fa,
				new Dictionary<string, object?>
				{
					["returnUrl"] = ReturnUrl,
					["rememberMe"] = LoginWithUsernamePasswordInput.RememberMe
				});
		}
		else if (result.IsLockedOut)
		{
			Logger.LogWarning("User account locked out.");
			RedirectManager.RedirectTo(IdentityRoutes.Account.Lockout);
		}
		else
		{
			_statusMessage = $"{Login_razor.Error}: {Login_razor.InvalidLoginAttempt}";
		}
	}

}
