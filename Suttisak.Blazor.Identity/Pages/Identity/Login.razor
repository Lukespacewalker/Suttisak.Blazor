@typeparam TUser where TUser : class

@using Microsoft.AspNetCore.Authentication
@using Suttisak.Blazor.Identity.Region.Identity


@inject SignInManager<TUser> SignInManager
@inject ILogger<Login<TUser>> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>@Login_razor.Login</PageTitle>

<section class="login-page">
	<div class="login-shell">
		<div class="login-panel">
			<header class="login-header">
				<p class="login-eyebrow">@Login_razor.Login</p>
				<h1>@UsernamePasswordLogin_razor.Login</h1>
			</header>

			<StatusMessage Message="@_statusMessage" />

			<UsernamePasswordLogin FormName=@LoginWithUsernameFormName
							   UsernamePasswordInput="@LoginWithUsernamePasswordInput"
							   UserNamePlaceholder="@UserNamePlaceholder"
							   PasswordPlaceholder="@PasswordPlaceholder"
							   OnValidSubmit="LoginWithUsernamePassword" />

			<FluentDivider class="login-divider" />

			<h5 class="login-alternative">
				@UsernamePasswordLogin_razor.Alternative
			</h5>

			<div class="login-actions" role="menubar">
        <PasskeySubmit FormName="@LoginWithPasskeyFormName" 
                       Operation="PasskeyOperation.Request" 
                       OutputParameterName="@nameof(LoginWithPasskeyOutput)" 
                       OnSubmit="LoginWithPasskey">
			@Login_razor.Passkey
		</PasskeySubmit>
		<FluentDivider Vertical="true" class="login-actions-divider" />
		<ExternalLoginPicker TUser="TUser" />
			</div>
		</div>
	</div>
</section>

@code {
	private string? _statusMessage;

	protected const string LoginWithUsernameFormName = "login-with-username";
	protected const string LoginWithPasskeyFormName = "login-with-passkey";

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = null!;

	[SupplyParameterFromForm(FormName = LoginWithUsernameFormName)]
	protected virtual UsernamePasswordInputModel LoginWithUsernamePasswordInput { get; set; } = new();

	[SupplyParameterFromForm(FormName = LoginWithPasskeyFormName)]
	protected virtual PasskeyOutputModel LoginWithPasskeyOutput { get; set; } = new();

	[SupplyParameterFromQuery]
	private string? ReturnUrl { get; set; }

	protected virtual string RedirectUrl { get; set; } = "/";
	protected virtual string UserNamePlaceholder { get; set; } = "";
	protected virtual string PasswordPlaceholder { get; set; } = "";

	protected override async Task OnInitializedAsync()
	{
		if (HttpMethods.IsGet(HttpContext.Request.Method))
		{
			// Clear the existing external cookie to ensure a clean login process
			await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
		}
	}

	public async Task LoginWithPasskey()
	{
		if (!string.IsNullOrEmpty(LoginWithPasskeyOutput.Error))
		{
			_statusMessage = $"{Login_razor.Error}: {LoginWithPasskeyOutput.Error}";
			return;
		}
		SignInResult? result = null;
		if (!string.IsNullOrEmpty(LoginWithPasskeyOutput.CredentialJson))
		{
			// When performing passkey sign-in, don't perform form validation.
			result = await SignInManager.PasskeySignInAsync(LoginWithPasskeyOutput.CredentialJson);
		}

		HandleResult(result);
	}

	public async Task LoginWithUsernamePassword()
	{
		var result = await SignInManager.PasswordSignInAsync(LoginWithUsernamePasswordInput.Username, LoginWithUsernamePasswordInput.Password, LoginWithUsernamePasswordInput.RememberMe, lockoutOnFailure: false);
		HandleResult(result);
	}

	private void HandleResult(SignInResult? result)
	{
		if (result is null)
		{
			_statusMessage = $"{Login_razor.Error}: {Login_razor.InvalidLoginAttempt}";
			return;
		}

		if (result.Succeeded)
		{
			Logger.LogInformation("User logged in.");
			RedirectManager.RedirectTo(string.IsNullOrWhiteSpace(ReturnUrl) ? RedirectUrl : ReturnUrl);
		}
		else if (result.RequiresTwoFactor)
		{
			RedirectManager.RedirectTo(
				IdentityRoutes.Account.LoginWith2fa,
				new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl, ["rememberMe"] = LoginWithUsernamePasswordInput.RememberMe });
		}
		else if (result.IsLockedOut)
		{
			Logger.LogWarning("User account locked out.");
			RedirectManager.RedirectTo(IdentityRoutes.Account.Lockout);
		}
		else
		{
			_statusMessage = $"{Login_razor.Error}: {Login_razor.InvalidLoginAttempt}";
		}
	}

}
