@typeparam TUser where TUser : class

@using System.Text


@inject UserManager<TUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@ConfirmEmail_razor.ConfirmEmail</PageTitle>

<IdentityFlowPanel Title="@ConfirmEmail_razor.ConfirmEmail">
<StatusMessage Message="@_statusMessage" Intent="@(_confirmed ? FeedbackIntent.Success : FeedbackIntent.Error)" />
@if (!_confirmed)
{
    <AppButton Href="Account/ResendEmailConfirmation" Variant="AppButtonVariant.Secondary">@ResendEmailConfirmation_razor.Header</AppButton>
}
</IdentityFlowPanel>

@code {
    private string? _statusMessage;
    private bool _confirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            _statusMessage = ConfirmEmail_razor.ErrorConfirmingEmail;
            return;
        }

        string code;
        try
        {
            code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            _statusMessage = ConfirmEmail_razor.ErrorConfirmingEmail;
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            _statusMessage = string.Format(ConfirmEmail_razor.ErrorLoadingUser, UserId);
        }
        else
        {
            var result = await UserManager.ConfirmEmailAsync(user, code);
            _confirmed = result.Succeeded;
            _statusMessage = _confirmed ? ConfirmEmail_razor.ThankYouForConfirming : ConfirmEmail_razor.ErrorConfirmingEmail;
        }
    }
}
