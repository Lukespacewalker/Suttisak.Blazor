@typeparam TUser where TUser : class

@using System.Text

@inject UserManager<TUser> UserManager
@inject SignInManager<TUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@ConfirmEmailChange_razor.ConfirmEmailChange</PageTitle>

<IdentityFlowPanel Title="@ConfirmEmailChange_razor.ConfirmEmailChange">
<section style="display: flex; flex-direction: column; align-items:center">
	<h1>@ConfirmEmailChange_razor.ConfirmEmailChange</h1>
	<StatusMessage Message="@_message"/>
	<a style="margin-top:4rem;" href="/">
		<h3>
			Back to home
		</h3>
	</a>
</section>
</IdentityFlowPanel>



@code {
	private string? _message;

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = null!;

	[SupplyParameterFromQuery]
	private string? UserId { get; set; }

	[SupplyParameterFromQuery]
	private string? Email { get; set; }

	[SupplyParameterFromQuery]
	private string? Code { get; set; }

	protected override async Task OnInitializedAsync()
	{
		if (UserId is null || Email is null || Code is null)
		{
			RedirectManager.RedirectToWithStatus(
				"Account/Login", ConfirmEmailChange_razor.ErrorInvalidLink, HttpContext);
		}

		var user = await UserManager.FindByIdAsync(UserId!);
		if (user is null)
		{
			_message = string.Format(ConfirmEmailChange_razor.ErrorUserNotFound, UserId);
			return;
		}

		var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!));
		var result = await UserManager.ChangeEmailAsync(user, Email!, code);
		if (!result.Succeeded)
		{
			_message = ConfirmEmailChange_razor.ErrorChangingEmail;
			return;
		}

		// var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
		// if (!setUserNameResult.Succeeded)
		// {
		// 	_message = ConfirmEmailChange_razor.ErrorChangingUserName;
		// 	return;
		// }

		await SignInManager.RefreshSignInAsync(user);
		_message = ConfirmEmailChange_razor.ThankYouForConfirming;
	}
}
