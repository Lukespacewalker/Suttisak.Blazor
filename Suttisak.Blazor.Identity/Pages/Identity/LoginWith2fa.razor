@typeparam TUser where TUser : class

@using System.ComponentModel.DataAnnotations

@inject SignInManager<TUser> SignInManager
@inject UserManager<TUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa<TUser>> Logger

<PageTitle>@LoginWith2fa_razor.PageTitle</PageTitle>

<IdentityFlowPanel Title="@LoginWith2fa_razor.Header" Description="@LoginWith2fa_razor.InfoMessage">
@if (_user is not null)
{
    <StatusMessage Message="@_message" />
    <FormGrid Columns="1">
        <div>
            <EditForm Model="Input" FormName="@SignInFormName" OnValidSubmit="OnValidSubmitAsync" method="post">
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <input type="hidden" name="RememberMe" value="@RememberMe" />
                <DataAnnotationsValidator />
                <FormValidationSummary class="text-danger" role="alert" />
                <AppTextBox Name="Input.TwoFactorCode" @bind-Value="Input!.TwoFactorCode" class="form-control" AutoComplete="one-time-code" inputmode="numeric" Label="@LoginWith2fa_razor.AuthenticatorCodeLabel" Style="width: 100%;" />
                <AppCheckbox Name="Input.RememberMachine" @bind-Value="Input!.RememberMachine" Label="@LoginWith2fa_razor.RememberMachineLabel" Style="width: 100%;" />
                <AppButton Type="submit" Variant="AppButtonVariant.Primary" Style="width: 100%;">@LoginWith2fa_razor.LoginButton</AppButton>
            </EditForm>
        </div>
    </FormGrid>
    <p>
        @LoginWith2fa_razor.NoAccessText
        <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl">@LoginWith2fa_razor.RecoveryCodeLink</a>.
    </p>
}
else if (IsPost)
{
    @* A pending challenge can expire between rendering the form and posting it. *@
    <form @formname="@SignInFormName" @onsubmit="RedirectToLogin" method="post" hidden>
        <AntiforgeryToken />
    </form>
}
</IdentityFlowPanel>

@code {
    private const string SignInFormName = "sign-in-with-authenticator";
    private string? _message;
    private TUser? _user;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsPost => HttpContext is not null && HttpMethods.IsPost(HttpContext.Request.Method);

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Ensure the user has gone through the username & password screen first
        _user = await SignInManager.GetTwoFactorAuthenticationUserAsync();
        if (_user is null && !IsPost)
        {
            RedirectToLogin();
        }
    }

    private void RedirectToLogin() =>
        RedirectManager.RedirectTo("Account/Login", new() { ["ReturnUrl"] = ReturnUrl });

    private async Task OnValidSubmitAsync()
    {
        if (_user is null)
        {
            return;
        }

        var authenticatorCode = Input!.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(_user);

        if (result.Succeeded)
        {
            Logger.LogInformation("User with ID '{UserId}' logged in with 2fa.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User with ID '{UserId}' account locked out.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Invalid authenticator code entered for user with ID '{UserId}'.", userId);
            _message = LoginWith2fa_razor.ErrorInvalidCode;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(7, ErrorMessageResourceType = typeof(LoginWith2fa_razor), ErrorMessageResourceName = nameof(LoginWith2fa_razor.ValidationMessage), MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Authenticator code")]
        public string? TwoFactorCode
        {
            get => field;
            set => field = value?.Trim();
        }

        [Display(Name = "Remember this machine")]
        public bool RememberMachine { get; set; }
    }
}
