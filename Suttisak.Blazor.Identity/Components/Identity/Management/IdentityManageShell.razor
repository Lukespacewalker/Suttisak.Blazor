@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Localization
@using Suttisak.Blazor.Identity.Pages.Identity.Manage
@using Suttisak.Blazor.UserInterface.Components.Navigation
@using Suttisak.Blazor.UserInterface.Layouts
@inject IStringLocalizer<IdentityManageShell> Text

<PageBreadcrumbs Items="@BreadcrumbItems" />

<SectionContent SectionName="@CommonSections.PageTitle">
    <PageHeading SectionTitle="@Text["AccountCenter"]"
                 SectionDescription="@Text["AccountCenterCaption"]"
                 SectionIconName="PersonCircle"
                 SectionActions="@SectionActions"
                 Title="@Title"
                 Description="@Description"
                 IconName="@IconName"
                 IconSize="@IconSize"
                 PageActions="@PageActions">
        <Navigation>
            <SectionNavigation AriaLabel="@Text["AccountNavigation"]"
                               CurrentSectionLabel="@CurrentSectionLabel"
                               MobileLabel="@Text["AccountSection"]"
                               OverflowLabel="@Text["More"]"
                               OverflowActive="@OverflowActive"
                               Embedded="true">
                <ChildContent>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.Root"
                                           IconName="Home"
                                           ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.Root)"
                                           Match="NavLinkMatch.All">@Text["Overview"]</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.Profile" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.Profile)" IconName="PersonAccounts">@Manage_razor.Profile</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.Email" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.Email)" IconName="Mail">@Manage_razor.Email</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.ChangePassword" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.ChangePassword)" IconName="Password">@Manage_razor.ChangePassword</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.TwoFactorAuthentication" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.TwoFactorAuthentication)" IconName="KeyMultiple">@Manage_razor.TwoFactorAuthentication</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.Passkeys" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.Passkeys)" IconName="PersonPasskey">@Manage_razor.Passkeys</IdentityManageNavLink>
                </ChildContent>
                <Overflow>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.ExternalLogins" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.ExternalLogins)" IconName="GlobeSurface">@Manage_razor.ExternalLogins</IdentityManageNavLink>
                    <IdentityManageNavLink Href="@IdentityRoutes.Account.Manage.PersonalData" ForceActive="@(ActiveUrl == IdentityRoutes.Account.Manage.PersonalData)" IconName="DatabasePerson">@Manage_razor.PersonalData</IdentityManageNavLink>
                </Overflow>
            </SectionNavigation>
        </Navigation>
    </PageHeading>
</SectionContent>

<div class="identity-manage-shell">
    @if (UiSlots?.AccountHelp is not null)
    {
        <aside class="identity-manage-nav__help">
            @UiSlots.AccountHelp
        </aside>
    }

    <main class="identity-manage-content" id="identity-manage-content" aria-label="@Title">
        <div class="identity-manage-content__body">@ChildContent</div>
    </main>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ActiveUrl { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public int IconSize { get; set; } = 20;
    [Parameter] public IEnumerable<Breadcrumb> BreadcrumbItems { get; set; } = Array.Empty<Breadcrumb>();
    [Parameter] public RenderFragment? SectionActions { get; set; }
    [Parameter] public RenderFragment? PageActions { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    [CascadingParameter] private IdentityUiSlots? UiSlots { get; set; }

    private bool OverflowActive => ActiveUrl is not null
        && (ActiveUrl == IdentityRoutes.Account.Manage.ExternalLogins
            || ActiveUrl == IdentityRoutes.Account.Manage.PersonalData);

    private string CurrentSectionLabel => ActiveUrl switch
    {
        var route when route == IdentityRoutes.Account.Manage.Profile => Manage_razor.Profile,
        var route when route == IdentityRoutes.Account.Manage.Email => Manage_razor.Email,
        var route when route == IdentityRoutes.Account.Manage.ChangePassword => Manage_razor.ChangePassword,
        var route when route == IdentityRoutes.Account.Manage.TwoFactorAuthentication => Manage_razor.TwoFactorAuthentication,
        var route when route == IdentityRoutes.Account.Manage.Passkeys => Manage_razor.Passkeys,
        var route when route == IdentityRoutes.Account.Manage.ExternalLogins => Manage_razor.ExternalLogins,
        var route when route == IdentityRoutes.Account.Manage.PersonalData => Manage_razor.PersonalData,
        _ => Text["Overview"]
    };
}
