@using Microsoft.AspNetCore.Components.Routing

<NavLink href="@Href" Match="@Match" class="@CssClass">
    <FluentIcon Value="@Icon" aria-hidden="true" />
    <span>@ChildContent</span>
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Icon Icon { get; set; } = default!;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public bool ForceActive { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private string CssClass => $"identity-manage-nav-link {(ForceActive ? "active" : null)}".Trim();
}
