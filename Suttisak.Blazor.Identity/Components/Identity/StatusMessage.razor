@using Microsoft.AspNetCore.Http

@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusMessageTitle = EffectiveIntent switch
    {
        FeedbackIntent.Error => StatusMessage_razor.Error,
        FeedbackIntent.Success => StatusMessage_razor.Success,
        _ => null
    };

    <FeedbackBanner Intent="@EffectiveIntent" Title="@statusMessageTitle" CssClass="margin-bottom">
        @DisplayMessage
    </FeedbackBanner>
}

@code {
    private string? _messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public FeedbackIntent? Intent { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private string? DisplayMessage => Message ?? _messageFromCookie;
    private FeedbackIntent EffectiveIntent => Intent ?? (DisplayMessage?.StartsWith("Error") is true ? FeedbackIntent.Error : FeedbackIntent.Success);

    protected override void OnInitialized()
    {
        _messageFromCookie = HttpContext.Request.Cookies["Identity.StatusMessage"];

        if (_messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete("Identity.StatusMessage");
        }
    }
}
