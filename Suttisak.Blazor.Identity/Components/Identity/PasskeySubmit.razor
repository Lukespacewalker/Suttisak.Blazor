@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@inject IAntiforgery Antiforgery

<FluentButton IconStart="@(new Icons.Regular.Size20.PersonPasskey())" Type="ButtonType.Submit" Name="__passkeySubmit" @attributes="AdditionalAttributes">@ChildContent</FluentButton>
<passkey-submit
    operation="@Operation"
    name="@Name"
    email-name="@EmailName"
    request-token-name="@_tokens?.HeaderName"
    request-token-value="@_tokens?.RequestToken">
</passkey-submit>

@code {
    private AntiforgeryTokenSet? _tokens;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public PasskeyOperation Operation { get; set; }

    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = null!;

    [Parameter]
    public string? EmailName { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _tokens = Antiforgery?.GetTokens(HttpContext);
    }
}
