@typeparam TUser where TUser : class
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity

@inject SignInManager<TUser> SignInManager

@if (_externalLogins.Length > 0)
{
	<form class="form-horizontal" action="@IdentityRoutes.Api.PerformExternalLogin" method="post">
		<div>
			<AntiforgeryToken />
			<input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
			@foreach (var provider in _externalLogins)
			{
				<FluentButton IconStart="@_providerIcons.GetValueOrDefault(provider.Name)" Type="ButtonType.Submit" Name="provider" Value="@provider.Name" Title="@string.Format(ExternalLoginPicker_razor.LoginTitle, provider.DisplayName)">@provider.DisplayName</FluentButton>
				<text>&nbsp;</text>
			}
		</div>
	</form>
}

@code {
	private AuthenticationScheme[] _externalLogins = [];

	private Dictionary<string, Icon> _providerIcons = null!;
	 
	protected override void OnInitialized()
	{
		base.OnInitialized();
		_providerIcons = new()
		{
			{"Microsoft", Icon.FromImageUrl(Assets["./images/icons/icons8-microsoft-50.png"])},
			{"Google", Icon.FromImageUrl(Assets["./images/icons/icons8-google-45.png"])},
			{"Facebook", Icon.FromImageUrl(Assets["./images/icons/icons8-facebook-48.png"])},
			{"X", Icon.FromImageUrl(Assets["./images/icons/icons8-x-48.png"])}
		};
	}

	[SupplyParameterFromQuery]
	private string? ReturnUrl { get; set; }

	protected override async Task OnInitializedAsync()
	{
		_externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
	}
}
