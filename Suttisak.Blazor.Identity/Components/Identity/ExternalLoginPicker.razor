@typeparam TUser where TUser : class
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity

@inject SignInManager<TUser> SignInManager

@if (_externalLogins.Length > 0)
{
	<form class="form-horizontal" action="@IdentityRoutes.Api.PerformExternalLogin" method="post">
		<div>
			<AntiforgeryToken />
			<input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
			@foreach (var provider in _externalLogins)
			{
				<div class="external-login-option">
					<AppButton Type="ButtonType.Submit" Name="provider" Value="@provider.Name" Title="@string.Format(ExternalLoginPicker_razor.LoginTitle, provider.DisplayName)">
						<img slot="start" style="width:20px" src="@_providerIcons.GetValueOrDefault(provider.Name)?"/>
						@provider.DisplayName
					</AppButton>
					@if (ProviderDescriptions?.GetValueOrDefault(provider.Name) is { } description)
					{
						<span class="external-login-description">@description</span>
					}
				</div>
			}
		</div>
	</form>
}

@code {
	private AuthenticationScheme[] _externalLogins = [];

	private Dictionary<string, string> _providerIcons = null!;
	 
	protected override void OnInitialized()
	{
		base.OnInitialized();
		_providerIcons = new()
		{
			{"Microsoft", Assets["/_content/Suttisak.Blazor.Identity/images/icons/icons8-microsoft-50.webp"]},
			{"Google", Assets["/_content/Suttisak.Blazor.Identity/images/icons/icons8-google-48.webp"]},
			{"Facebook", Assets["/_content/Suttisak.Blazor.Identity/images/icons/icons8-facebook-48.webp"]},
			{"X", Assets["/_content/Suttisak.Blazor.Identity/images/icons/icons8-x-48.webp"]}
		};
	}

	[SupplyParameterFromQuery]
	private string? ReturnUrl { get; set; }

	[Parameter]
	public IReadOnlyDictionary<string, string>? ProviderDescriptions { get; set; }

	protected override async Task OnInitializedAsync()
	{
		_externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
	}
}
