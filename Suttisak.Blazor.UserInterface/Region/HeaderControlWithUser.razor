@using Suttisak.Blazor.UserInterface.Components
@using Suttisak.Blazor.UserInterface.Helper
@inject NavigationManager NavigationManager

<CultureSelector />
<FluentSpacer Width="6px" />
<ThemeSelector />
<FluentSpacer Width="6px" />
<AuthorizeView>
	<Authorized>
		<ProfileMenu LoginText="@LoginText" LogoutText="@LogoutText" />
	</Authorized>
	<NotAuthorized>
		<FluentButton IconStart="@(new Icons.Regular.Size24.Key())"
					  Appearance="ButtonAppearance.Primary"
					  OnClick="@(() => NavigationManager.NavigateTo(LoginUrl))">
			@Helper.TryGetCustomStringThenFallbackToResource(LoginText, ProfileMenu_razor.Login)
		</FluentButton>
	</NotAuthorized>
</AuthorizeView>

@code {
	[Parameter] public string LoginUrl { get; set; } = string.Empty;

	[Parameter] public string? LoginText { get; set; }

	[Parameter] public string? LogoutText { get; set; }
}
