<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>Suttisak's Blazor User Interface Components</Title>
		<Copyright>Suttisak Denduangchai</Copyright>
		<Description>A collection of useful components for Blazor</Description>
		<RepositoryUrl>https://github.com/Lukespacewalker/Suttisak.Blazor</RepositoryUrl>
		<AssemblyVersion>0.2.34</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<Version>$(AssemblyVersion)</Version>
		<StaticWebAssetsEnabled>True</StaticWebAssetsEnabled>

		<DebugType>Embedded</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0-rc.4-26180.1" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0-rc.4-26180.1" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Components\ProfileMenu.razor.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>ProfileMenu.razor.resx</DependentUpon>
		</Compile>
		<Compile Update="Localizations\CommonStrings.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>CommonStrings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Components\ProfileMenu.razor.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		  <LastGenOutput>ProfileMenu.razor.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localizations\CommonStrings.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		  <LastGenOutput>CommonStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>


</Project>
