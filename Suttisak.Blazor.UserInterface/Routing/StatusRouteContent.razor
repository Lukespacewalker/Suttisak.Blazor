@using Microsoft.Extensions.Options
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@StatusCode · @Content.Title</PageTitle>

<StatusPage Code="@StatusCode.ToString()"
            Variant="@PageVariant"
            Eyebrow="@Content.Eyebrow"
            Title="@Content.Title"
            Description="@Content.Message"
            SupplementaryContent="@RequestReference">
    <BrandContent>
        <div class="status-page__route-brand">
            @if (!string.IsNullOrWhiteSpace(ActiveOptions.LogoUrl))
            {
                <AppLogo AssetPath="@ActiveOptions.LogoUrl" />
            }
            <strong>@ActiveOptions.BrandName</strong>
            <span>Service status / @StatusCode</span>
        </div>
    </BrandContent>
    <Actions>
        @if (Content.RetryPrimaryAction)
        {
            <button class="status-page__primary" type="button" @onclick="Retry">@Content.PrimaryActionLabel</button>
        }
        else
        {
            <a class="status-page__primary" href="@PrimaryHref">@Content.PrimaryActionLabel</a>
        }

        @if (!string.IsNullOrWhiteSpace(Content.SecondaryActionLabel))
        {
            <a class="status-page__secondary" href="@SecondaryHref">@Content.SecondaryActionLabel</a>
        }
    </Actions>
    <FooterContent>
        <span>@StatusCode / @ActiveOptions.BrandName</span>
        <span>@Content.FooterText</span>
    </FooterContent>
</StatusPage>

@code {
    private readonly StatusRouteOptions _defaults = new();

    [Parameter, EditorRequired] public int StatusCode { get; set; }
    [Parameter] public string? RequestId { get; set; }
    [Parameter] public StatusRouteOptions? Options { get; set; }

    private StatusRouteOptions ActiveOptions => Options ??
        (Services.GetService(typeof(IOptions<StatusRouteOptions>)) is IOptions<StatusRouteOptions> configured
            ? configured.Value
            : _defaults);

    private StatusRoutePageOptions Content => ActiveOptions.Resolve(StatusCode);
    private string PrimaryHref => Content.PrimaryActionHref ?? ActiveOptions.HomeHref;
    private string SecondaryHref => Content.SecondaryActionHref ?? ActiveOptions.HomeHref;
    private StatusPageVariant PageVariant => StatusCode switch
    {
        403 => StatusPageVariant.Forbidden,
        404 => StatusPageVariant.Missing,
        >= 500 => StatusPageVariant.Error,
        _ => StatusPageVariant.Status
    };

    private RenderFragment? RequestReference => ActiveOptions.ShowRequestId && !string.IsNullOrWhiteSpace(RequestId)
        ? builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "status-page__reference");
            builder.OpenElement(2, "span");
            builder.AddContent(3, ActiveOptions.RequestIdLabel);
            builder.CloseElement();
            builder.OpenElement(4, "code");
            builder.AddContent(5, RequestId);
            builder.CloseElement();
            builder.CloseElement();
        }
        : null;

    private void Retry() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
