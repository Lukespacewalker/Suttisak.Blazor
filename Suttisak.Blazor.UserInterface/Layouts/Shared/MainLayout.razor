@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@using Suttisak.Blazor.UserInterface.Models
@using Suttisak.Blazor.UserInterface.Interfaces
@using Microsoft.AspNetCore.Components.Routing
@layout RootLayout
@using Suttisak.Blazor.UserInterface.Components.Navigation
@implements IBreadcrumbLayout
@implements IDisposable
@inject IOptions<BlazorUIOptions> GlobalDesign
@inject NavigationManager NavigationManager
@inherits LayoutComponentBase

<CascadingValue Value="this">
    <ApplicationShell BreadcrumbLabel="@GlobalDesign.Value.BreadcrumbLabel"
                      SkipLinkText="@GlobalDesign.Value.SkipLinkText">
        <Header>
            <div class="app-shell-header">
                <LayoutMobileMenuButtonWrapper @rendermode="HeaderRenderMode"/>
                <img src="@GlobalDesign.Value.LogoAssetPath"
                     class="app-shell-header__logo"
                     alt="" />
                <div class="app-shell-header__title"><SectionOutlet SectionId="HeaderSection"/></div>
                <FluentSpacer />
                <HeaderControlWithUser LoginUrl="@GlobalDesign.Value.LoginUrl"
                                       ProfileImageUrl="@GlobalDesign.Value.ProfileImageUrl"
                                       CompactOnMobile="true"
                                       @rendermode="HeaderRenderMode"/>
            </div>
        </Header>
        <Navigation><SectionOutlet SectionId="NavigationSection"/></Navigation>
        <Feedback><SectionOutlet SectionId="MessageBarSection"/></Feedback>
        <Breadcrumbs>
            @if (_breadcrumbs.Length > 0)
            {
                <AppBreadcrumb Items="@_breadcrumbs" />
            }
        </Breadcrumbs>
        <Heading><SectionOutlet SectionName="@CommonSections.PageTitle"/></Heading>
        <ChildContent>@Body</ChildContent>
    </ApplicationShell>
</CascadingValue>
@code {
    [Obsolete("Use the PageBreadcrumbs component. Breadcrumb rendering is owned by MainLayout.")]
    public static object BreadcrumbSection = new();
    public static object HeaderSection = new();
    public static object NavigationSection = new();
    public static object MessageBarSection = new();

    [CascadingParameter] public NavComponentState? NavState { get; set; }

    private Breadcrumb[] _breadcrumbs = Array.Empty<Breadcrumb>();

    public virtual IComponentRenderMode? HeaderRenderMode { get; set; }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        base.OnInitialized();
    }

    public void PopulateBreadcrumbs(params IEnumerable<Breadcrumb> breadcrumbs)
    {
        var next = breadcrumbs.ToArray();
        if (BreadcrumbsMatch(_breadcrumbs, next))
        {
            return;
        }

        _breadcrumbs = next;
        StateHasChanged();
    }

    private static bool BreadcrumbsMatch(IReadOnlyList<Breadcrumb> current, IReadOnlyList<Breadcrumb> next)
    {
        if (current.Count != next.Count)
        {
            return false;
        }

        for (var index = 0; index < current.Count; index++)
        {
            if (!string.Equals(current[index].Title, next[index].Title, StringComparison.Ordinal)
                || !string.Equals(current[index].Url, next[index].Url, StringComparison.Ordinal)
                || current[index].Icon?.GetType() != next[index].Icon?.GetType())
            {
                return false;
            }
        }

        return true;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _breadcrumbs = Array.Empty<Breadcrumb>();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
