@if (LoginPresentation)
{
    <div class="access-login-layout">
    <main class="access-login-page">
        <section class="access-login-panel" aria-labelledby="@HeadingId">
            @if (Controls is not null || HeaderActions is not null)
            {
                <div class="access-login-topbar">
                    @Controls
                    @HeaderActions
                </div>
            }
            <div class="access-login-card">
                <header class="access-login-heading">
                    @if (Brand is not null) { <div class="access-login-brand">@Brand</div> }
                    @if (Kicker is not null) { <p class="access-login-kicker">@Kicker</p> }
                    <h1 id="@HeadingId">@Title</h1>
                    @if (Intro is not null) { <div class="access-login-intro">@Intro</div> }
                </header>
                <div class="access-login-body">@ChildContent</div>
            </div>
            @if (SupportingContent is not null) { <div class="access-login-support">@SupportingContent</div> }
            @if (Footer is not null) { <div class="access-login-footer">@Footer</div> }
        </section>
        <aside class="access-login-showcase" aria-label="@ShowcaseLabel">
            @if (ShowcaseBrand is not null)
            {
                <div class="access-login-showcase-brand">@ShowcaseBrand</div>
            }
            <div class="access-login-showcase-content">@Showcase</div>
        </aside>
    </main>
    </div>
}
else
{
<section class="access-page-layout">
    <div class="access-page-layout__background" aria-hidden="true"></div>
    <main class="access-page-layout__grid">
        <div class="access-page-layout__card">
            @if (Controls is not null)
            {
                <div class="access-page-layout__controls" aria-label="Display preferences">@Controls</div>
            }

            <header class="access-page-layout__header">
                @if (Brand is not null)
                {
                    <div class="access-page-layout__brand">@Brand</div>
                }
                <div class="access-page-layout__heading">
                    @if (Kicker is not null) { <p class="access-page-layout__kicker">@Kicker</p> }
                    <h1 id="@HeadingId">@Title</h1>
                    @if (Intro is not null) { <div class="access-page-layout__intro">@Intro</div> }
                </div>
            </header>

            <div class="access-page-layout__body">@ChildContent</div>
        </div>

        <aside class="access-page-layout__showcase" aria-label="@ShowcaseLabel">
            <div class="access-page-layout__showcase-grid" aria-hidden="true"></div>
            <div class="access-page-layout__showcase-orb access-page-layout__showcase-orb--primary" aria-hidden="true"></div>
            <div class="access-page-layout__showcase-orb access-page-layout__showcase-orb--secondary" aria-hidden="true"></div>
            <div class="access-page-layout__showcase-content">@Showcase</div>
        </aside>
    </main>
</section>
}

@code {
    [Parameter] public bool LoginPresentation { get; set; }
    [Parameter] public RenderFragment? ShowcaseBrand { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? SupportingContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? Brand { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter] public RenderFragment? Kicker { get; set; }
    [Parameter, EditorRequired] public RenderFragment Title { get; set; } = default!;
    [Parameter] public RenderFragment? Intro { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment Showcase { get; set; } = default!;
    [Parameter] public string HeadingId { get; set; } = "access-page-title";
    [Parameter] public string ShowcaseLabel { get; set; } = "Account access information";
}
