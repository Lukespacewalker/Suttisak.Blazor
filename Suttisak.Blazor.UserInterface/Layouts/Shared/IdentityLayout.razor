@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@using Suttisak.Blazor.UserInterface.Components
@layout RootLayout
@inject IOptions<BlazorUIOptions> GlobalDesign
@inherits LayoutComponentBase

<CascadingValue Value="this">
    <AccessPageLayout>
        <Brand><SectionOutlet SectionId="CardEyebrowSection" /></Brand>
        <Controls>
            <CultureSelector @rendermode="HeaderRenderMode" />
            <ThemeSelector @rendermode="HeaderRenderMode" />
        </Controls>
        <Kicker><SectionOutlet SectionId="CardKickerSection" /></Kicker>
        <Title><SectionOutlet SectionId="CardTitleSection" /></Title>
        <Intro><SectionOutlet SectionId="CardIntroSection" /></Intro>
        <ChildContent>@Body</ChildContent>
        <Showcase><SectionOutlet SectionId="ShowcaseSection" /></Showcase>
    </AccessPageLayout>
</CascadingValue>
@code {
	public static object ShowcaseSection = new();
	public static object CardEyebrowSection = new();
	public static object CardKickerSection = new();
	public static object CardTitleSection = new();
	public static object CardIntroSection = new();

	public virtual IComponentRenderMode? HeaderRenderMode { get; set; }
}
