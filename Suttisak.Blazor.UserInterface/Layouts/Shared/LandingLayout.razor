@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop

@layout RootLayout
@inject IOptions<BlazorUIOptions> GlobalDesign
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<CascadingValue Value="this">
    <div class="root" style="position:relative">
        <FluentLayout>
            <FluentHeader>
                <img src="@GlobalDesign.Value.LogoAssetPath" 
                     style="width:2rem; height:2rem;margin-right:0.5rem;" />
                <SectionOutlet SectionId="HeaderSection" />
                <FluentSpacer />
                <HeaderControlWithUser LoginUrl="@GlobalDesign.Value.LoginUrl"
                                       @rendermode="HeaderRenderMode" />
            </FluentHeader>
            <FluentBodyContent>
                <FluentStack Class="main" 
                             Orientation="Orientation.Horizontal" 
                             Width="100%" HorizontalGap="0" VerticalGap="0">
                    <div class="content" style="padding:unset;">
                        @Body
                    </div>
                </FluentStack>
            </FluentBodyContent>
        </FluentLayout>
    </div>
</CascadingValue>

@code {
    public static object HeaderSection = new();

    public virtual IComponentRenderMode? HeaderRenderMode { get; set; }

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Suttisak.Blazor.UserInterface/Layouts/Shared/MainLayout.razor.js");
            // use query selectors for flexible target element query
            await _module.InvokeVoidAsync("initScrollObserver", "header.header", ".main-stack");
        }
    }
}