@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@layout RootLayout
@inject IOptions<BlazorUIOptions> GlobalDesign
@inherits LayoutComponentBase
<CascadingValue Value="this">
    <div class="landing-layout">
        <header class="landing-layout__header">
            <div class="landing-layout__header-inner">
                <a class="landing-layout__brand" href="/" aria-label="Home">
                    <AppLogo AssetPath="@GlobalDesign.Value.LogoAssetPath" ChildContent="@LogoContent" />
                    <strong><SectionOutlet SectionId="HeaderSection" /></strong>
                </a>
                <nav class="landing-layout__navigation" aria-label="Landing page sections">
                    <SectionOutlet SectionId="NavigationSection" />
                </nav>
                <HeaderControlWithUser LoginUrl="@GlobalDesign.Value.LoginUrl"
                                       ProfileImageUrl="@GlobalDesign.Value.ProfileImageUrl"
                                       @rendermode="HeaderRenderMode" />
            </div>
        </header>
        <div class="landing-page-content">
            @Body
        </div>
    </div>
</CascadingValue>
@code {
    public static object HeaderSection = new();
    public static object NavigationSection = new();

    /// <summary>Allows an application-owned layout to provide fingerprinted logo markup.</summary>
    protected virtual RenderFragment? LogoContent => null;

    public virtual IComponentRenderMode? HeaderRenderMode { get; set; }
}
