@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@layout RootLayout
@inject IOptions<BlazorUIOptions> GlobalDesign
@inherits LayoutComponentBase

<CascadingValue Value="this">
    <div class="root" style="position:relative">
        <div class="header-footer-shell">
            <header class="header-footer-header">
                <AppLogo AssetPath="@GlobalDesign.Value.LogoAssetPath"
                         Class="header-footer-logo"
                         ChildContent="@LogoContent" />
                <SectionOutlet SectionId="HeaderSection" />
                <span class="header-footer-spacer" aria-hidden="true"></span>
                <HeaderControlWithUser LoginUrl="@GlobalDesign.Value.LoginUrl"
                                       ProfileImageUrl="@GlobalDesign.Value.ProfileImageUrl"
                                       @rendermode="HeaderRenderMode" />
            </header>
            <main class="header-footer-content">
                @Body
            </main>
        </div>
    </div>
</CascadingValue>
@code {
    public static object HeaderSection = new();

    /// <summary>Allows an application-owned layout to provide fingerprinted logo markup.</summary>
    protected virtual RenderFragment? LogoContent => null;

    public virtual IComponentRenderMode? HeaderRenderMode { get; set; }
}
