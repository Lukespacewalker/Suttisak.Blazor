@using Microsoft.AspNetCore.Components.Sections

<a class="app-shell__skip-link" href="#@MainContentId">@SkipLinkText</a>

<div class="app-shell">
    <div class="app-shell__background" aria-hidden="true">
        <div class="app-shell__orb app-shell__orb--primary"></div>
        <div class="app-shell__orb app-shell__orb--secondary"></div>
    </div>

    <FluentLayout Class="app-shell__layout" GlobalScrollbar="true">
        <FluentLayoutItem Area="LayoutArea.Header" Class="app-shell__header" Sticky="true">
            @Header
        </FluentLayoutItem>

        <FluentLayoutItem Area="LayoutArea.Content" Class="app-shell__content">
            <FluentStack Class="app-shell__main"
                         Orientation="Orientation.Horizontal"
                         Width="100%"
                         HorizontalGap="0"
                         VerticalGap="0">
                @Navigation

                <main id="@MainContentId" class="app-page" tabindex="-1">
                    @if (Feedback is not null)
                    {
                        <div class="app-page__feedback">@Feedback</div>
                    }
                    @if (Breadcrumbs is not null || Heading is not null)
                    {
                        <div class="app-page__intro">
                            @if (Breadcrumbs is not null)
                            {
                                <nav class="app-page__breadcrumbs" aria-label="@BreadcrumbLabel">
                                    @Breadcrumbs
                                </nav>
                            }
                            @if (Heading is not null)
                            {
                                <header class="app-page__heading">@Heading</header>
                            }
                        </div>
                    }
                    <div class="app-page__body">@ChildContent</div>
                </main>
            </FluentStack>
        </FluentLayoutItem>
    </FluentLayout>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment Header { get; set; } = default!;
    [Parameter] public RenderFragment? Navigation { get; set; }
    [Parameter] public RenderFragment? Feedback { get; set; }
    [Parameter] public RenderFragment? Breadcrumbs { get; set; }
    [Parameter] public RenderFragment? Heading { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string MainContentId { get; set; } = "app-main-content";
    [Parameter] public string SkipLinkText { get; set; } = "Skip to main content";
    [Parameter] public string BreadcrumbLabel { get; set; } = "Breadcrumb";
}
