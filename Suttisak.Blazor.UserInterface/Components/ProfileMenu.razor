@using Suttisak.Blazor.UserInterface.Helper
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div style="display:flex;flex-direction:row;gap:0.5rem;align-items:center;">
	<AuthorizeView>
		<Authorized>
			<details style="position:relative;">
				<summary style="list-style:none;cursor:pointer;display:flex;align-items:center;">
					<FluentButton Appearance="ButtonAppearance.Transparent" 
								  IconStart="@(new Icons.Regular.Size20.PersonCircle())"
								  IconEnd="@(new Icons.Regular.Size20.ChevronDown())">
						@_initial
					</FluentButton>
				</summary>
				<div class="glass-card" style="position:absolute;right:0;top:calc(100% + 0.5rem);min-width:18rem;padding:1rem;z-index:1000;">
					<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
						<FluentLabel Style="font-weight:600;">@_username</FluentLabel>
						<FluentButton Appearance="ButtonAppearance.Transparent"
								  Style="justify-content:flex-start;"
								  IconStart="@(new Icons.Regular.Size20.PersonAccounts())"
								  OnClick="NavigateToManageAccount">
							@ProfileMenu_razor.ManageAccount
						</FluentButton>
						<FluentButton Appearance="ButtonAppearance.Transparent"
								  Style="justify-content:flex-start;"
								  IconStart="@(new Icons.Regular.Size20.SignOut())"
								  OnClick="Logout">
							@Helper.TryGetCustomStringThenFallbackToResource(LogoutText, ProfileMenu_razor.Logout)
						</FluentButton>
					</FluentStack>
				</div>
			</details>
		</Authorized>
		<NotAuthorized>
			<FluentNavItem Href="Account/Login" >@Helper.TryGetCustomStringThenFallbackToResource(LoginText, ProfileMenu_razor.Login) </FluentNavItem>
		</NotAuthorized>
	</AuthorizeView>
</div>
@code {

	private string? _username;
	private string _initial = string.Empty;

	[Parameter] public string? LoginText { get; set; }
	[Parameter] public string? LogoutText { get; set; }

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		if (authState.User.Identity?.IsAuthenticated ?? false)
		{
			_username = authState.User.Identity.Name;

			_initial = _username switch
			{
				null or "" => string.Empty,
				{ Length: 1 } value => value,
				_ => _username[..2]
			};
		}

		await base.OnInitializedAsync();
	}

	private void NavigateToManageAccount()
	{
		NavigationManager.NavigateTo("Account/Manage");
	}

	private void Logout()
	{
		NavigationManager.NavigateTo("Account/Logout?ReturnUrl=", forceLoad: true);
	}
}
