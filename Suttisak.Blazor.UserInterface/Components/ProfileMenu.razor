@using Suttisak.Blazor.UserInterface.Helper
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="profile-menu-control">
    <AuthorizeView>
        <Authorized>
            <details class="profile-menu">
                <summary aria-label="Open profile menu">
                    @if (!string.IsNullOrWhiteSpace(ProfileImageUrl))
                    {
                        <img class="profile-menu__avatar" src="@ProfileImageUrl" alt="" aria-hidden="true" />
                    }
                    else
                    {
                        <span class="profile-menu__avatar" aria-hidden="true">@Initials</span>
                    }
                    <strong>@DisplayName</strong>
                    <svg class="profile-menu__chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </summary>
                <div class="profile-menu__panel">
                    <div class="profile-menu__identity">
                        <span class="profile-menu__avatar" aria-hidden="true">@Initials</span>
                        <p><strong>@DisplayName</strong><small>Signed in</small></p>
                    </div>
                    <button type="button" @onclick="NavigateToManageAccount">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M5 20c.6-4 3-6 7-6s6.4 2 7 6" /></svg>
                        <span>@ProfileMenu_razor.ManageAccount</span>
                    </button>
                    <button type="button" @onclick="Logout">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10" /></svg>
                        <span>@Helper.TryGetCustomStringThenFallbackToResource(LogoutText, ProfileMenu_razor.Logout)</span>
                    </button>
                </div>
            </details>
        </Authorized>
        <NotAuthorized>
            <a class="profile-menu__login" href="Account/Login">@Helper.TryGetCustomStringThenFallbackToResource(LoginText, ProfileMenu_razor.Login)</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string? _username;
    [Parameter] public string? LoginText { get; set; }
    [Parameter] public string? LogoutText { get; set; }
    [Parameter] public string? ProfileImageUrl { get; set; }
    private string DisplayName => string.IsNullOrWhiteSpace(_username) ? "Account" : _username;
    private string Initials => string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(value => char.ToUpperInvariant(value[0])));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
            _username = authState.User.FindFirst("display_name")?.Value ?? authState.User.Identity.Name;
    }

    private void NavigateToManageAccount() => NavigationManager.NavigateTo("Account/Manage");
    private void Logout() => NavigationManager.NavigateTo("Account/Logout?ReturnUrl=", forceLoad: true);
}
