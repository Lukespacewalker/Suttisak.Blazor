@using System.Globalization

<div class="app-form-control @Class"
     data-app-time="popup"
     data-time-minute-step="@Math.Max(1, MinuteStep)"
     data-time-second-step="@Math.Max(1, SecondStep)"
     data-time-include-seconds="@IncludeSeconds.ToString().ToLowerInvariant()"
     data-picker-locale="@Text.Locale"
     data-picker-time-dialog-label="@Text.TimePickerDialogLabel"
     data-picker-choose-time-label="@Text.ChooseTimeLabel"
     data-picker-browser-local-time-label="@Text.BrowserLocalTimeLabel"
     data-picker-hour-label="@Text.HourLabel"
     data-picker-minute-label="@Text.MinuteLabel"
     data-picker-second-label="@Text.SecondLabel"
     data-picker-now-label="@Text.NowLabel"
     data-picker-cancel-label="@Text.CancelLabel"
     data-picker-apply-label="@Text.ApplyLabel"
     @attributes="ContainerAttributes">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="app-form-control__label" for="@InputId">@Label</label>
    }
    <div class="app-form-control__input-wrap app-form-control__input-wrap--has-icon">
        <svg class="app-form-control__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.5 2" />
        </svg>
        <input id="@InputId"
               class="app-form-control__input"
               type="time"
               name="@Name"
               value="@FormattedValue"
               min="@FormattedMin"
               max="@FormattedMax"
               step="@Step"
               required="@Required"
               disabled="@Disabled"
               aria-describedby="@DescriptionId"
               @onchange="HandleChangeAsync"
               @attributes="InputAttributes" />
        <button class="app-form-control__picker-trigger" type="button" data-time-trigger aria-label="@EffectiveOpenTimeLabel" aria-haspopup="dialog" aria-expanded="false" disabled="@Disabled">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <small id="@DescriptionId" class="app-form-control__description">@Description</small>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public TimeOnly? Value { get; set; }
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }
    /// <summary>DateTime-compatible binding for APIs that represent a time with DateTime?.</summary>
    [Parameter] public DateTime? DateTimeValue { get; set; }
    [Parameter] public EventCallback<DateTime?> DateTimeValueChanged { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public TimeOnly? Min { get; set; }
    [Parameter] public TimeOnly? Max { get; set; }
    [Parameter] public DateTime? DateTimeMin { get; set; }
    [Parameter] public DateTime? DateTimeMax { get; set; }
    [Parameter] public int MinuteStep { get; set; } = 1;
    [Parameter] public int SecondStep { get; set; } = 1;
    [Parameter] public bool IncludeSeconds { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Localized text for the popup. Defaults preserve the English UI.</summary>
    [Parameter] public AppPickerText Text { get; set; } = new();
    /// <summary>Overrides <see cref="AppPickerText.OpenTimeLabel"/> for this trigger.</summary>
    [Parameter] public string? OpenTimeLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? ContainerAttributes { get; set; }

    private readonly string _generatedId = $"app-time-{Guid.NewGuid():N}";
    private string InputId => Id ?? _generatedId;
    private string? DescriptionId => string.IsNullOrWhiteSpace(Description) ? null : $"{InputId}-description";
    private string EffectiveOpenTimeLabel => OpenTimeLabel ?? Text.OpenTimeLabel;
    private bool UsesDateTimeValue => DateTimeValueChanged.HasDelegate;
    private string? FormattedValue => UsesDateTimeValue ? Format(DateTimeValue) : Format(Value);
    private string? FormattedMin => UsesDateTimeValue ? Format(DateTimeMin) : Format(Min);
    private string? FormattedMax => UsesDateTimeValue ? Format(DateTimeMax) : Format(Max);
    private int Step => IncludeSeconds ? Math.Max(1, SecondStep) : Math.Max(1, MinuteStep) * 60;
    private string Pattern => IncludeSeconds ? "HH:mm:ss" : "HH:mm";

    private string? Format(TimeOnly? value) => value?.ToString(Pattern, CultureInfo.InvariantCulture);
    private string? Format(DateTime? value) => value?.ToString(Pattern, CultureInfo.InvariantCulture);

    private Task HandleChangeAsync(ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        // Browsers may normalize a time value with seconds even when the visual
        // control only exposes hours and minutes.
        var formats = new[] { "HH:mm:ss", "HH:mm" };
        var value = TimeOnly.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed
            : (TimeOnly?)null;
        var existingDate = DateTimeValue?.Date ?? DateTime.Today;
        return UsesDateTimeValue
            ? DateTimeValueChanged.InvokeAsync(value is null ? null : existingDate.Add(value.Value.ToTimeSpan()))
            : ValueChanged.InvokeAsync(value);
    }
}
