@if (Vertical)
{
    <span class="@CssClass" style="@Style" role="separator" aria-orientation="vertical" @attributes="AdditionalAttributes"></span>
}
else
{
    <hr class="@CssClass" style="@Style" @attributes="AdditionalAttributes" />
}

@code {
    [Parameter] public bool Vertical { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "app-divider" : $"app-divider {Class}";
}
