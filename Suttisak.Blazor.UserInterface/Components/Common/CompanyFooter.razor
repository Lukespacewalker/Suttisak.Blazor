@using System.Reflection

<footer class="company-footer">
    <span>@Prefix</span>
    <a href="@CompanyUrl" target="_blank" rel="noopener noreferrer">@CompanyName</a>
    <span class="company-footer__separator" aria-hidden="true">·</span>
    @if (string.IsNullOrWhiteSpace(CreatorUrl))
    {
        <span>@CreatorName</span>
    }
    else
    {
        <a href="@CreatorUrl" target="_blank" rel="noopener noreferrer">@CreatorName</a>
    }
    @if (!string.IsNullOrWhiteSpace(DisplayedApplicationVersion))
    {
        <span class="company-footer__separator" aria-hidden="true">·</span>
        <span class="company-footer__version">v@(DisplayedApplicationVersion)</span>
    }
</footer>

@code {
    [Parameter] public string Prefix { get; set; } = "Created by";
    [Parameter, EditorRequired] public string CompanyName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CompanyUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CreatorName { get; set; } = string.Empty;
    [Parameter] public string? CreatorUrl { get; set; } = "https://doctortons.com/";
    [Parameter] public string? ApplicationVersion { get; set; }

    private string? DisplayedApplicationVersion => ApplicationVersion ?? GetEntryVersion();

    private static string? GetEntryVersion()
    {
        var assembly = Assembly.GetEntryAssembly();
        return assembly?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion.Split('+')[0] ?? assembly?.GetName().Version?.ToString(3);
    }
}
