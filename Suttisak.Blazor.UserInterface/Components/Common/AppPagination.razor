@implements IDisposable

<nav class="app-pagination" style="@Style" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    @if (SummaryTemplate is not null) { <span class="app-pagination__summary">@SummaryTemplate</span> }
    <button type="button" disabled="@(State.CurrentPageIndex == 0)" @onclick="PreviousAsync">@PreviousLabel</button>
    <label class="app-pagination__page-label">
        <span>Page</span>
        <input type="number" min="1" max="@MaximumPage" style="@NumberFieldStyle"
               value="@(State.CurrentPageIndex + 1)" @onchange="SetPageAsync" />
        <span>of <strong>@MaximumPage</strong></span>
    </label>
    <button type="button" disabled="@(State.LastPageIndex is null || State.CurrentPageIndex >= State.LastPageIndex)" @onclick="NextAsync">@NextLabel</button>
</nav>

@code {
    [Parameter, EditorRequired] public AppGridPaginationState State { get; set; } = null!;
    [Parameter] public RenderFragment? SummaryTemplate { get; set; }
    [Parameter] public EventCallback<int> CurrentPageIndexChanged { get; set; }
    [Parameter] public string NumberFieldStyle { get; set; } = "width: 4.5rem";
    [Parameter] public string AriaLabel { get; set; } = "Pagination";
    [Parameter] public string PreviousLabel { get; set; } = "Previous";
    [Parameter] public string NextLabel { get; set; } = "Next";
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private AppGridPaginationState? _subscribedState;
    private int MaximumPage => Math.Max(1, (State.LastPageIndex ?? 0) + 1);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedState, State)) return;
        if (_subscribedState is not null) _subscribedState.StateChanged -= HandleStateChanged;
        _subscribedState = State;
        _subscribedState.StateChanged += HandleStateChanged;
    }

    private Task PreviousAsync() => SetCurrentPageIndexAsync(State.CurrentPageIndex - 1);
    private Task NextAsync() => SetCurrentPageIndexAsync(State.CurrentPageIndex + 1);
    private async Task SetPageAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var page)) await SetCurrentPageIndexAsync(page - 1);
    }
    private async Task SetCurrentPageIndexAsync(int index)
    {
        await State.SetCurrentPageIndexAsync(index);
        await CurrentPageIndexChanged.InvokeAsync(State.CurrentPageIndex);
    }
    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (_subscribedState is not null) _subscribedState.StateChanged -= HandleStateChanged; }
}
