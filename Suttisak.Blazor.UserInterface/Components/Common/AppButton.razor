@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@CssClassValue"
       href="@(IsDisabled ? null : Href)"
       aria-label="@AriaLabel"
       aria-disabled="@(IsDisabled ? "true" : null)"
       aria-busy="@(IsBusy ? "true" : null)"
       tabindex="@(IsDisabled ? -1 : null)"
       title="@EffectiveTitle"
       style="@ColorStyle"
       @onclick="HandleClickAsync"
       @onclick:preventDefault="@IsDisabled"
       @attributes="EffectiveAttributes">
        @ButtonContent
    </a>
}
else
{
    <button class="@CssClassValue"
            type="@HtmlType"
            aria-label="@AriaLabel"
            aria-busy="@(IsBusy ? "true" : null)"
            title="@EffectiveTitle"
            style="@ColorStyle"
            disabled="@IsDisabled"
            @onclick="HandleClickAsync"
            @attributes="EffectiveAttributes">
        @ButtonContent
    </button>
}

@code {
    [Parameter] public string? IconStartName { get; set; }
    [Parameter] public int IconStartSize { get; set; } = 20;
    [Parameter] public RenderFragment? IconStartContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? IconEndName { get; set; }
    [Parameter] public int IconEndSize { get; set; } = 20;
    [Parameter] public RenderFragment? IconEndContent { get; set; }
    [Parameter] public AppButtonVariant Variant { get; set; } = AppButtonVariant.Secondary;
    [Parameter] public AppButtonSize Size { get; set; } = AppButtonSize.Standard;
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? ToolTip { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private static readonly HashSet<string> DisabledStateAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        "href", "aria-disabled", "aria-busy", "tabindex", "disabled"
    };

    private IEnumerable<KeyValuePair<string, object>>? EffectiveAttributes => IsDisabled
        ? AdditionalAttributes?.Where(attribute => !DisabledStateAttributes.Contains(attribute.Key))
        : AdditionalAttributes;

    private string CssClassValue => string.Join(' ', new[]
    {
        "app-button",
        $"app-button--{EffectiveVariant.ToString().ToLowerInvariant()}",
        $"app-button--{Size.ToString().ToLowerInvariant()}",
        IconOnly ? "app-button--icon-only" : null,
        IsBusy ? "is-busy" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private RenderFragment ButtonContent => @<text>
        @if (IsBusy)
        {
            <span class="app-button__spinner" aria-hidden="true"></span>
        }
        else if (HasStartIcon)
        {
            <span class="app-button__icon">
                @if (IconStartContent is not null)
                {
                    @IconStartContent
                }
                else
                {
                    <Suttisak.Blazor.Icons.Icon Name="@IconStartName" Size="@IconStartSize" />
                }
            </span>
        }

        @if (ChildContent is not null)
        {
            <span class="@(UseChildContentAsIcon ? "app-button__icon" : "app-button__label")">@ChildContent</span>
        }

        @if (!IsBusy && HasEndIcon)
        {
            <span class="app-button__icon">
                @if (IconEndContent is not null)
                {
                    @IconEndContent
                }
                else
                {
                    <Suttisak.Blazor.Icons.Icon Name="@IconEndName" Size="@IconEndSize" />
                }
            </span>
        }
    </text>;

    private Task HandleClickAsync(MouseEventArgs args) =>
        IsDisabled ? Task.CompletedTask : OnClick.InvokeAsync(args);

    private bool IsBusy => Busy || Loading;
    private bool IsDisabled => Disabled || IsBusy;
    private bool HasStartIcon => IconStartContent is not null || !string.IsNullOrWhiteSpace(IconStartName);
    private bool HasEndIcon => IconEndContent is not null || !string.IsNullOrWhiteSpace(IconEndName);
    private bool UseChildContentAsIcon => IconOnly && !IsBusy && !HasStartIcon && !HasEndIcon;
    private string? EffectiveTitle => Title ?? ToolTip;
    private string? ColorStyle => string.IsNullOrWhiteSpace(Color) ? null : $"color:{Color}";
    private string HtmlType => Type.ToLowerInvariant() is "submit" or "reset" ? Type.ToLowerInvariant() : "button";
    private AppButtonVariant EffectiveVariant => Variant;
}
