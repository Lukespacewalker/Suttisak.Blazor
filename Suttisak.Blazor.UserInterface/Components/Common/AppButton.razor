@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@CssClassValue"
       href="@(Disabled ? null : Href)"
       aria-label="@AriaLabel"
       aria-disabled="@(Disabled ? "true" : null)"
       aria-busy="@(IsBusy ? "true" : null)"
       tabindex="@(Disabled ? -1 : null)"
       title="@EffectiveTitle"
       style="@ColorStyle"
       @onclick="HandleClickAsync"
       @onclick:preventDefault="@Disabled"
       @attributes="AdditionalAttributes">
        @ButtonContent
    </a>
}
else
{
    <button class="@CssClassValue"
            type="@HtmlType"
            aria-label="@AriaLabel"
            aria-busy="@(IsBusy ? "true" : null)"
            title="@EffectiveTitle"
            style="@ColorStyle"
            disabled="@(Disabled || IsBusy)"
            @onclick="HandleClickAsync"
            @attributes="AdditionalAttributes">
        @ButtonContent
    </button>
}

@code {
    [Parameter] public string? IconStartName { get; set; }
    [Parameter] public int IconStartSize { get; set; } = 20;
    [Parameter] public RenderFragment? IconStartContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? IconEndName { get; set; }
    [Parameter] public int IconEndSize { get; set; } = 20;
    [Parameter] public RenderFragment? IconEndContent { get; set; }
    [Parameter] public AppButtonVariant Variant { get; set; } = AppButtonVariant.Secondary;
    [Parameter] public AppButtonSize Size { get; set; } = AppButtonSize.Standard;
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? ToolTip { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClassValue => string.Join(' ', new[]
    {
        "app-button",
        $"app-button--{EffectiveVariant.ToString().ToLowerInvariant()}",
        $"app-button--{Size.ToString().ToLowerInvariant()}",
        IconOnly ? "app-button--icon-only" : null,
        IsBusy ? "is-busy" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private RenderFragment ButtonContent => builder =>
    {
        var sequence = 0;
        if (IsBusy)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "app-button__spinner");
            builder.AddAttribute(sequence++, "aria-hidden", "true");
            builder.CloseElement();
        }
        else if (IconStartContent is not null || !string.IsNullOrWhiteSpace(IconStartName))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "app-button__icon");
            if (IconStartContent is not null)
            {
                builder.AddContent(sequence++, IconStartContent);
            }
            else if (!string.IsNullOrWhiteSpace(IconStartName))
            {
                builder.OpenComponent<Suttisak.Blazor.Icons.Icon>(sequence++);
                builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Name), IconStartName);
                builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Size), IconStartSize);
                builder.CloseComponent();
            }
            builder.CloseElement();
        }

        if (ChildContent is not null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "app-button__label");
            builder.AddContent(sequence++, ChildContent);
            builder.CloseElement();
        }

        if (!IsBusy && (IconEndContent is not null || !string.IsNullOrWhiteSpace(IconEndName)))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "app-button__icon");
            if (IconEndContent is not null)
            {
                builder.AddContent(sequence++, IconEndContent);
            }
            else if (!string.IsNullOrWhiteSpace(IconEndName))
            {
                builder.OpenComponent<Suttisak.Blazor.Icons.Icon>(sequence++);
                builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Name), IconEndName);
                builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Size), IconEndSize);
                builder.CloseComponent();
            }
            builder.CloseElement();
        }
    };

    private Task HandleClickAsync(MouseEventArgs args) =>
        Disabled || IsBusy ? Task.CompletedTask : OnClick.InvokeAsync(args);

    private bool IsBusy => Busy || Loading;
    private string? EffectiveTitle => Title ?? ToolTip;
    private string? ColorStyle => string.IsNullOrWhiteSpace(Color) ? null : $"color:{Color}";
    private string HtmlType => Type.ToLowerInvariant() is "submit" or "reset" ? Type.ToLowerInvariant() : "button";
    private AppButtonVariant EffectiveVariant => Variant;
}
