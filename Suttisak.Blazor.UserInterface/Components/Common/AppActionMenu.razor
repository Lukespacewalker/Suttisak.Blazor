<details class="app-action-menu" @attributes="AdditionalAttributes">
    <summary class="app-action-menu__trigger" aria-label="@AriaLabel">
        <span aria-hidden="true">⋯</span>
    </summary>
    <div class="app-action-menu__content">
        @ChildContent
    </div>
</details>

@code {
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "Actions";
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
