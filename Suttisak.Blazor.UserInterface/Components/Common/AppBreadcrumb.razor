@using Suttisak.Blazor.UserInterface.Models
@using Microsoft.FluentUI.AspNetCore.Components

@if (Items is { Count: > 0 })
{
    <nav class="app-breadcrumb" aria-label="Breadcrumb">
        <ol>
            @for (int i = 0; i < Items.Count; i++)
            {
                var item = Items[i];
                bool isLast = i == Items.Count - 1;

                <li class="@(isLast ? "app-breadcrumb-item current" : "app-breadcrumb-item")">
                    @if (!isLast && item.Url is not null)
                    {
                        <a href="@item.Url" class="app-breadcrumb-link">
                            @if (item.Icon is not null)
                            {
                                <FluentIcon Value="@item.Icon" Width="14px" />
                            }
                            <span>@item.TitleKey</span>
                        </a>
                    }
                    else
                    {
                        <span class="app-breadcrumb-current">
                            @if (item.Icon is not null)
                            {
                                <FluentIcon Value="@item.Icon" Width="14px" />
                            }
                            <span>@item.TitleKey</span>
                        </span>
                    }

                    @if (!isLast)
                    {
                        <span class="app-breadcrumb-sep" aria-hidden="true">/</span>
                    }
                </li>
            }
        </ol>
    </nav>
}

@code {
    [Parameter] public List<Breadcrumb>? Items { get; set; }
}
