@using Suttisak.Blazor.UserInterface.Models
@if (_items.Length > 0)
{
    <ol class="@CssClass">
        @for (var index = 0; index < _items.Length; index++)
        {
            var item = _items[index];
            var isCurrent = index == _items.Length - 1;
            var href = isCurrent ? null : item.Url;

            <li class="app-breadcrumb__item">
                <FluentBreadcrumbItem Href="@href" aria-current="@(isCurrent ? "page" : null)">
                    @if (item.Icon is not null)
                    {
                        <FluentIcon Value="@item.Icon" aria-hidden="true" />
                    }
                    <span class="app-breadcrumb__label">@item.Title</span>
                </FluentBreadcrumbItem>
            </li>
        }
    </ol>
}

@code {
    private Breadcrumb[] _items = Array.Empty<Breadcrumb>();

    [Parameter] public IEnumerable<Breadcrumb>? Items { get; set; }
    [Parameter] public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "app-breadcrumb"
        : $"app-breadcrumb {Class}";

    protected override void OnParametersSet()
    {
        _items = Items?.ToArray() ?? Array.Empty<Breadcrumb>();
    }
}
