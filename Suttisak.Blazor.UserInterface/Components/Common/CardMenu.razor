@if (OnClick.HasDelegate)
{
    <button id="@Id"
            class="@ClassValue"
            style="@StyleValue"
            type="button"
            role="@Role"
            aria-label="@AriaLabel"
            disabled="@Disabled"
            @onclick="ClickHandlerAsync"
            @attributes="AdditionalAttributes">
        @MenuContent
    </button>
}
else if (!string.IsNullOrWhiteSpace(Url))
{
    <a id="@Id"
       class="@ClassValue"
       style="@StyleValue"
       href="@(Disabled ? null : Url)"
       role="@Role"
       aria-label="@AriaLabel"
       aria-disabled="@(Disabled ? "true" : null)"
       tabindex="@(Disabled ? -1 : null)"
       @onclick:preventDefault="Disabled"
       @attributes="AdditionalAttributes">
        @MenuContent
    </a>
}
else
{
    <div id="@Id"
         class="@ClassValue"
         style="@StyleValue"
         role="@Role"
         @attributes="AdditionalAttributes">
        @MenuContent
    </div>
}
@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Role { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? IconName { get; set; }
    [Parameter] public int IconSize { get; set; } = 20;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ClassValue => string.Join(' ', new[] { "card-menu", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string? StyleValue => Style;

    private RenderFragment MenuContent => builder =>
    {
        var sequence = 0;
        if (!string.IsNullOrWhiteSpace(IconName))
        {
            builder.OpenComponent<Suttisak.Blazor.Icons.Icon>(sequence++);
            builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Name), IconName);
            builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Size), IconSize);
            builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Style), "flex:0 0 auto");
            builder.CloseComponent();
        }

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "style", "flex:1 1 auto;");
        if (Title is not null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, Title);
            builder.CloseElement();
        }
        if (Subtitle is not null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "subtitle");
            builder.AddContent(sequence++, Subtitle);
            builder.CloseElement();
        }
        builder.AddContent(sequence++, ChildContent);
        builder.CloseElement();

        builder.OpenComponent<Suttisak.Blazor.Icons.Icon>(sequence++);
        builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Name), "ChevronRight");
        builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Size), 20);
        builder.AddAttribute(sequence++, nameof(Suttisak.Blazor.Icons.Icon.Style), "flex:0 0 auto");
        builder.CloseComponent();
    };

    /// <summary />
    internal async Task ClickHandlerAsync(MouseEventArgs args)
    {
        if (!Disabled)
            await OnClick.InvokeAsync(args);
    }
}
