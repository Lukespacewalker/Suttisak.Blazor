@typeparam TGridItem
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="app-quick-grid" style="@Style">
    <QuickGrid TGridItem="TGridItem"
               Items="@Items"
               ItemsProvider="@ItemsProvider"
               Pagination="@Pagination"
               Virtualize="@Virtualize"
               ItemSize="@ItemSize"
               OverscanCount="@OverscanCount"
               ItemKey="@ItemKey"
               RowClass="@RowClass"
               Theme="suttisak"
               Class="@GridClassValue"
               aria-label="@AriaLabel"
               @attributes="AdditionalAttributes">
        @ChildContent
    </QuickGrid>
</div>

@code {
    [Parameter] public IQueryable<TGridItem>? Items { get; set; }
    [Parameter] public Microsoft.AspNetCore.Components.QuickGrid.GridItemsProvider<TGridItem>? ItemsProvider { get; set; }
    [Parameter] public Microsoft.AspNetCore.Components.QuickGrid.PaginationState? Pagination { get; set; }
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public float ItemSize { get; set; } = 44;
    [Parameter] public int OverscanCount { get; set; } = 3;
    [Parameter] public Func<TGridItem, object> ItemKey { get; set; } = item => item!;
    [Parameter] public Func<TGridItem, string?>? RowClass { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string GridClassValue => string.Join(' ', new[] { "app-quick-grid__table", Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override void OnParametersSet()
    {
        if ((Items is null) == (ItemsProvider is null))
        {
            throw new InvalidOperationException(
                $"{nameof(AppQuickGrid<TGridItem>)} requires either {nameof(Items)} or {nameof(ItemsProvider)}, but not both.");
        }

        if (Virtualize && ItemSize <= 0)
        {
            throw new InvalidOperationException($"{nameof(ItemSize)} must be greater than zero when virtualization is enabled.");
        }
    }
}
