@inherits AppInputBase<string?>

<div class="@ContainerClass">
    @if (!string.IsNullOrWhiteSpace(Label)) { <label class="app-form-control__label" for="@InputId">@Label</label> }
    <div class="app-form-control__input-wrap app-form-control__input-wrap--textarea">
        <textarea id="@InputId" class="@InputClass" name="@NameAttributeValue" rows="@Rows"
                  maxlength="@MaxLength" placeholder="@Placeholder" required="@Required" disabled="@Disabled"
                  aria-invalid="@HasValidationError" aria-describedby="@DescribedBy"
                  @oninput="HandleInput" @attributes="AdditionalAttributes">@CurrentValueAsString</textarea>
    </div>
    <div class="app-form-control__meta">
        <AppInputSupport Description="@Description" DescriptionId="@DescriptionId" ValidationMessage="@ValidationMessage" ValidationId="@ValidationId" ShowValidationMessage="@ShowValidationMessage" />
        @if (MaxLength is > 0) { <small class="app-form-control__counter">@((CurrentValue ?? string.Empty).Length) / @MaxLength</small> }
    </div>
</div>

@code {
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    private void HandleInput(ChangeEventArgs args) => CurrentValueAsString = args.Value?.ToString();
    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage) { result = value; validationErrorMessage = null!; return true; }
}
