<div class="app-grid-selection-toolbar @Class" role="toolbar" aria-label="@AriaLabel"
     aria-busy="@(Busy ? "true" : null)" @attributes="AdditionalAttributes">
    <span class="app-grid-selection-toolbar__summary" role="status">
        @if (SummaryTemplate is not null) { @SummaryTemplate(SelectedCount) }
        else { @($"{SelectedCount} {SelectedLabel}") }
    </span>
    <fieldset class="app-grid-selection-toolbar__actions" disabled="@(Busy || SelectedCount == 0)"
              aria-label="@AriaLabel">
        @Actions
    </fieldset>
    <AppButton Variant="AppButtonVariant.Subtle" Size="AppButtonSize.Compact"
               IconOnly="true" AriaLabel="@ClearLabel" Disabled="@(Busy || SelectedCount == 0)"
               OnClick="ClearAsync"><span aria-hidden="true">×</span></AppButton>
</div>

@code {
    [Parameter] public int SelectedCount { get; set; }
    [Parameter, EditorRequired] public RenderFragment Actions { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnClear { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Actions for selected rows";
    [Parameter] public string SelectedLabel { get; set; } = "selected";
    [Parameter] public string ClearLabel { get; set; } = "Clear selection";
    [Parameter] public RenderFragment<int>? SummaryTemplate { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (SelectedCount < 0)
            throw new ArgumentOutOfRangeException(nameof(SelectedCount), "Selected count must not be negative.");
    }

    private Task ClearAsync() => Busy || SelectedCount == 0 ? Task.CompletedTask : OnClear.InvokeAsync();
}
