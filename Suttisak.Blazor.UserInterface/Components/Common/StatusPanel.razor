<section @attributes="AdditionalAttributes"
         class="@CssClassValue"
         role="@Role"
         aria-live="@AriaLive">
    @if (Loading)
    {
        <FluentSpinner />
    }
    else if (Icon is not null)
    {
        <span class="status-panel__icon" aria-hidden="true"><FluentIcon Value="@Icon" /></span>
    }
    <h2>@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @if (Actions is not null)
    {
        <div class="status-panel__actions">@Actions</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Role { get; set; } = "status";
    [Parameter] public string AriaLive { get; set; } = "polite";
    [Parameter] public string? Variant { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClassValue => string.Join(" ", new[]
    {
        "status-panel",
        string.IsNullOrWhiteSpace(Variant) ? null : $"status-panel--{Variant}",
        CssClass
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
