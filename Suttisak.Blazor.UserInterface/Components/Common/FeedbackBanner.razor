<section @attributes="AdditionalAttributes"
         class="@CssClassValue"
         role="@Role"
         aria-live="@AriaLive">
    @if (Icon is not null)
    {
        <span class="feedback-banner__icon" aria-hidden="true"><FluentIcon Value="@Icon" /></span>
    }
    <div class="feedback-banner__copy">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <strong>@Title</strong>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @if (ChildContent is not null)
        {
            <div class="feedback-banner__content">@ChildContent</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="feedback-banner__actions">@Actions</div>
    }
    @if (Dismissible)
    {
        <AppButton Variant="AppButtonVariant.Subtle"
                      IconOnly="true"
                      IconStart="@(new Icons.Regular.Size20.Dismiss())"
                      OnClick="@(_ => OnDismiss.InvokeAsync())"
                      aria-label="@DismissLabel" />
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public FeedbackIntent Intent { get; set; } = FeedbackIntent.Info;
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissLabel { get; set; } = "Dismiss message";
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string Role => Intent == FeedbackIntent.Error ? "alert" : "status";
    private string AriaLive => Intent == FeedbackIntent.Error ? "assertive" : "polite";
    private string CssClassValue => $"feedback-banner feedback-banner--{Intent.ToString().ToLowerInvariant()} {CssClass}".Trim();
}
