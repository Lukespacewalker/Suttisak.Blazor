<section @attributes="AdditionalAttributes"
         class="@CssClassValue"
         style="@Style"
         tabindex="@TabIndex"
         aria-label="@AriaLabel">
    @if (Search is not null || Filters is not null || Actions is not null)
    {
        <div class="app-grid-shell__commandbar">
            @if (Search is not null) { <div class="app-grid-shell__search">@Search</div> }
            @if (Filters is not null) { <div class="app-grid-shell__filters">@Filters</div> }
            @if (Actions is not null) { <div class="app-grid-shell__actions">@Actions</div> }
        </div>
    }
    @if (SelectionActive && SelectionToolbar is not null)
    {
        <div class="app-grid-shell__toolbar app-grid-shell__toolbar--selection">@SelectionToolbar</div>
    }
    else if (Toolbar is not null)
    {
        <div class="app-grid-shell__toolbar">@Toolbar</div>
    }
    <AsyncContent State="@State"
                  LoadingTitle="@LoadingTitle"
                  EmptyTitle="@EmptyTitle"
                  EmptyMessage="@EmptyMessage">
        <div class="app-grid-shell__viewport">@ChildContent</div>
    </AsyncContent>
    @if (Footer is not null || Pagination is not null)
    {
        <div class="app-grid-shell__footer">@Footer @Pagination</div>
    }
</section>

@code {
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? SelectionToolbar { get; set; }
    [Parameter] public bool SelectionActive { get; set; }
    [Parameter] public RenderFragment? Search { get; set; }
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? Pagination { get; set; }
    [Parameter] public AsyncContentState State { get; set; } = AsyncContentState.Ready;
    [Parameter] public string LoadingTitle { get; set; } = "Loading records";
    [Parameter] public string EmptyTitle { get; set; } = "No records";
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public int TabIndex { get; set; } = -1;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClassValue => string.Join(' ', new[] { "app-grid-shell", CssClass }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
}
