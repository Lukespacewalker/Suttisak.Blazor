@typeparam TGridItem
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="app-grid" style="@Style" tabindex="0">
    <CascadingValue Value="this" IsFixed="true">
        <QuickGrid @ref="_grid"
                   TGridItem="TGridItem"
                   Items="@Items"
                   ItemsProvider="@EffectiveItemsProvider"
                   Pagination="@Pagination"
                   Virtualize="@Virtualize"
                   ItemSize="@ItemSize"
                   OverscanCount="@OverscanCount"
                   ItemKey="@ItemKey"
                   RowClass="@RowClassValue"
                   Theme="suttisak"
                   Class="@GridClassValue"
                   aria-label="@AriaLabel"
                   @attributes="AdditionalAttributes">
            @if (SelectionMode != AppGridSelectionMode.None)
            {
                <TemplateColumn TGridItem="TGridItem" Context="item" Class="app-grid__selection-column">
                    <HeaderTemplate>
                        <input class="app-grid__checkbox" type="checkbox"
                               aria-label="@SelectAllLabel"
                               checked="@AreVisibleRowsSelected"
                               disabled="@(!CanSelectMultiple || !HasSelectableRows)"
                               @onchange="SetVisibleRowsSelectedAsync" />
                    </HeaderTemplate>
                    <ChildContent>
                        <input class="app-grid__checkbox" type="checkbox"
                               aria-label="@SelectRowLabel(item)"
                               checked="@IsItemSelected(item)"
                               @onclick:stopPropagation="true"
                               @onchange="() => ToggleSelectionAsync(item)" />
                    </ChildContent>
                </TemplateColumn>
            }
            @ChildContent
        </QuickGrid>
    </CascadingValue>

    @if (_loading)
    {
        <div class="app-grid__loading" role="status"><span>@LoadingText</span></div>
    }
    else if (IsKnownEmpty)
    {
        <div class="app-grid__empty">@EmptyContent</div>
    }
</div>

@code {
    private readonly HashSet<object> _selectedKeys = [];
    private readonly Dictionary<object, TGridItem> _selectedItemsByKey = [];
    private QuickGrid<TGridItem>? _grid;
    private GridItemsProvider<TGridItem>? _trackingItemsProvider;
    private IReadOnlyList<TGridItem> _lastProviderRows = [];
    private int? _lastProviderTotalItemCount;
    private int _activeLoads;
    private bool _loading;
    private bool _hasProviderResult;
    private bool _hasSelectedItemParameter;
    private bool _hasSelectedItemsParameter;

    [Parameter] public IQueryable<TGridItem>? Items { get; set; }
    [Parameter] public GridItemsProvider<TGridItem>? ItemsProvider { get; set; }
    [Parameter] public PaginationState? Pagination { get; set; }
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public float ItemSize { get; set; } = 44;
    [Parameter] public int OverscanCount { get; set; } = 3;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public Func<TGridItem, object> ItemKey { get; set; } = item => item!;
    [Parameter] public Func<TGridItem, string?>? RowClass { get; set; }
    [Parameter] public AppGridSelectionMode SelectionMode { get; set; }
    [Parameter] public TGridItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TGridItem?> SelectedItemChanged { get; set; }
    [Parameter] public IReadOnlySet<TGridItem>? SelectedItems { get; set; }
    [Parameter] public EventCallback<IReadOnlySet<TGridItem>> SelectedItemsChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Data grid";
    [Parameter] public string LoadingText { get; set; } = "Loading rows";
    [Parameter] public string SelectAllLabel { get; set; } = "Select all visible rows";
    [Parameter] public string? EmptyText { get; set; } = "No rows to display.";
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private GridItemsProvider<TGridItem>? EffectiveItemsProvider
        => ItemsProvider is null ? null : _trackingItemsProvider ??= TrackItemsAsync;

    private RenderFragment EmptyContent => EmptyTemplate ?? (builder => builder.AddContent(0, EmptyText));
    private string GridClassValue => string.Join(' ', new[] { "app-grid__table", Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
    private bool IsKnownEmpty => ItemsProvider is not null
        ? _hasProviderResult && _lastProviderTotalItemCount == 0
        : Items is EnumerableQuery<TGridItem> && !Items.Any();

    internal bool CanSelectMultiple => SelectionMode == AppGridSelectionMode.Multiple;
    internal bool HasSelectableRows => SelectionMode != AppGridSelectionMode.None && VisibleRows().Any();
    internal bool AreVisibleRowsSelected
    {
        get
        {
            var rows = VisibleRows().ToArray();
            return rows.Length > 0 && rows.All(IsItemSelected);
        }
    }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _hasSelectedItemParameter = parameters.TryGetValue<TGridItem?>(nameof(SelectedItem), out _);
        _hasSelectedItemsParameter = parameters.TryGetValue<IReadOnlySet<TGridItem>?>(nameof(SelectedItems), out _);
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        if ((Items is null) == (ItemsProvider is null))
        {
            throw new InvalidOperationException(
                $"{nameof(AppGrid<TGridItem>)} requires either {nameof(Items)} or {nameof(ItemsProvider)}, but not both.");
        }

        if (Virtualize && (!float.IsFinite(ItemSize) || ItemSize <= 0))
        {
            throw new InvalidOperationException(
                $"{nameof(ItemSize)} must be a finite value greater than zero when virtualization is enabled.");
        }

        if (OverscanCount < 0)
            throw new InvalidOperationException($"{nameof(OverscanCount)} must not be negative.");

        SyncExternalSelection();
    }

    /// <summary>Re-fetches the current QuickGrid window or page.</summary>
    public Task RefreshDataAsync() => _grid?.RefreshDataAsync() ?? Task.CompletedTask;

    /// <summary>Alias for <see cref="RefreshDataAsync"/>.</summary>
    public Task RefreshAsync() => RefreshDataAsync();

    private async ValueTask<GridItemsProviderResult<TGridItem>> TrackItemsAsync(
        GridItemsProviderRequest<TGridItem> request)
    {
        var provider = ItemsProvider
            ?? throw new InvalidOperationException($"{nameof(ItemsProvider)} is no longer available.");

        _activeLoads++;
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await provider(request);
            request.CancellationToken.ThrowIfCancellationRequested();
            _lastProviderRows = result.Items.ToArray();
            _lastProviderTotalItemCount = result.TotalItemCount;
            _hasProviderResult = true;
            return result;
        }
        finally
        {
            _activeLoads = Math.Max(0, _activeLoads - 1);
            _loading = _activeLoads > 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    internal object GetItemKey(TGridItem item)
        => ItemKey(item) ?? throw new InvalidOperationException($"{nameof(ItemKey)} must not return null.");

    internal bool IsItemSelected(TGridItem item) => _selectedKeys.Contains(GetItemKey(item));

    internal string SelectRowLabel(TGridItem item) => $"Select row {GetItemKey(item)}";

    internal async Task ToggleSelectionAsync(TGridItem item)
    {
        if (SelectionMode == AppGridSelectionMode.None)
            return;

        var key = GetItemKey(item);
        if (SelectionMode == AppGridSelectionMode.Single)
        {
            var wasSelected = _selectedKeys.Contains(key);
            _selectedKeys.Clear();
            _selectedItemsByKey.Clear();
            if (!wasSelected)
            {
                _selectedKeys.Add(key);
                _selectedItemsByKey[key] = item;
            }
        }
        else if (_selectedKeys.Add(key))
        {
            _selectedItemsByKey[key] = item;
        }
        else
        {
            _selectedKeys.Remove(key);
            _selectedItemsByKey.Remove(key);
        }

        await NotifySelectionChangedAsync();
    }

    internal async Task SetVisibleRowsSelectedAsync()
    {
        if (SelectionMode != AppGridSelectionMode.Multiple)
            return;

        var rows = VisibleRows().ToArray();
        if (rows.Length > 0 && rows.All(IsItemSelected))
        {
            foreach (var item in rows)
            {
                var key = GetItemKey(item);
                _selectedKeys.Remove(key);
                _selectedItemsByKey.Remove(key);
            }
        }
        else
        {
            foreach (var item in rows)
            {
                var key = GetItemKey(item);
                _selectedKeys.Add(key);
                _selectedItemsByKey[key] = item;
            }
        }

        await NotifySelectionChangedAsync();
    }

    private IEnumerable<TGridItem> VisibleRows()
    {
        if (ItemsProvider is not null)
            return _lastProviderRows;

        if (Items is null)
            return [];

        return Pagination is null
            ? Items.AsEnumerable()
            : Items.Skip(Pagination.CurrentPageIndex * Pagination.ItemsPerPage)
                .Take(Pagination.ItemsPerPage)
                .AsEnumerable();
    }

    private async Task NotifySelectionChangedAsync()
    {
        var selected = _selectedItemsByKey.Values.ToHashSet();
        if (SelectionMode == AppGridSelectionMode.Single)
        {
            if (SelectedItemChanged.HasDelegate)
                await SelectedItemChanged.InvokeAsync(selected.FirstOrDefault());
            if (SelectedItemsChanged.HasDelegate)
                await SelectedItemsChanged.InvokeAsync(selected);
        }
        else if (SelectedItemsChanged.HasDelegate)
        {
            await SelectedItemsChanged.InvokeAsync(selected);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void SyncExternalSelection()
    {
        if (SelectionMode == AppGridSelectionMode.None)
        {
            _selectedKeys.Clear();
            _selectedItemsByKey.Clear();
            return;
        }

        if (SelectionMode == AppGridSelectionMode.Single && (_hasSelectedItemParameter || _hasSelectedItemsParameter))
        {
            _selectedKeys.Clear();
            _selectedItemsByKey.Clear();
            var hasItem = false;
            var item = default(TGridItem)!;
            if (_hasSelectedItemParameter && SelectedItem is not null)
            {
                item = SelectedItem;
                hasItem = true;
            }
            else if (!_hasSelectedItemParameter && SelectedItems is { Count: > 0 })
            {
                item = SelectedItems.First();
                hasItem = true;
            }

            if (hasItem)
            {
                var key = GetItemKey(item);
                _selectedKeys.Add(key);
                _selectedItemsByKey[key] = item;
            }
        }
        else if (SelectionMode == AppGridSelectionMode.Multiple && _hasSelectedItemsParameter)
        {
            _selectedKeys.Clear();
            _selectedItemsByKey.Clear();
            if (SelectedItems is not null)
            {
                foreach (var item in SelectedItems)
                {
                    var key = GetItemKey(item);
                    _selectedKeys.Add(key);
                    _selectedItemsByKey[key] = item;
                }
            }
        }
    }

    private string? RowClassValue(TGridItem item)
        => string.Join(' ', new[] { RowClass?.Invoke(item), IsItemSelected(item) ? "is-selected" : null }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
}
