<header class="@CssClassValue" aria-labelledby="@HeadingIdValue" @attributes="AdditionalAttributes">
    @if (Breadcrumbs is not null)
    {
        <nav class="page-heading__breadcrumbs" aria-label="@BreadcrumbLabel">
            @Breadcrumbs
        </nav>
    }

    @if (!string.IsNullOrWhiteSpace(SectionTitle))
    {
        <div class="page-heading__section">
            @if (SectionIcon is not null)
            {
                <span class="page-heading__section-icon" aria-hidden="true">
                    <FluentIcon Value="@SectionIcon" />
                </span>
            }

            <div class="page-heading__section-copy">
                <span class="page-heading__section-title">@SectionTitle</span>
                @if (!string.IsNullOrWhiteSpace(SectionDescription))
                {
                    <span class="page-heading__section-description">@SectionDescription</span>
                }
            </div>

            @if (SectionActions is not null)
            {
                <div class="page-heading__section-actions" role="toolbar" aria-label="@SectionActionsLabel">
                    @SectionActions
                </div>
            }
        </div>
    }

    <div class="page-heading__body">
        @if (Icon is not null)
        {
            <span class="page-heading__icon" aria-hidden="true">
                <FluentIcon Value="@Icon" />
            </span>
        }

        <div class="page-heading__copy">
            <h1 id="@HeadingIdValue">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>

        @if (PageActions is not null)
        {
            <div class="page-heading__page-actions" role="toolbar" aria-label="@PageActionsLabel">
                @PageActions
            </div>
        }
    </div>

    @if (Navigation is not null)
    {
        <div class="page-heading__navigation">
            @Navigation
        </div>
    }
</header>

@code {
    private readonly string _generatedHeadingId = $"page-heading-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public string? SectionTitle { get; set; }
    [Parameter] public string? SectionDescription { get; set; }
    [Parameter] public Icon? SectionIcon { get; set; }
    [Parameter] public RenderFragment? Breadcrumbs { get; set; }
    [Parameter] public RenderFragment? SectionActions { get; set; }
    [Parameter] public RenderFragment? PageActions { get; set; }
    [Parameter] public RenderFragment? Navigation { get; set; }
    [Parameter] public string? HeadingId { get; set; }
    [Parameter] public string BreadcrumbLabel { get; set; } = "Breadcrumb";
    [Parameter] public string SectionActionsLabel { get; set; } = "Section actions";
    [Parameter] public string PageActionsLabel { get; set; } = "Page actions";
    [Parameter] public string? CssClass { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HeadingIdValue => HeadingId ?? _generatedHeadingId;
    private string CssClassValue => string.IsNullOrWhiteSpace(CssClass)
        ? "page-heading"
        : $"page-heading {CssClass}";
}
