@inherits AppInputBase<bool>

<div class="@ContainerClass">
    <label class="app-choice app-choice--checkbox" for="@InputId">
        <input id="@InputId" class="app-choice__native @CssClass" type="checkbox" name="@NameAttributeValue"
               value="true" checked="@CurrentValue" required="@Required" disabled="@Disabled"
               aria-invalid="@HasValidationError" aria-describedby="@DescribedBy"
               @onchange="HandleChange" @attributes="AdditionalAttributes" />
        <span class="app-choice__control" aria-hidden="true"><svg viewBox="0 0 18 18"><path d="m4 9 3 3 7-7" /></svg></span>
        <span class="app-choice__content"><strong>@Label</strong>@if (!string.IsNullOrWhiteSpace(Description)) { <small id="@DescriptionId">@Description</small> }</span>
    </label>
    <AppInputSupport ValidationMessage="@ValidationMessage" ValidationId="@ValidationId" ShowValidationMessage="@ShowValidationMessage" />
</div>

@code {
    private void HandleChange(ChangeEventArgs args) => CurrentValue = args.Value is bool value && value;
    protected override bool TryParseValueFromString(string? value, out bool result, out string validationErrorMessage) { result = bool.TryParse(value, out var parsed) && parsed; validationErrorMessage = null!; return true; }
}
