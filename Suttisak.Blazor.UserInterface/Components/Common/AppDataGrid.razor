<DataGridContainer CssClass="@CssClass" Style="@Style" AriaLabel="@AriaLabel">
    @if (Search is not null || Filters is not null || Actions is not null)
    {
        <div class="app-data-grid__commandbar">
            @if (Search is not null) { <div class="app-data-grid__search">@Search</div> }
            @if (Filters is not null) { <div class="app-data-grid__filters">@Filters</div> }
            @if (Actions is not null) { <div class="app-data-grid__actions">@Actions</div> }
        </div>
    }
    @if (Toolbar is not null)
    {
        <div class="app-data-grid__toolbar">@Toolbar</div>
    }
    <AsyncContent State="@State"
                  LoadingTitle="@LoadingTitle"
                  EmptyTitle="@EmptyTitle"
                  EmptyMessage="@EmptyMessage">
        <div class="app-data-grid__viewport">@ChildContent</div>
    </AsyncContent>
    @if (Footer is not null || Pagination is not null)
    {
        <div class="app-data-grid__footer">@Footer @Pagination</div>
    }
</DataGridContainer>

@code {
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? Search { get; set; }
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? Pagination { get; set; }
    [Parameter] public AsyncContentState State { get; set; } = AsyncContentState.Ready;
    [Parameter] public string LoadingTitle { get; set; } = "Loading records";
    [Parameter] public string EmptyTitle { get; set; } = "No records";
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
}
