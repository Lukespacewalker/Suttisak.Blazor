@using Microsoft.AspNetCore.Components.QuickGrid
@implements IDisposable

<nav class="app-grid-paginator" style="@Style" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    <span class="app-grid-paginator__summary" aria-live="polite" aria-atomic="true">
        @if (SummaryTemplate is not null)
        {
            @SummaryTemplate
        }
        else
        {
            @Summary
        }
    </span>
    <div class="app-grid-paginator__controls">
    @if (ShowPageSizeSelector)
    {
        <select class="app-grid-paginator__page-size" aria-label="@PageSizeLabel" value="@State.ItemsPerPage" @onchange="SetPageSizeAsync">
            @foreach (var size in AvailablePageSizes)
            {
                <option value="@size">@size @PerPageLabel</option>
            }
        </select>
    }
    <div class="app-grid-paginator__pages">
    <button type="button" aria-label="@PreviousLabel" title="@PreviousLabel" disabled="@(!HasRows || State.CurrentPageIndex == 0)" @onclick="PreviousAsync">
        <Suttisak.Blazor.Icons.Icon Name="ChevronLeft" Size="20" aria-hidden="true" />
    </button>
    @if (ShowPageNumbers && HasRows)
    {
        @foreach (var page in VisiblePages)
        {
            @if (page is int number)
            {
                <button @key="number" type="button" class="app-grid-paginator__number"
                        aria-label="@($"{PageLabel} {number}")"
                        aria-current="@(number == State.CurrentPageIndex + 1 ? "page" : null)"
                        data-compact-hidden="@(Math.Abs(number - (State.CurrentPageIndex + 1)) > 1 ? "true" : null)"
                        @onclick="@(() => SetCurrentPageIndexAsync(number - 1))">@number</button>
            }
            else
            {
                <span class="app-grid-paginator__ellipsis" aria-hidden="true">…</span>
            }
        }
    }
    @if (ShowPageInput)
    {
    <label class="app-grid-paginator__page-label">
        <span>@PageLabel</span>
        <input type="number" min="1" max="@MaximumPage" style="@NumberFieldStyle"
               disabled="@(!HasRows)" value="@(State.CurrentPageIndex + 1)" @onchange="SetPageAsync" />
        <span>@OfLabel <strong>@MaximumPage</strong></span>
    </label>
    }
    <button type="button" aria-label="@NextLabel" title="@NextLabel" disabled="@(!HasRows || State.CurrentPageIndex >= State.LastPageIndex)" @onclick="NextAsync">
        <Suttisak.Blazor.Icons.Icon Name="ChevronRight" Size="20" aria-hidden="true" />
    </button>
    </div>
    </div>
</nav>

@code {
    [Parameter, EditorRequired] public PaginationState State { get; set; } = default!;
    [Parameter] public RenderFragment? SummaryTemplate { get; set; }
    [Parameter] public EventCallback<int> CurrentPageIndexChanged { get; set; }
    [Parameter] public EventCallback<int> ItemsPerPageChanged { get; set; }
    [Parameter] public bool ShowPageNumbers { get; set; } = true;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public bool ShowPageInput { get; set; }
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = new[] { 10, 25, 50, 100 };
    [Parameter] public string ShowingLabel { get; set; } = "Showing";
    [Parameter] public string PageSizeLabel { get; set; } = "Rows per page";
    [Parameter] public string PerPageLabel { get; set; } = "per page";
    [Parameter] public string NumberFieldStyle { get; set; } = "width: 4.5rem";
    [Parameter] public string AriaLabel { get; set; } = "Grid pagination";
    [Parameter] public string PreviousLabel { get; set; } = "Previous";
    [Parameter] public string NextLabel { get; set; } = "Next";
    [Parameter] public string PageLabel { get; set; } = "Page";
    [Parameter] public string OfLabel { get; set; } = "of";
    [Parameter] public string RowsLabel { get; set; } = "rows";
    [Parameter] public string RowLabel { get; set; } = "row";
    [Parameter] public string LoadingLabel { get; set; } = "Rows are loading";
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private PaginationState? _subscribedState;
    private bool HasRows => State.TotalItemCount > 0;
    private int MaximumPage => Math.Max(1, (State.LastPageIndex ?? 0) + 1);
    private IEnumerable<int> AvailablePageSizes => PageSizeOptions.Append(State.ItemsPerPage).Where(size => size > 0).Distinct().Order();
    private string Summary => State.TotalItemCount is null
        ? LoadingLabel
        : $"{ShowingLabel} {(HasRows ? (long)State.CurrentPageIndex * State.ItemsPerPage + 1 : 0):N0}–{Math.Min(((long)State.CurrentPageIndex + 1) * State.ItemsPerPage, State.TotalItemCount.Value):N0} {OfLabel} {State.TotalItemCount:N0} {(State.TotalItemCount == 1 ? RowLabel : RowsLabel)}";

    private IEnumerable<int?> VisiblePages
    {
        get
        {
            var current = State.CurrentPageIndex + 1;
            var start = Math.Max(1, Math.Min(current - 2, MaximumPage - 4));
            var end = Math.Min(MaximumPage, Math.Max(current + 2, 5));
            if (start > 1)
            {
                yield return 1;
                if (start == 3) yield return 2;
                else if (start > 3) yield return null;
            }
            for (var page = start; page <= end; page++) yield return page;
            if (end < MaximumPage)
            {
                if (end == MaximumPage - 2) yield return MaximumPage - 1;
                else if (end < MaximumPage - 2) yield return null;
                yield return MaximumPage;
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedState, State))
            return;

        if (_subscribedState is not null)
            _subscribedState.TotalItemCountChanged -= HandleTotalItemCountChanged;
        _subscribedState = State;
        _subscribedState.TotalItemCountChanged += HandleTotalItemCountChanged;
    }

    private Task PreviousAsync() => SetCurrentPageIndexAsync(State.CurrentPageIndex - 1);
    private Task NextAsync() => SetCurrentPageIndexAsync(State.CurrentPageIndex + 1);

    private async Task SetPageAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var page))
            await SetCurrentPageIndexAsync(page - 1);
    }

    private async Task SetPageSizeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size) || !AvailablePageSizes.Contains(size) || size == State.ItemsPerPage)
            return;

        State.ItemsPerPage = size;
        await State.SetCurrentPageIndexAsync(0);
        await ItemsPerPageChanged.InvokeAsync(size);
        await CurrentPageIndexChanged.InvokeAsync(State.CurrentPageIndex);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetCurrentPageIndexAsync(int index)
    {
        if (!HasRows) return;
        var normalized = Math.Clamp(index, 0, Math.Max(0, MaximumPage - 1));
        await State.SetCurrentPageIndexAsync(normalized);
        await CurrentPageIndexChanged.InvokeAsync(State.CurrentPageIndex);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleTotalItemCountChanged(object? sender, int? totalItemCount)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribedState is not null)
            _subscribedState.TotalItemCountChanged -= HandleTotalItemCountChanged;
    }
}
