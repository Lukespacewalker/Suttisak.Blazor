<div class="glass-card @CssClass @(IsActive ? "glass-card--active" : "") @(OnClick.HasDelegate ? "glass-card--clickable" : "")" style="@Style" @onclick="HandleClick">
    @if (Header != null || !string.IsNullOrWhiteSpace(Title))
    {
        <div class="glass-card__header">
            @if (Header != null)
            {
                @Header
            }
            else
            {
                <div class="glass-card__title">@Title</div>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <div class="glass-card__subtitle">@Subtitle</div>
                }
            }
        </div>
    }
    
    @if (ChildContent != null)
    {
        <div class="glass-card__body">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? Style { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
