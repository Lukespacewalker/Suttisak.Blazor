@typeparam TInput
@typeparam TResult
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.JSInterop

<dialog @ref="_dialog"
        class="@CssClassValue"
        aria-labelledby="@_titleId"
        aria-describedby="@DescriptionId"
        data-dismissible="@Dismissible.ToString().ToLowerInvariant()"
        @onclose="HandleNativeClose">
    @if (_hasValue)
    {
    <div class="app-dialog__surface">
        <header class="app-dialog__header">
            <div class="app-dialog__heading">
                @if (Dangerous)
                {
                    <span class="app-dialog__danger-mark" aria-hidden="true">!</span>
                }
                <div>
                    <h2 id="@_titleId">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <p id="@_descriptionId">@Description</p>
                    }
                </div>
            </div>
            @if (Dismissible)
            {
                <button class="app-dialog__close" type="button" aria-label="@CloseLabel" @onclick="CancelAsync">
                    <span aria-hidden="true">×</span>
                </button>
            }
        </header>
        <div class="app-dialog__body">@Body(Context)</div>
        @if (Footer is not null)
        {
            <footer class="app-dialog__footer">@Footer(Context)</footer>
        }
    </div>
    }
</dialog>

@code {
    private readonly string _titleId = $"app-dialog-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"app-dialog-description-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private TaskCompletionSource<AppOverlayResult<TResult>>? _completion;
    private IJSObjectReference? _module;
    private TInput _value = default!;
    private bool _hasValue;
    private bool _showAfterRender;

    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public RenderFragment<AppOverlayContext<TInput, TResult>> Body { get; set; } = default!;
    [Parameter] public RenderFragment<AppOverlayContext<TInput, TResult>>? Footer { get; set; }
    [Parameter] public bool Dangerous { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public string CloseLabel { get; set; } = "Close dialog";
    [Parameter] public string? Class { get; set; }

    private string? DescriptionId => string.IsNullOrWhiteSpace(Description) ? null : _descriptionId;
    private AppOverlayContext<TInput, TResult> Context => new(_value, CloseAsync, CancelAsync);
    private string CssClassValue => string.Join(' ', new[] { "app-dialog", Dangerous ? "app-dialog--danger" : null, Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    public Task<AppOverlayResult<TResult>> ShowAsync(TInput value)
    {
        if (_completion is { Task.IsCompleted: false })
        {
            throw new InvalidOperationException("The dialog is already open.");
        }

        _value = value;
        _hasValue = true;
        _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        _showAfterRender = true;
        _ = InvokeAsync(StateHasChanged);
        return _completion.Task;
    }

    public async Task CloseAsync(TResult result)
    {
        _completion?.TrySetResult(AppOverlayResult<TResult>.FromValue(result));
        await CloseElementAsync();
    }

    public async Task CancelAsync()
    {
        _completion?.TrySetResult(AppOverlayResult<TResult>.Cancelled());
        await CloseElementAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showAfterRender) return;
        _showAfterRender = false;
        try
        {
            await EnsureModuleAsync();
            await _module!.InvokeVoidAsync("showModal", _dialog);
        }
        catch (Exception exception)
        {
            _hasValue = false;
            _completion?.TrySetException(exception);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleNativeClose()
    {
        _completion?.TrySetResult(AppOverlayResult<TResult>.Cancelled());
        _hasValue = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CloseElementAsync()
    {
        await EnsureModuleAsync();
        await _module!.InvokeVoidAsync("close", _dialog);
    }

    private async Task EnsureModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Suttisak.Blazor.UserInterface/js/app-overlay.js");

    public async ValueTask DisposeAsync()
    {
        _completion?.TrySetResult(AppOverlayResult<TResult>.Cancelled());
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
