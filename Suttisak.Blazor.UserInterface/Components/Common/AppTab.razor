@implements IDisposable

<section id="@PanelId" role="tabpanel" aria-labelledby="@TabId" hidden="@(!IsActive)" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</section>

@code {
    [CascadingParameter] private AppTabs? Tabs { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _id = $"app-tab-{Guid.NewGuid():N}";
    private string TabId => $"{_id}-tab";
    private string PanelId => $"{_id}-panel";
    private string RegistrationId => Id ?? _id;
    private string? _registeredId;
    private bool IsActive => Tabs?.IsActive(RegistrationId) == true;

    protected override void OnParametersSet()
    {
        if (Tabs is null) throw new InvalidOperationException($"{nameof(AppTab)} must be inside {nameof(AppTabs)}.");
        if (_registeredId is not null && _registeredId != RegistrationId)
            Tabs.Unregister(_registeredId);
        Tabs.Register(new(RegistrationId, Label, TabId, PanelId));
        _registeredId = RegistrationId;
    }

    public void Dispose() => Tabs?.Unregister(_registeredId ?? RegistrationId);
}
