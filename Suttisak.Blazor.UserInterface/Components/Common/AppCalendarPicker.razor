@using System.Globalization

<div class="app-form-control @Class"
     data-app-calendar="@(Mode == AppCalendarPickerMode.Popup ? "popup" : "native")"
     data-calendar-first-day="@((int)FirstDayOfWeek)"
     data-picker-locale="@Text.Locale"
     data-picker-calendar-dialog-label="@Text.CalendarDialogLabel"
     data-picker-previous-month-label="@Text.PreviousMonthLabel"
     data-picker-next-month-label="@Text.NextMonthLabel"
     data-picker-month-label="@Text.MonthLabel"
     data-picker-year-label="@Text.YearLabel"
     @attributes="ContainerAttributes">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="app-form-control__label" for="@InputId">@Label</label>
    }
    <div class="app-form-control__input-wrap app-form-control__input-wrap--has-icon">
        <svg class="app-form-control__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 2v3M17 2v3M3.5 9h17M5.5 4.5h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2Z" />
        </svg>
        <input id="@InputId"
               class="app-form-control__input"
               type="date"
               name="@Name"
               value="@FormattedValue"
               min="@FormattedMin"
               max="@FormattedMax"
               required="@Required"
               disabled="@Disabled"
               aria-describedby="@DescriptionId"
               @onchange="HandleChangeAsync"
               @attributes="InputAttributes" />
        @if (Mode == AppCalendarPickerMode.Popup)
        {
            <button class="app-form-control__calendar-trigger" type="button" data-calendar-trigger aria-label="@EffectiveOpenCalendarLabel" aria-haspopup="dialog" aria-expanded="false" disabled="@Disabled">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2v3M17 2v3M3.5 9h17M5.5 4.5h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2Z" /></svg>
            </button>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <small id="@DescriptionId" class="app-form-control__description">@Description</small>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    /// <summary>DateTime-compatible binding for applications whose model uses DateTime?.</summary>
    [Parameter] public DateTime? DateTimeValue { get; set; }
    [Parameter] public EventCallback<DateTime?> DateTimeValueChanged { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public DateOnly? Min { get; set; }
    [Parameter] public DateOnly? Max { get; set; }
    [Parameter] public DateTime? DateTimeMin { get; set; }
    [Parameter] public DateTime? DateTimeMax { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public AppCalendarPickerMode Mode { get; set; } = AppCalendarPickerMode.Popup;
    [Parameter] public DayOfWeek FirstDayOfWeek { get; set; } = DayOfWeek.Monday;
    /// <summary>Localized text for the popup. Defaults preserve the English UI.</summary>
    [Parameter] public AppPickerText Text { get; set; } = new();
    /// <summary>Overrides <see cref="AppPickerText.OpenCalendarLabel"/> for this trigger.</summary>
    [Parameter] public string? OpenCalendarLabel { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? ContainerAttributes { get; set; }

    private readonly string _generatedId = $"app-date-{Guid.NewGuid():N}";
    private string InputId => Id ?? _generatedId;
    private string? DescriptionId => string.IsNullOrWhiteSpace(Description) ? null : $"{InputId}-description";
    private string EffectiveOpenCalendarLabel => OpenCalendarLabel ?? Text.OpenCalendarLabel;
    private bool UsesDateTimeValue => DateTimeValueChanged.HasDelegate;
    private string? FormattedValue => UsesDateTimeValue ? Format(DateTimeValue) : Format(Value);
    private string? FormattedMin => UsesDateTimeValue ? Format(DateTimeMin) : Format(Min);
    private string? FormattedMax => UsesDateTimeValue ? Format(DateTimeMax) : Format(Max);

    private static string? Format(DateOnly? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private static string? Format(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private Task HandleChangeAsync(ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        var value = DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed
            : (DateOnly?)null;
        var existingTime = DateTimeValue is { } current
            ? TimeOnly.FromTimeSpan(current.TimeOfDay)
            : TimeOnly.MinValue;
        var kind = DateTimeValue?.Kind ?? DateTimeKind.Unspecified;
        return UsesDateTimeValue
            ? DateTimeValueChanged.InvokeAsync(value is null ? null : value.Value.ToDateTime(existingTime, kind))
            : ValueChanged.InvokeAsync(value);
    }
}
