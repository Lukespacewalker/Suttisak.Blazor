@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

<div style="@Style"
     class="nav-category @(Expanded ? "nav-category--expanded" : string.Empty) @(IsActive ? "nav-category--active" : string.Empty) @(IsSelected ? "nav-category--selected" : string.Empty)">
    @if (HasHref)
    {
        <div class="nav-category__header-row">
            <a class="nav-category__header nav-category__header--link" href="@Href" @onclick="HandleNavigate">
                <span class="nav-category__icon">@IconMarkup</span>
                <span class="nav-category__label">@Title</span>
            </a>
            <button class="nav-category__toggle" type="button" @onclick="ToggleExpanded" aria-expanded="@Expanded"
                    aria-label="Toggle @Title submenu">
                <span class="nav-category__chevron @(Expanded ? "expanded" : "")">
                    <Suttisak.Blazor.Icons.Icon Name="ChevronRight" Size="20" />
                </span>
            </button>
        </div>
    }
    else
    {
        <button class="nav-category__header" type="button" @onclick="ToggleExpanded" aria-expanded="@Expanded">
            <span class="nav-category__icon">@IconMarkup</span>
            <span class="nav-category__label">@Title</span>
            <span class="nav-category__chevron @(Expanded ? "expanded" : "")">
                <Suttisak.Blazor.Icons.Icon Name="ChevronRight" Size="20" />
            </span>
        </button>
    }

    <div class="nav-category__panel">
        <div class="nav-category__content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public string Style { get; set; } = string.Empty;

    [CascadingParameter]
    public Nav? NavRoot { get; set; }

    [CascadingParameter]
    public NavComponentState? State { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter] public string? IconRestName { get; set; }
    [Parameter] public string? IconActiveName { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment? IconMarkup => string.IsNullOrWhiteSpace(DisplayIconName)
        ? null
        : builder =>
        {
            builder.OpenComponent<Suttisak.Blazor.Icons.Icon>(0);
            builder.AddAttribute(1, nameof(Suttisak.Blazor.Icons.Icon.Name), DisplayIconName);
            builder.AddAttribute(2, nameof(Suttisak.Blazor.Icons.Icon.Size), 20);
            builder.AddAttribute(3, nameof(Suttisak.Blazor.Icons.Icon.Variant), IsActive ? Suttisak.Blazor.Icons.IconVariant.Filled : Suttisak.Blazor.Icons.IconVariant.Regular);
            builder.CloseComponent();
        };

    private string? DisplayIconName => IsActive ? IconActiveName ?? IconRestName : IconRestName;

    private bool HasHref => !string.IsNullOrWhiteSpace(Href);

    private bool IsSelected => HasHref && IsCurrentUrlExactMatch();

    private bool IsActive => HasHref && IsCurrentUrlWithinCategory();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += HandleLocationChanged;
        State?.Changed += HandleStateChanged;
    }

    private bool IsCurrentUrlExactMatch()
    {
        var current = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).PathAndQuery.TrimEnd('/');
        var target = NavigationManager.ToAbsoluteUri(Href!).PathAndQuery.TrimEnd('/');

        return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCurrentUrlWithinCategory()
    {
        if (IsCurrentUrlExactMatch())
        {
            return true;
        }

        var current = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).PathAndQuery.TrimEnd('/');
        var target = NavigationManager.ToAbsoluteUri(Href!).PathAndQuery.TrimEnd('/');

        return current.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(target + "?", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleExpanded()
    {
        Expanded = !Expanded;
    }

    private void HandleNavigate()
    {
        NavRoot?.CloseMobileAfterNavigation();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        State?.Changed -= HandleStateChanged;
    }
}
