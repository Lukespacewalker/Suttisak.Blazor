<nav class="@CssClassValue"
     aria-label="@AriaLabel"
     data-adaptive-overflow="section-navigation"
     @attributes="AdditionalAttributes">
    @if (Context is not null)
    {
        <div class="section-navigation__context">@Context</div>
    }

    <div class="section-navigation__desktop">
        <div class="section-navigation__items">
            <div class="section-navigation__primary-items">@ChildContent</div>
            @if (Overflow is not null)
            {
                <div class="section-navigation__optional-items">@Overflow</div>
            }
        </div>

        @if (Overflow is not null)
        {
            <details class="section-navigation__overflow @(OverflowActive ? "is-active" : null)">
                <summary aria-label="@OverflowLabel" title="@OverflowLabel">
                    <span class="section-navigation__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span>@OverflowLabel</span>
                    <i class="section-navigation__chevron" aria-hidden="true"></i>
                </summary>
                <div class="section-navigation__overflow-panel">@Overflow</div>
            </details>
        }
    </div>

    <details class="section-navigation__mobile">
        <summary class="section-navigation__mobile-trigger">
            <span><small>@MobileLabel</small><strong>@CurrentSectionLabel</strong></span>
            <i class="section-navigation__chevron" aria-hidden="true"></i>
        </summary>
        <div class="section-navigation__mobile-panel">
            @ChildContent
            @Overflow
        </div>
    </details>

    @if (Actions is not null)
    {
        <div class="section-navigation__actions">@Actions</div>
    }
</nav>

@code {
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Context { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? Overflow { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string OverflowLabel { get; set; } = "More";
    [Parameter] public bool OverflowActive { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string MobileLabel { get; set; } = "Current section";
    [Parameter] public string CurrentSectionLabel { get; set; } = "Overview";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClassValue => string.Join(' ', new[]
    {
        "section-navigation",
        Embedded ? "section-navigation--embedded" : null,
        Context is null ? "section-navigation--without-context" : null,
        Actions is null ? "section-navigation--without-actions" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
