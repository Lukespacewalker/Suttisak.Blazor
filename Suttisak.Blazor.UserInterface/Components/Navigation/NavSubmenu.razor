<details class="@CssClassValue" open="@Expanded" @attributes="AdditionalAttributes">
    <summary class="nav-submenu__trigger">
        @if (!string.IsNullOrWhiteSpace(IconName))
        {
            <span class="nav-submenu__icon" aria-hidden="true"><Suttisak.Blazor.Icons.Icon Name="@IconName" Size="20" Variant="@(Active ? Suttisak.Blazor.Icons.IconVariant.Filled : Suttisak.Blazor.Icons.IconVariant.Regular)" /></span>
        }
        <span class="nav-submenu__label">@Label</span>
        @if (!string.IsNullOrWhiteSpace(Badge))
        {
            <span class="nav-submenu__badge">@Badge</span>
        }
        <span class="nav-submenu__chevron" aria-hidden="true"></span>
    </summary>
    <div class="nav-submenu__items">@ChildContent</div>
</details>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string? Badge { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClassValue => string.Join(' ', new[]
    {
        "nav-submenu",
        Active ? "is-active" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
