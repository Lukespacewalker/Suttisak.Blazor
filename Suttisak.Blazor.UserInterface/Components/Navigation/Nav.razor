@implements IDisposable

<CascadingValue Value="this">
    @if (Embedded)
    {
        <div class="nav-panel nav-panel--embedded">
            @if (AccountContent is not null)
            {
                <AuthorizeView>
                    <Authorized>
                        <div class="nav-panel__account">@AccountContent</div>
                    </Authorized>
                </AuthorizeView>
            }
            <div class="nav-panel__primary">@ChildContent</div>
        </div>
    }
    else
    {
    <div class="@($"app-nav {CollapsedClass} {MobileOpenClass}")">
        <div class="nav-shell">
            <div class="nav-toolbar">
                <button class="nav-toolbar-button nav-toolbar-button--collapse"
                        @onclick="ToggleCollapsed"
                        aria-label="Collapse navigation menu">
                    <Suttisak.Blazor.Icons.Icon Name="@CollapseIconName" Size="20" />
                </button>
                @if (BrandContent is not null)
                {
                    <div class="nav-brand">
                        @BrandContent
                    </div>
                }
            </div>

            <div class="nav-panel">
                <div class="nav-panel__mobile-account">
                    <MobileNavigationAccount />
                </div>
                @if (AccountContent is not null)
                {
                    <AuthorizeView>
                        <Authorized>
                            <div class="nav-panel__account">@AccountContent</div>
                        </Authorized>
                    </AuthorizeView>
                }
                <div class="nav-panel__primary">@ChildContent</div>
            </div>
        </div>

        <button type="button"
                class="nav-backdrop"
                @onclick="CloseMobileMenu"
                aria-label="Close navigation menu"
                tabindex="@(IsMobileOpen ? 0 : -1)"></button>
    </div>
    }
</CascadingValue>

@code {
    [CascadingParameter] public NavComponentState? State { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    [Parameter]
    public RenderFragment? AccountContent { get; set; }

    [Parameter]
    public bool Embedded { get; set; }

    public bool IsCollapsed => State?.IsCollapsed ?? false;

    public bool IsMobileOpen => State?.IsMobileOpen ?? false;

    private string CollapsedClass => IsCollapsed ? "app-nav--collapsed" : string.Empty;

    private string MobileOpenClass => IsMobileOpen ? "app-nav--mobile-open" : string.Empty;

    private string CollapseIconName => IsCollapsed ? "PanelLeftExpand" : "PanelLeftContract";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State?.Changed += HandleStateChanged;
    }

    public void CloseMobileAfterNavigation()
    {
        State?.CloseMobile();
    }

    private void ToggleCollapsed()
    {
        State?.ToggleCollapsed();
    }

    private void CloseMobileMenu()
    {
        State?.CloseMobile();
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State?.Changed -= HandleStateChanged;
    }
}
