@using Suttisak.Blazor.UserInterface.Layouts.Shared
@implements IDisposable

<CascadingValue Value="this">
    <FluentLayoutItem Area="LayoutArea.Navigation" Class="@($"app-nav {CollapsedClass} {MobileOpenClass}")">
        <div class="nav-shell glass">
            <div class="nav-toolbar">
                <FluentButton Class="nav-toolbar-button nav-toolbar-button--collapse"
                              IconStart="@(CollapseIcon)"
                              OnClick="ToggleCollapsed"
                              aria-label="Collapse navigation menu" />
                <div class="nav-brand">
                    @if (BrandContent is not null)
                    {
                        @BrandContent
                    }
                </div>
            </div>

            <div class="nav-panel">
                @ChildContent
            </div>
        </div>

        <button class="nav-backdrop" @onclick="CloseMobileMenu" aria-label="Close navigation menu"></button>
    </FluentLayoutItem>
</CascadingValue>

@code {
    [CascadingParameter] public NavComponentState? State { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    public bool IsCollapsed => State?.IsCollapsed ?? false;

    public bool IsMobileOpen => State?.IsMobileOpen ?? false;

    private string CollapsedClass => IsCollapsed ? "app-nav--collapsed" : string.Empty;

    private string MobileOpenClass => IsMobileOpen ? "app-nav--mobile-open" : string.Empty;

    private Icon CollapseIcon => IsCollapsed
        ? new Icons.Regular.Size20.PanelLeftExpand()
        : new Icons.Regular.Size20.PanelLeftContract();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State?.Changed += HandleStateChanged;
    }

    public void CloseMobileAfterNavigation()
    {
        State?.CloseMobile();
    }

    private void ToggleCollapsed()
    {
        State?.ToggleCollapsed();
    }

    private void CloseMobileMenu()
    {
        State?.CloseMobile();
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State?.Changed -= HandleStateChanged;
    }
}