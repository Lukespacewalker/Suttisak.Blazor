@using Microsoft.JSInterop
@using Suttisak.Blazor.UserInterface.Interfaces.Theme
@implements IAsyncDisposable
@inject IThemeService ThemeService
@inject IJSRuntime JsRuntime

<div class="theme-selector" role="group" aria-label="Color scheme">
    <button class="@(IsCurrentTheme(DesignThemeMode.Light) ? "active" : null)"
            type="button" aria-label="Use light theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.Light))"
            @onclick="@(() => SetThemeAsync(DesignThemeMode.Light))">
        <span aria-hidden="true">☼</span>
    </button>
    <button class="@(IsCurrentTheme(DesignThemeMode.Dark) ? "active" : null)"
            type="button" aria-label="Use dark theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.Dark))"
            @onclick="@(() => SetThemeAsync(DesignThemeMode.Dark))">
        <span aria-hidden="true">◐</span>
    </button>
    <button class="@(IsCurrentTheme(DesignThemeMode.System) ? "active" : null)"
            type="button" aria-label="Use system theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.System))"
            @onclick="@(() => SetThemeAsync(DesignThemeMode.System))">
        <span aria-hidden="true">A</span>
    </button>
</div>

@code {
    private readonly DotNetObjectReference<ThemeSelector> _reference;
    private IJSObjectReference? _module;
    private long? _subscriptionId;
    private DesignThemeMode _currentThemeMode = DesignThemeMode.System;

    public ThemeSelector()
    {
        _reference = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Suttisak.Blazor.UserInterface/Components/ThemeSelector.razor.js");
        var state = await _module.InvokeAsync<ThemeState>("subscribeTheme", _reference);
        _subscriptionId = state.SubscriptionId;
        ApplyThemeState(state.Preference, state.Scheme);
    }

    [JSInvokable]
    public Task UpdateTheme(string preference, string scheme)
    {
        ApplyThemeState(preference, scheme);
        return InvokeAsync(StateHasChanged);
    }

    private bool IsCurrentTheme(DesignThemeMode mode) => _currentThemeMode == mode;

    private static string Pressed(bool value) => value ? "true" : "false";

    private async Task SetThemeAsync(DesignThemeMode mode)
    {
        if (_module is null) return;
        var state = await _module.InvokeAsync<ThemeState>("setTheme", mode.ToString());
        ApplyThemeState(state.Preference, state.Scheme);
    }

    private void ApplyThemeState(string preference, string scheme)
    {
        _currentThemeMode = Enum.TryParse<DesignThemeMode>(preference, true, out var mode)
            ? mode
            : DesignThemeMode.System;
        var currentTheme = string.Equals(scheme, "dark", StringComparison.OrdinalIgnoreCase)
            ? ThemeMode.Dark
            : ThemeMode.Light;
        ThemeService.SetTheme(_currentThemeMode, currentTheme);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (_subscriptionId is not null)
                {
                    await _module.InvokeVoidAsync("unsubscribeTheme", _subscriptionId.Value);
                }

                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended before the browser module could be released.
            }
        }

        _reference.Dispose();
    }

    private sealed class ThemeState
    {
        public long SubscriptionId { get; set; }
        public string Preference { get; set; } = "system";
        public string Scheme { get; set; } = "light";
    }
}
