@using Microsoft.JSInterop
@using Suttisak.Blazor.UserInterface.Interfaces.Theme
@inject Suttisak.Blazor.UserInterface.Interfaces.Theme.IThemeService ThemeService
@inject IJSRuntime JsRuntime

<div class="theme-selector">
    <button class="@($"{(IsCurrentTheme(DesignThemeMode.Light) ? "active" : "")}")"
            type="button" aria-label="Use light theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.Light))"
            @onclick="@(() => SetThemeAsync(DesignThemeMode.Light))">
        <span aria-hidden="true">☼</span>
    </button>
    <button class="@($"{(IsCurrentTheme(DesignThemeMode.Dark) ? "active" : "")}")"
            type="button" aria-label="Use dark theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.Dark))"
            @onclick="@(() => SetThemeAsync(DesignThemeMode.Dark))">
        <span aria-hidden="true">◐</span>
    </button>
    <button class="@($"{(IsCurrentTheme(DesignThemeMode.System) ? "active" : "")}")"
        type="button" aria-label="Use system theme" aria-pressed="@Pressed(IsCurrentTheme(DesignThemeMode.System))"
        @onclick="@(() => SetThemeAsync(DesignThemeMode.System))">
        <span aria-hidden="true">A</span>
    </button>
</div>

@code {
    private IJSObjectReference? _module;

    private DesignThemeMode _currentThemeMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var mustUpdate = false;
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Suttisak.Blazor.UserInterface/Components/ThemeSelector.razor.js");
            await _module.InvokeVoidAsync("initializeColorScheme");
            var result = await _module.InvokeAsync<string>("getTheme");
            if (Enum.TryParse<DesignThemeMode>(result, true, out var themeMode))
            {
                if (_currentThemeMode != themeMode)
                {
                    _currentThemeMode = themeMode;
                    ThemeService.ThemeConfiguration = themeMode;
                    await _module.InvokeVoidAsync("setColorScheme", themeMode.ToString());
                    mustUpdate = true;
                }
            }

            if (mustUpdate)
            {
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentTheme(DesignThemeMode mode)
    {
        return _currentThemeMode == mode;
    }

    private static string Pressed(bool value) => value ? "true" : "false";

    private async Task SetThemeAsync(DesignThemeMode mode)
    {
        _currentThemeMode = mode;
        ThemeService.ThemeConfiguration = mode;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setColorScheme", mode.ToString());
        }
    }
}

