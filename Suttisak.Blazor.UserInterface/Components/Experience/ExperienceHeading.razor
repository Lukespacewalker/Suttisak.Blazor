<header @attributes="AdditionalAttributes"
        class="@CssClassValue"
        aria-labelledby="@HeadingIdValue">
    <div class="experience-heading__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="experience-heading__eyebrow">@Eyebrow</span>
        }
        <h1 id="@HeadingIdValue">
            @Title
            @if (!string.IsNullOrWhiteSpace(Emphasis))
            {
                <br />
                <em>@Emphasis</em>
            }
        </h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="experience-heading__lead">@Description</p>
        }
        @if (Details is not null)
        {
            <div class="experience-heading__details">@Details</div>
        }
    </div>

    <div class="experience-heading__visual" aria-hidden="@VisualIsDecorative.ToString().ToLowerInvariant()">
        <span class="experience-heading__orbit experience-heading__orbit--one"></span>
        <span class="experience-heading__orbit experience-heading__orbit--two"></span>
        @Visual
    </div>

    @if (!string.IsNullOrWhiteSpace(Watermark))
    {
        <span class="experience-heading__watermark" aria-hidden="true">@Watermark</span>
    }
</header>

@code {
    private readonly string _generatedHeadingId = $"experience-heading-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Emphasis { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Watermark { get; set; }
    [Parameter] public string? HeadingId { get; set; }
    [Parameter] public RenderFragment? Details { get; set; }
    [Parameter] public RenderFragment? Visual { get; set; }
    [Parameter] public bool VisualIsDecorative { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HeadingIdValue => HeadingId ?? _generatedHeadingId;
    private string CssClassValue => string.Join(' ', new[]
    {
        "experience-heading",
        !VisualIsDecorative && Visual is not null ? "experience-heading--visual-content" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
