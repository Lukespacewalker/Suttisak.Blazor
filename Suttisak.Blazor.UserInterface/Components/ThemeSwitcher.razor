<div class="theme-selector" role="group" aria-label="Color scheme" data-theme-selector>
    <button type="button" data-theme-preference="light" aria-label="Use light theme" aria-pressed="false">
        <span aria-hidden="true">☼</span>
    </button>
    <button type="button" data-theme-preference="dark" aria-label="Use dark theme" aria-pressed="false">
        <span aria-hidden="true">◐</span>
    </button>
    <button type="button" data-theme-preference="system" aria-label="Use system theme" aria-pressed="true" class="active">
        <span aria-hidden="true">A</span>
    </button>
</div>
