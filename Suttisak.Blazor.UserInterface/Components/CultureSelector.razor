@using System.Globalization
@using Microsoft.Extensions.Options
@inject NavigationManager Navigation
@inject IOptions<BlazorUIOptions> Options

<form class="culture-selector" aria-label="Language" method="get" action="@Options.Value.CultureSetUrl"
      data-enhance="false" data-culture-selector data-default-culture="@Options.Value.DefaultCulture"
      data-current-culture="@CultureInfo.CurrentUICulture.Name">
    <input type="hidden" name="redirectUri" value="@RedirectUri" />
    <button type="submit" name="culture" value="auto" data-culture-preference="auto"
            aria-label="Use device language" aria-pressed="false">Auto</button>
    <button class="@(IsCurrentCulture("en-US") ? "active" : null)" type="submit" name="culture" value="en-US"
            data-culture-preference="en" aria-label="Use English" aria-pressed="@Pressed(IsCurrentCulture("en-US"))">EN</button>
    <button class="@(IsCurrentCulture("th-TH") ? "active" : null)" type="submit" name="culture" value="th-TH"
            data-culture-preference="th" aria-label="ใช้ภาษาไทย" aria-pressed="@Pressed(IsCurrentCulture("th-TH"))">ไทย</button>
</form>

@code {
    private static string Pressed(bool value) => value ? "true" : "false";
    private static bool IsCurrentCulture(string cultureName) => cultureName == CultureInfo.CurrentUICulture.Name;
    private string RedirectUri => new Uri(Navigation.Uri).PathAndQuery + new Uri(Navigation.Uri).Fragment;
}
