<article class="marketing-card @(Featured ? "marketing-card--featured" : null) @(Compact ? "marketing-card--compact" : null) @Class"
         @attributes="AdditionalAttributes">
    @if (Visual is not null)
    {
        <div class="marketing-card__visual">@Visual</div>
    }
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h3>@Title</h3>
    }
    <div class="marketing-card__body">@ChildContent</div>
</article>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Visual { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Featured { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}

