<section class="marketing-hero @VariantClass @(Media is null ? "marketing-hero--without-media" : null) @Class"
         id="@Id"
         aria-labelledby="@TitleId"
         @attributes="AdditionalAttributes">
    <div class="marketing-hero__backdrop" aria-hidden="true">
        <div class="marketing-hero__orb marketing-hero__orb--start"></div>
        <div class="marketing-hero__orb marketing-hero__orb--end"></div>
        <div class="marketing-hero__grid"></div>
    </div>

    <div class="marketing-hero__container-scope">
        <MarketingContainer Class="marketing-hero__container">
            <div class="marketing-hero__copy">
                @Eyebrow
                <h1 id="@TitleId">@Title</h1>
                @if (DescriptionContent is not null)
                {
                    <div class="marketing-hero__description">@DescriptionContent</div>
                }
                else if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="marketing-hero__description">@Description</p>
                }
                @if (Actions is not null)
                {
                    <div class="marketing-hero__actions">@Actions</div>
                }
                @ChildContent
            </div>

            @if (Media is not null)
            {
                <div class="marketing-hero__media">@Media</div>
            }
        </MarketingContainer>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string TitleId { get; set; } = "marketing-hero-title";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? DescriptionContent { get; set; }
    [Parameter] public RenderFragment? Eyebrow { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Media { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public MarketingHeroVariant Variant { get; set; } = MarketingHeroVariant.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Variant == MarketingHeroVariant.Editorial
        ? "marketing-hero--editorial"
        : "marketing-hero--default";
}
