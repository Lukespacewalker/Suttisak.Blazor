{"schemaVersion":1,"name":"Suttisak.Blazor design tokens","cssEntryPoint":"_content/Suttisak.Blazor.UserInterface/css/main.css","description":"Machine-readable public design-token contract. Values mirror the first root declaration in the packaged CSS; consuming applications override semantic roles without changing component markup.","categories":[{"id":"identity","label":"Identity & accent","description":"Product identity and interactive emphasis. Applications override these semantic roles without changing component CSS.","tokens":[{"name":"--app-brand","label":"Brand","defaultValue":"light-dark(#0f6cbd, #62abf5)","kind":"color","description":"Primary product identity."},{"name":"--app-on-brand","label":"On brand","defaultValue":"light-dark(#ffffff, #07181d)","kind":"color","description":"Readable content placed on the brand color."},{"name":"--app-brand-secondary","label":"Secondary brand","defaultValue":"light-dark(#107c10, #54c754)","kind":"color","description":"Optional secondary identity role."},{"name":"--app-accent","label":"Accent","defaultValue":"var(--app-brand)","kind":"color","description":"Interactive emphasis and selection."},{"name":"--app-accent-soft","label":"Accent soft","defaultValue":"light-dark(rgb(15 108 189 / .12), rgb(98 171 245 / .18))","kind":"color","description":"Low-emphasis accent surface."},{"name":"--app-accent-border","label":"Accent border","defaultValue":"light-dark(#8bbce8, #326b9f)","kind":"color","description":"Accent-aware structural border."},{"name":"--app-brand-soft","label":"Brand soft","defaultValue":"light-dark(rgb(15 108 189 / .10), rgb(98 171 245 / .16))","kind":"color","description":"Subtle primary-brand wash."},{"name":"--app-brand-secondary-soft","label":"Secondary brand soft","defaultValue":"light-dark(rgb(16 124 16 / .11), rgb(84 199 84 / .17))","kind":"color","description":"Subtle secondary-brand wash."}]},{"id":"surfaces","label":"Surfaces","description":"Page, panel, hover, and translucent surface roles used by 