@using Suttisak.Blazor.Identity.Core.Components.Menu
@using Suttisak.Blazor.UserInterface.Components.Navigation
@namespace Suttisak.Blazor.Identity.Components.Menu

@if (ShowManageChildren)
{
	<NavCategory Style="@Style" IconRestName="PersonCircle" Href="@IdentityRoutes.Account.Manage.Root" Title="@IdentityNavMenuItems_razor.Account">
		<NavItem IconRestName="PersonAccounts" Href="@IdentityRoutes.Account.Manage.Profile" >@IdentityNavMenuItems_razor.Profile</NavItem>
		<NavItem IconRestName="Mail" Href="@IdentityRoutes.Account.Manage.Email">@IdentityNavMenuItems_razor.Email</NavItem>
		<NavItem IconRestName="Password" Href="@IdentityRoutes.Account.Manage.ChangePassword">@IdentityNavMenuItems_razor.Password</NavItem>
		<NavItem IconRestName="GlobeSurface" Href="@IdentityRoutes.Account.Manage.ExternalLogins">@IdentityNavMenuItems_razor.ExternalLogins</NavItem>
		<NavItem IconRestName="KeyMultiple" Href="@IdentityRoutes.Account.Manage.TwoFactorAuthentication">@IdentityNavMenuItems_razor._2FA</NavItem>
		<NavItem IconRestName="PersonPasskey" Href="@IdentityRoutes.Account.Manage.Passkeys">@IdentityNavMenuItems_razor.Passkeys</NavItem>
		<NavItem IconRestName="DatabasePerson" Href="@IdentityRoutes.Account.Manage.PersonalData">@IdentityNavMenuItems_razor.PersonalData</NavItem>
	</NavCategory>
}
else
{
	<NavItem Style="@Style"
	         IconRestName="PersonCircle"
	         IconActiveName="PersonCircle"
	         Href="@IdentityRoutes.Account.Manage.Root">@IdentityNavMenuItems_razor.Account</NavItem>
}

@code {
	[Parameter] public string Style { get; set; } = string.Empty;
	[Parameter] public bool ShowManageChildren { get; set; }
}
